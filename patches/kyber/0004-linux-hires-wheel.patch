+#[cfg(test)]
+mod tests {
+    use super::{WheelAxisAccumulator, WheelEmission};
+
+    #[test]
+    fn host_mouse_fractional_positive_and_negative_movement_is_immediate() {
+        let mut positive = WheelAxisAccumulator::default();
+        assert_eq!(
+            positive.accumulate(0.25),
+            WheelEmission {
+                hi_res: 30,
+                legacy: 0,
+            }
+        );
+
+        let mut negative = WheelAxisAccumulator::default();
+        assert_eq!(
+            negative.accumulate(-0.5),
+            WheelEmission {
+                hi_res: -60,
+                legacy: 0,
+            }
+        );
+    }
+
+    #[test]
+    fn host_mouse_direction_reversal_discards_stale_remainder() {
+        let mut accumulator = WheelAxisAccumulator::default();
+        assert_eq!(accumulator.accumulate(0.75).hi_res, 90);
+        assert_eq!(
+            accumulator.accumulate(-0.5),
+            WheelEmission {
+                hi_res: -60,
+                legacy: 0,
+            }
+        );
+        assert_eq!(
+            accumulator.accumulate(-0.5),
+            WheelEmission {
+                hi_res: -60,
+                legacy: -1,
+            }
+        );
+    }
+
+    #[test]
+    fn host_mouse_multiple_detents_retain_legacy_compatibility() {
+        let mut accumulator = WheelAxisAccumulator::default();
+        assert_eq!(
+            accumulator.accumulate(2.5),
+            WheelEmission {
+                hi_res: 300,
+                legacy: 2,
+            }
+        );
+        assert_eq!(
+            accumulator.accumulate(0.5),
+            WheelEmission {
+                hi_res: 60,
+                legacy: 1,
+            }
+        );
+    }
+
+    #[test]
+    fn host_mouse_horizontal_sign_is_preserved() {
+        let mut accumulator = WheelAxisAccumulator::default();
+        assert_eq!(accumulator.accumulate(1.0).hi_res, 120);
+        assert_eq!(accumulator.accumulate(-1.0).hi_res, -120);
+    }
+
+    #[test]
+    fn host_mouse_sub_unit_samples_accumulate_without_phantom_detents() {
+        let mut accumulator = WheelAxisAccumulator::default();
+        for _ in 0..8 {
+            assert_eq!(accumulator.accumulate(0.001), WheelEmission::default());
+        }
+        assert_eq!(
+            accumulator.accumulate(0.001),
+            WheelEmission {
+                hi_res: 1,
+                legacy: 0,
+            }
+        );
+    }
+}
