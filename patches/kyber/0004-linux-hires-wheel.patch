+const HI_RES_UNITS_PER_DETENT: f64 = 120.0;
+
+#[derive(Debug, Default, PartialEq, Eq)]
+struct WheelEmission {
+    hi_res: i32,
+    legacy: i32,
+}
+
+#[derive(Debug, Default)]
+struct WheelAxisAccumulator {
+    hi_res_remainder: f64,
+    legacy_remainder: i32,
+    direction: i8,
+}
+
+impl WheelAxisAccumulator {
+    fn accumulate(&mut self, delta: f32) -> WheelEmission {
+        if !delta.is_finite() || delta == 0.0 {
+            return WheelEmission::default();
+        }
+
+        let direction = if delta.is_sign_positive() { 1 } else { -1 };
+        if self.direction != 0 && self.direction != direction {
+            self.hi_res_remainder = 0.0;
+            self.legacy_remainder = 0;
+        }
+        self.direction = direction;
+
+        let scaled = f64::from(delta) * HI_RES_UNITS_PER_DETENT + self.hi_res_remainder;
+        let hi_res = scaled.trunc() as i32;
+        self.hi_res_remainder = scaled - f64::from(hi_res);
+        self.legacy_remainder += hi_res;
+
+        let legacy = self.legacy_remainder / HI_RES_UNITS_PER_DETENT as i32;
+        self.legacy_remainder %= HI_RES_UNITS_PER_DETENT as i32;
+
+        WheelEmission { hi_res, legacy }
+    }
+}
