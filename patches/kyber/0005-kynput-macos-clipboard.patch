+// Compile the platform-neutral macOS clipboard state machine on non-macOS
+// builders. On macOS the same tests are compiled as unit tests with the real
+// crate types, plus the uniquely named NSPasteboard integration test.
+#![cfg(not(target_os = "macos"))]
+#![allow(dead_code)]
+
+use std::sync::{Arc, PoisonError};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InputTarget {
+    Client,
+    Host,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Payload {
+    Clipboard(ClipboardEvent),
+    Other,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct InputPacket {
+    pub target: InputTarget,
+    pub payload: Payload,
+}
+
+impl InputPacket {
+    pub fn new(target: InputTarget, payload: Payload) -> Self {
+        Self { target, payload }
+    }
+}
+
+pub trait InputConsumer: Send + Sync {
+    fn consume(&self, packet: InputPacket) -> Result<()>;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InputType {
+    Clipboard,
+}
+
+#[derive(Debug)]
+pub enum Error {
+    Rejected,
+    InvalidType,
+    ThreadPanicked,
+    ChannelReceive,
+    ChannelSend,
+    Io(std::io::Error),
+}
+
+pub type Result<T> = std::result::Result<T, Error>;
+
+impl<T> From<PoisonError<T>> for Error {
+    fn from(_: PoisonError<T>) -> Self {
+        Self::ThreadPanicked
+    }
+}
+
+impl From<std::io::Error> for Error {
+    fn from(error: std::io::Error) -> Self {
+        Self::Io(error)
+    }
+}
+
+impl From<std::sync::mpsc::RecvError> for Error {
+    fn from(_: std::sync::mpsc::RecvError) -> Self {
+        Self::ChannelReceive
+    }
+}
+
+impl<T> From<std::sync::mpsc::SendError<T>> for Error {
+    fn from(_: std::sync::mpsc::SendError<T>) -> Self {
+        Self::ChannelSend
+    }
+}
+
+pub mod pipeline {
+    use super::*;
+
+    pub struct InputConsumerHandle {
+        pub consumer: Arc<dyn InputConsumer>,
+        pub handled_types: Vec<InputType>,
+    }
+
+    pub trait InputHandler: Send + Sync {
+        fn start(self: Arc<Self>) -> Result<()>;
+        fn stop(self: Arc<Self>) -> Result<()>;
+        fn configure_clipboard(
+            self: Arc<Self>,
+            allow_local_read_send: bool,
+            allow_remote_write: bool,
+        ) -> Result<()>;
+        fn to_consumer(self: Arc<Self>) -> Option<InputConsumerHandle>;
+        fn produced_types(self: Arc<Self>) -> Option<Vec<InputType>>;
+    }
+}
+
+pub mod types {
+    pub const MAX_CLIPBOARD_SIZE: usize = 60 * 1024;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum ClipboardFormat {
+        Text,
+        Html,
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub enum ClipboardData {
+        Text(String),
+        Html(String),
+    }
+
+    impl ClipboardData {
+        pub fn format(&self) -> ClipboardFormat {
+            match self {
+                Self::Text(_) => ClipboardFormat::Text,
+                Self::Html(_) => ClipboardFormat::Html,
+            }
+        }
+
+        pub fn size(&self) -> usize {
+            match self {
+                Self::Text(value) | Self::Html(value) => value.len(),
+            }
+        }
+    }
+}
+
+pub use types::{ClipboardData, ClipboardFormat};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ClipboardEvent {
+    Change { formats: Vec<ClipboardFormat> },
+    Data(ClipboardData),
+    DataRequest { format: ClipboardFormat },
+    DataUnavailable { format: ClipboardFormat },
+}
+
+#[path = "../src/macos/clipboard.rs"]
+mod clipboard;
