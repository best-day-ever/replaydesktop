+#[derive(Default)]
+struct LocalTransferBudget {
+    text_size: Option<usize>,
+    html_size: Option<usize>,
+}
+
+impl LocalTransferBudget {
+    fn reset(&mut self) {
+        *self = Self::default();
+    }
+
+    fn record(&mut self, format: ClipboardFormat, size: usize) -> bool {
+        let (text_size, html_size) = match format {
+            ClipboardFormat::Text => (Some(size), self.html_size),
+            ClipboardFormat::Html => (self.text_size, Some(size)),
+        };
+
+        if text_size.unwrap_or_default() + html_size.unwrap_or_default() > MAX_CLIPBOARD_SIZE {
+            return false;
+        }
+
+        self.text_size = text_size;
+        self.html_size = html_size;
+        true
+    }
+}
