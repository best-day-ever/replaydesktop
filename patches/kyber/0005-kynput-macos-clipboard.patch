+#[cfg(test)]
+mod tests {
+    use super::LocalTransferBudget;
+    use crate::types::{ClipboardFormat, MAX_CLIPBOARD_SIZE};
+
+    #[test]
+    fn combined_transfer_budget_accepts_exact_limit() {
+        let mut budget = LocalTransferBudget::default();
+        assert!(budget.record(ClipboardFormat::Text, MAX_CLIPBOARD_SIZE / 2));
+        assert!(budget.record(
+            ClipboardFormat::Html,
+            MAX_CLIPBOARD_SIZE - MAX_CLIPBOARD_SIZE / 2
+        ));
+    }
+
+    #[test]
+    fn combined_transfer_budget_rejects_oversize_without_consuming_budget() {
+        let mut budget = LocalTransferBudget::default();
+        assert!(budget.record(ClipboardFormat::Text, MAX_CLIPBOARD_SIZE - 1));
+        assert!(!budget.record(ClipboardFormat::Html, 2));
+        assert!(budget.record(ClipboardFormat::Html, 1));
+    }
+
+    #[test]
+    fn repeated_format_replaces_its_previous_size() {
+        let mut budget = LocalTransferBudget::default();
+        assert!(budget.record(ClipboardFormat::Text, MAX_CLIPBOARD_SIZE - 10));
+        assert!(budget.record(ClipboardFormat::Text, 10));
+        assert!(budget.record(ClipboardFormat::Html, MAX_CLIPBOARD_SIZE - 10));
+    }
+
+    #[test]
+    fn reset_starts_a_new_local_generation() {
+        let mut budget = LocalTransferBudget::default();
+        assert!(budget.record(ClipboardFormat::Text, MAX_CLIPBOARD_SIZE));
+        assert!(!budget.record(ClipboardFormat::Html, 1));
+        budget.reset();
+        assert!(budget.record(ClipboardFormat::Html, MAX_CLIPBOARD_SIZE));
+    }
+}
