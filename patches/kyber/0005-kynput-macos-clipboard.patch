+        );
+        let mut pasteboard = NativePasteboard::named(&name).unwrap();
+        let expected = snapshot(Some("named text"), Some("<p>named html</p>"));
+        pasteboard.write_snapshot(&expected).unwrap();
+        assert_eq!(pasteboard.read_snapshot().unwrap(), expected);
+    }
+}
