+use std::collections::VecDeque;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc::{self, Receiver, RecvTimeoutError, Sender},
+    Arc, Mutex, Weak,
+};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use log::{debug, info};
+
+use crate::pipeline::{InputConsumerHandle, InputHandler};
+use crate::types::{ClipboardData, ClipboardFormat, MAX_CLIPBOARD_SIZE};
+use crate::{
+    ClipboardEvent, Error, InputConsumer, InputPacket, InputTarget, InputType, Payload, Result,
+};
+
+#[cfg(target_os = "macos")]
+use objc2::rc::{autoreleasepool, Retained};
+#[cfg(target_os = "macos")]
+use objc2::runtime::ProtocolObject;
+#[cfg(target_os = "macos")]
+use objc2_app_kit::{
+    NSPasteboard, NSPasteboardItem, NSPasteboardTypeHTML, NSPasteboardTypeString,
+    NSPasteboardWriting,
+};
+#[cfg(target_os = "macos")]
+use objc2_foundation::{NSArray, NSString};
+
+const CLIPBOARD_WORKER_NAME: &str = "kynput-macos-clipboard";
+const POLL_INTERVAL: Duration = Duration::from_millis(150);
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct ClipboardSnapshot {
+    text: Option<String>,
+    html: Option<String>,
+}
+
+impl ClipboardSnapshot {
+    fn size(&self) -> usize {
+        self.text.as_ref().map_or(0, String::len) + self.html.as_ref().map_or(0, String::len)
+    }
+
+    fn is_within_limit(&self) -> bool {
+        self.size() <= MAX_CLIPBOARD_SIZE
+    }
+
+    fn formats(&self) -> Vec<ClipboardFormat> {
+        let mut formats = Vec::with_capacity(2);
+        if self.text.is_some() {
+            formats.push(ClipboardFormat::Text);
+        }
+        if self.html.is_some() {
+            formats.push(ClipboardFormat::Html);
+        }
+        formats
+    }
+
+    fn data(&self, format: ClipboardFormat) -> Option<ClipboardData> {
+        match format {
+            ClipboardFormat::Text => self.text.clone().map(ClipboardData::Text),
+            ClipboardFormat::Html => self.html.clone().map(ClipboardData::Html),
+        }
+    }
+
+    fn set_data(&mut self, data: ClipboardData) {
+        match data {
+            ClipboardData::Text(text) => self.text = Some(text),
+            ClipboardData::Html(html) => self.html = Some(html),
+        }
+    }
+}
+
+/// Pasteboard access boundary.
+///
+/// Implementations are created and used only on the clipboard worker. In
+/// particular, the production implementation must not be constructed on the
+/// caller thread because obtaining the pasteboard is itself an AppKit call.
+trait PasteboardBackend {
+    fn change_count(&mut self) -> Result<i64>;
+    fn read_snapshot(&mut self) -> Result<ClipboardSnapshot>;
+
+    /// Replace all supported representations as one logical pasteboard item.
+    ///
+    /// The returned count is the change count produced by the write. This
+    /// avoids a separate change-count read when local clipboard access is
+    /// denied but remote writes are allowed.
+    fn write_snapshot(&mut self, snapshot: &ClipboardSnapshot) -> Result<i64>;
+}
+
+type PasteboardFactory = Box<dyn FnOnce() -> Result<Box<dyn PasteboardBackend>> + Send + 'static>;
+
+#[cfg(target_os = "macos")]
+struct NativePasteboard {
+    pasteboard: Retained<NSPasteboard>,
+}
+
+#[cfg(target_os = "macos")]
+impl NativePasteboard {
+    fn general() -> Result<Box<dyn PasteboardBackend>> {
+        let pasteboard = unsafe { NSPasteboard::generalPasteboard() };
+        Ok(Box::new(Self { pasteboard }))
+    }
+
+    #[cfg(test)]
+    fn named(name: &str) -> Result<Box<dyn PasteboardBackend>> {
+        let name = NSString::from_str(name);
+        let pasteboard = unsafe { NSPasteboard::pasteboardWithName(&name) };
+        Ok(Box::new(Self { pasteboard }))
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl PasteboardBackend for NativePasteboard {
+    fn change_count(&mut self) -> Result<i64> {
+        Ok(unsafe { self.pasteboard.changeCount() } as i64)
+    }
+
+    fn read_snapshot(&mut self) -> Result<ClipboardSnapshot> {
+        autoreleasepool(|pool| {
+            let text = unsafe {
+                self.pasteboard
+                    .stringForType(NSPasteboardTypeString)
+                    .map(|value| value.as_str(pool).to_owned())
+            };
+            let html = unsafe {
+                self.pasteboard
+                    .stringForType(NSPasteboardTypeHTML)
+                    .map(|value| value.as_str(pool).to_owned())
+            };
+            Ok(ClipboardSnapshot { text, html })
+        })
+    }
+
+    fn write_snapshot(&mut self, snapshot: &ClipboardSnapshot) -> Result<i64> {
+        autoreleasepool(|_| {
+            let item = unsafe { NSPasteboardItem::new() };
+
+            if let Some(text) = snapshot.text.as_deref() {
+                let text = NSString::from_str(text);
+                if !unsafe { item.setString_forType(&text, NSPasteboardTypeString) } {
+                    return Err(Error::Rejected);
+                }
+            }
+
+            if let Some(html) = snapshot.html.as_deref() {
+                let html = NSString::from_str(html);
+                if !unsafe { item.setString_forType(&html, NSPasteboardTypeHTML) } {
+                    return Err(Error::Rejected);
+                }
+            }
+
+            let change_count = unsafe { self.pasteboard.clearContents() } as i64;
+            if snapshot.formats().is_empty() {
+                return Ok(change_count);
+            }
+
+            let item: Retained<ProtocolObject<dyn NSPasteboardWriting>> =
+                ProtocolObject::from_retained(item);
+            let items = NSArray::from_vec(vec![item]);
+            if !unsafe { self.pasteboard.writeObjects(&items) } {
+                return Err(Error::Rejected);
+            }
+
+            // Record the post-write value rather than assuming writeObjects
+            // preserves clearContents' count on every supported macOS build.
+            // This query is part of the authorized remote-write transaction,
+            // never the disabled local polling path.
+            Ok(unsafe { self.pasteboard.changeCount() } as i64)
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct ClipboardPermissions {
+    allow_local_read_send: bool,
+    allow_remote_write: bool,
+}
+
+impl ClipboardPermissions {
+    fn any(self) -> bool {
+        self.allow_local_read_send || self.allow_remote_write
+    }
+}
+
+struct RemoteFetch {
+    generation: u64,
+    formats: Vec<ClipboardFormat>,
+    next_index: usize,
+    outstanding: Option<ClipboardFormat>,
+    snapshot: ClipboardSnapshot,
+}
+
+impl RemoteFetch {
+    fn new(generation: u64, formats: Vec<ClipboardFormat>) -> Self {
+        Self {
+            generation,
+            formats,
+            next_index: 0,
+            outstanding: None,
+            snapshot: ClipboardSnapshot::default(),
+        }
+    }
+}
+
+struct ClipboardWorker {
+    pasteboard: Box<dyn PasteboardBackend>,
+    remote: Weak<dyn InputConsumer>,
+    target: InputTarget,
+    permissions: ClipboardPermissions,
+    last_change_count: Option<i64>,
+    self_write_change_count: Option<i64>,
+    last_known_snapshot: Option<ClipboardSnapshot>,
+    last_known_invalid: bool,
+    local_snapshot: Option<ClipboardSnapshot>,
+    next_remote_generation: u64,
+    remote_fetch: Option<RemoteFetch>,
+    stale_responses: VecDeque<ClipboardFormat>,
+    stop_requested: Arc<AtomicBool>,
+}
+
+impl ClipboardWorker {
+    fn new(
+        mut pasteboard: Box<dyn PasteboardBackend>,
+        remote: Weak<dyn InputConsumer>,
+        target: InputTarget,
+        permissions: ClipboardPermissions,
+        stop_requested: Arc<AtomicBool>,
+    ) -> Result<Self> {
+        let last_change_count = if permissions.allow_local_read_send {
+            // Establish a baseline without reading or advertising the current
+            // clipboard. Existing content predates explicit user consent for
+            // this session.
+            Some(pasteboard.change_count()?)
+        } else {
+            None
+        };
+
+        Ok(Self {
+            pasteboard,
+            remote,
+            target,
+            permissions,
+            last_change_count,
+            self_write_change_count: None,
+            last_known_snapshot: None,
+            last_known_invalid: false,
+            local_snapshot: None,
+            next_remote_generation: 0,
+            remote_fetch: None,
+            stale_responses: VecDeque::new(),
+            stop_requested,
+        })
+    }
+
+    fn send_event(&self, event: ClipboardEvent) -> Result<()> {
+        if self.stop_requested.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        if let Some(remote) = self.remote.upgrade() {
+            remote.consume(InputPacket::new(self.target, Payload::Clipboard(event)))?;
+        }
+        Ok(())
+    }
+
+    fn cancel_remote_fetch(&mut self) {
+        if let Some(mut fetch) = self.remote_fetch.take() {
+            if let Some(format) = fetch.outstanding.take() {
+                self.stale_responses.push_back(format);
+            }
+            debug!("Cancelled clipboard remote generation {}", fetch.generation);
+        }
+    }
+
+    /// Check for a local change. Returns true when a new valid or invalid
+    /// local generation was observed, including a same-content generation
+    /// that deliberately did not produce a network packet.
+    fn poll_local_change(&mut self) -> Result<bool> {
+        if self.stop_requested.load(Ordering::Acquire) || !self.permissions.allow_local_read_send {
+            return Ok(false);
+        }
+
+        let change_count = self.pasteboard.change_count()?;
+        if self.last_change_count == Some(change_count) {
+            return Ok(false);
+        }
+        self.last_change_count = Some(change_count);
+
+        if self.self_write_change_count == Some(change_count) {
+            self.self_write_change_count = None;
+            return Ok(false);
+        }
+        self.self_write_change_count = None;
+
+        let snapshot = self.pasteboard.read_snapshot()?;
+        if !snapshot.is_within_limit() {
+            self.cancel_remote_fetch();
+            self.local_snapshot = None;
+            self.last_known_snapshot = None;
+
+            if self.last_known_invalid {
+                return Ok(true);
+            }
+
+            self.last_known_invalid = true;
+            self.send_event(ClipboardEvent::Change {
+                formats: Vec::new(),
+            })?;
+            return Ok(true);
+        }
+
+        if !self.last_known_invalid && self.last_known_snapshot.as_ref() == Some(&snapshot) {
+            // Re-owning identical content must not create an echo. Do not
+            // create a new advertised snapshot when no Change was sent.
+            return Ok(true);
+        }
+
+        self.cancel_remote_fetch();
+        self.last_known_invalid = false;
+        self.last_known_snapshot = Some(snapshot.clone());
+        self.local_snapshot = Some(snapshot.clone());
+        self.send_event(ClipboardEvent::Change {
+            formats: snapshot.formats(),
+        })?;
+        Ok(true)
+    }
+
+    fn canonical_remote_formats(formats: Vec<ClipboardFormat>) -> Vec<ClipboardFormat> {
+        let mut canonical = Vec::with_capacity(2);
+        if formats.contains(&ClipboardFormat::Text) {
+            canonical.push(ClipboardFormat::Text);
+        }
+        if formats.contains(&ClipboardFormat::Html) {
+            canonical.push(ClipboardFormat::Html);
+        }
+        canonical
+    }
+
+    fn on_remote_change(&mut self, formats: Vec<ClipboardFormat>) -> Result<()> {
+        self.cancel_remote_fetch();
+        self.next_remote_generation = self.next_remote_generation.wrapping_add(1);
+        let generation = self.next_remote_generation;
+        self.remote_fetch = Some(RemoteFetch::new(
+            generation,
+            Self::canonical_remote_formats(formats),
+        ));
+        self.advance_remote_fetch()
+    }
+
+    fn drain_stale_response(&mut self, format: ClipboardFormat) -> Result<bool> {
+        let Some(expected) = self.stale_responses.front().copied() else {
+            return Ok(false);
+        };
+
+        if expected == format {
+            self.stale_responses.pop_front();
+            self.advance_remote_fetch()?;
+        } else {
+            debug!("Ignoring unsolicited clipboard response while draining a stale generation");
+        }
+        Ok(true)
+    }
+
+    fn on_remote_data(&mut self, data: ClipboardData) -> Result<()> {
+        let format = data.format();
+        if self.drain_stale_response(format)? {
+            return Ok(());
+        }
+
+        let Some(fetch) = self.remote_fetch.as_mut() else {
+            debug!("Ignoring unsolicited clipboard data");
+            return Ok(());
+        };
+        if fetch.outstanding != Some(format) {
+            debug!("Ignoring clipboard data for an unrequested format");
+            return Ok(());
+        }
+
+        // The response consumed the one outstanding request. If validation
+        // fails, no stale response remains to drain.
+        fetch.outstanding = None;
+        if data.size() > MAX_CLIPBOARD_SIZE {
+            self.remote_fetch = None;
+            return Ok(());
+        }
+
+        fetch.snapshot.set_data(data);
+        if !fetch.snapshot.is_within_limit() {
+            self.remote_fetch = None;
+            return Ok(());
+        }
+
+        fetch.next_index += 1;
+        self.advance_remote_fetch()
+    }
+
+    fn on_remote_unavailable(&mut self, format: ClipboardFormat) -> Result<()> {
+        if self.drain_stale_response(format)? {
+            return Ok(());
+        }
+
+        let is_expected = self
+            .remote_fetch
+            .as_ref()
+            .is_some_and(|fetch| fetch.outstanding == Some(format));
+        if is_expected {
+            // Atomicity requires abandoning the whole generation rather than
+            // publishing whichever representation arrived first.
+            self.remote_fetch = None;
+        } else {
+            debug!("Ignoring unsolicited clipboard-unavailable response");
+        }
+        Ok(())
+    }
+
+    fn advance_remote_fetch(&mut self) -> Result<()> {
+        if self.stop_requested.load(Ordering::Acquire) || !self.stale_responses.is_empty() {
+            return Ok(());
+        }
+
+        enum Next {
+            Wait,
+            Request(ClipboardFormat),
+            Commit,
+        }
+
+        let next = match self.remote_fetch.as_ref() {
+            None => return Ok(()),
+            Some(fetch) if fetch.outstanding.is_some() => Next::Wait,
+            Some(fetch) if fetch.next_index < fetch.formats.len() => {
+                Next::Request(fetch.formats[fetch.next_index])
+            }
+            Some(_) => Next::Commit,
+        };
+
+        match next {
+            Next::Wait => Ok(()),
+            Next::Request(format) => {
+                if let Some(fetch) = self.remote_fetch.as_mut() {
+                    fetch.outstanding = Some(format);
+                }
+                self.send_event(ClipboardEvent::DataRequest { format })
+            }
+            Next::Commit => {
+                // A real local pasteboard change that raced with the fetch
+                // wins. This check happens immediately before the only write.
+                if self.poll_local_change()? {
+                    return Ok(());
+                }
+                if self.stop_requested.load(Ordering::Acquire) {
+                    self.remote_fetch = None;
+                    return Ok(());
+                }
+                let snapshot = self.remote_fetch.take().ok_or(Error::Rejected)?.snapshot;
+                self.commit_remote_snapshot(snapshot)
+            }
+        }
+    }
+
+    fn commit_remote_snapshot(&mut self, snapshot: ClipboardSnapshot) -> Result<()> {
+        if !snapshot.is_within_limit() {
+            return Ok(());
+        }
+        if !self.last_known_invalid && self.last_known_snapshot.as_ref() == Some(&snapshot) {
+            return Ok(());
+        }
+
+        let change_count = self.pasteboard.write_snapshot(&snapshot)?;
+        self.last_known_invalid = false;
+        self.last_known_snapshot = Some(snapshot);
+        self.local_snapshot = None;
+
+        if self.permissions.allow_local_read_send {
+            self.last_change_count = Some(change_count);
+            self.self_write_change_count = Some(change_count);
+        }
+        Ok(())
+    }
+
+    fn on_data_request(&mut self, format: ClipboardFormat) -> Result<()> {
+        let event = self
+            .local_snapshot
+            .as_ref()
+            .and_then(|snapshot| snapshot.data(format))
+            .map(ClipboardEvent::Data)
+            .unwrap_or(ClipboardEvent::DataUnavailable { format });
+        self.send_event(event)
+    }
+
+    fn on_packet(&mut self, packet: InputPacket) -> Result<()> {
+        let Payload::Clipboard(event) = packet.payload else {
+            return Err(Error::InvalidType);
+        };
+
+        match event {
+            ClipboardEvent::Change { formats } if self.permissions.allow_remote_write => {
+                self.on_remote_change(formats)
+            }
+            ClipboardEvent::Data(data) if self.permissions.allow_remote_write => {
+                self.on_remote_data(data)
+            }
+            ClipboardEvent::DataUnavailable { format } if self.permissions.allow_remote_write => {
+                self.on_remote_unavailable(format)
+            }
+            ClipboardEvent::DataRequest { format } if self.permissions.allow_local_read_send => {
+                self.on_data_request(format)
+            }
+            _ => {
+                debug!("Ignoring unauthorized clipboard event");
+                Ok(())
+            }
+        }
+    }
+}
+
+enum WorkerCommand {
+    Packet(InputPacket),
+    Stop,
+    #[cfg(test)]
+    Poll(Sender<Result<()>>),
+    #[cfg(test)]
+    Barrier(Sender<()>),
+}
+
+struct WorkerHandle {
+    sender: Sender<WorkerCommand>,
+    join_handle: JoinHandle<Result<()>>,
+    stop_requested: Arc<AtomicBool>,
+}
+
+impl WorkerHandle {
+    fn stop(self) -> Result<()> {
+        self.stop_requested.store(true, Ordering::Release);
+        // A disconnected worker is still joined so a backend error is not
+        // hidden behind the channel error.
+        let send_result = self.sender.send(WorkerCommand::Stop);
+        let join_result = self.join_handle.join().map_err(|_| Error::ThreadPanicked)?;
+        join_result?;
+        send_result?;
+        Ok(())
+    }
+}
+
+fn worker_entry(
+    receiver: Receiver<WorkerCommand>,
+    factory: PasteboardFactory,
+    remote: Weak<dyn InputConsumer>,
+    target: InputTarget,
+    permissions: ClipboardPermissions,
+    ready: Sender<bool>,
+    stop_requested: Arc<AtomicBool>,
+) -> Result<()> {
+    let pasteboard = match factory() {
+        Ok(pasteboard) => pasteboard,
+        Err(error) => {
+            let _ = ready.send(false);
+            return Err(error);
+        }
+    };
+    let mut worker = match ClipboardWorker::new(
+        pasteboard,
+        remote,
+        target,
+        permissions,
+        stop_requested.clone(),
+    ) {
+        Ok(worker) => worker,
+        Err(error) => {
+            let _ = ready.send(false);
+            return Err(error);
+        }
+    };
+    ready.send(true)?;
+
+    loop {
+        if stop_requested.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        match receiver.recv_timeout(POLL_INTERVAL) {
+            Ok(WorkerCommand::Packet(packet)) => {
+                if stop_requested.load(Ordering::Acquire) {
+                    return Ok(());
+                }
+                // Poll before every response as well as on the timer so local
+                // changes cannot lose merely because network traffic is busy.
+                worker.poll_local_change()?;
+                worker.on_packet(packet)?;
+            }
+            Ok(WorkerCommand::Stop) => return Ok(()),
+            #[cfg(test)]
+            Ok(WorkerCommand::Poll(done)) => {
+                let result = worker.poll_local_change().map(|_| ());
+                let should_stop = result.is_err();
+                let _ = done.send(result);
+                if should_stop {
+                    return Err(Error::Rejected);
+                }
+            }
+            #[cfg(test)]
+            Ok(WorkerCommand::Barrier(done)) => {
+                let _ = done.send(());
+            }
+            Err(RecvTimeoutError::Timeout) => {
+                worker.poll_local_change()?;
+            }
+            Err(RecvTimeoutError::Disconnected) => return Ok(()),
+        }
+    }
+}
+
+struct HandlerState {
+    permissions: ClipboardPermissions,
+    factory: Option<PasteboardFactory>,
+    worker: Option<WorkerHandle>,
+    started: bool,
+}
+
+pub struct ClipboardHandler {
+    remote: Weak<dyn InputConsumer>,
+    target: InputTarget,
+    state: Mutex<HandlerState>,
+}
+
+impl ClipboardHandler {
+    #[cfg(target_os = "macos")]
+    pub fn new(
+        target: InputTarget,
+        remote: Weak<dyn InputConsumer>,
+        allow_local_read_send: bool,
+        allow_remote_write: bool,
+    ) -> Result<Self> {
+        Ok(Self::with_factory(
+            target,
+            remote,
+            allow_local_read_send,
+            allow_remote_write,
+            Box::new(NativePasteboard::general),
+        ))
+    }
+
+    fn with_factory(
+        target: InputTarget,
+        remote: Weak<dyn InputConsumer>,
+        allow_local_read_send: bool,
+        allow_remote_write: bool,
+        factory: PasteboardFactory,
+    ) -> Self {
+        Self {
+            remote,
+            target,
+            state: Mutex::new(HandlerState {
+                permissions: ClipboardPermissions {
+                    allow_local_read_send,
+                    allow_remote_write,
+                },
+                factory: Some(factory),
+                worker: None,
+                started: false,
+            }),
+        }
+    }
+
+    /// Configure the independently negotiated clipboard directions.
+    ///
+    /// This must be called after negotiation and before `InputPipeline::start`.
+    /// `allow_local_read_send` maps to host `allow_paste`;
+    /// `allow_remote_write` maps to host `allow_copy`.
+    pub fn configure_permissions(
+        &self,
+        allow_local_read_send: bool,
+        allow_remote_write: bool,
+    ) -> Result<()> {
+        let mut state = self.state.lock()?;
+        if state.started {
+            return Err(Error::Rejected);
+        }
+        state.permissions = ClipboardPermissions {
+            allow_local_read_send,
+            allow_remote_write,
+        };
+        Ok(())
+    }
+
+    fn start_worker(&self) -> Result<()> {
+        let mut state = self.state.lock()?;
+        if state.started {
+            return Err(Error::Rejected);
+        }
+        state.started = true;
+
+        if !state.permissions.any() {
+            info!("macOS clipboard disabled");
+            return Ok(());
+        }
+
+        let permissions = state.permissions;
+        info!(
+            "macOS clipboard enabled: allow_local_read_send={} allow_remote_write={}",
+            permissions.allow_local_read_send, permissions.allow_remote_write
+        );
+        let Some(factory) = state.factory.take() else {
+            state.started = false;
+            return Err(Error::Rejected);
+        };
+        let (sender, receiver) = mpsc::channel();
+        let (ready_sender, ready_receiver) = mpsc::channel();
+        let remote = self.remote.clone();
+        let target = self.target;
+        let stop_requested = Arc::new(AtomicBool::new(false));
+        let worker_stop_requested = stop_requested.clone();
+        let join_handle = match thread::Builder::new()
+            .name(CLIPBOARD_WORKER_NAME.to_owned())
+            .spawn(move || {
+                worker_entry(
+                    receiver,
+                    factory,
+                    remote,
+                    target,
+                    permissions,
+                    ready_sender,
+                    worker_stop_requested,
+                )
+            }) {
+            Ok(join_handle) => join_handle,
+            Err(error) => {
+                state.started = false;
+                return Err(error.into());
+            }
+        };
+
+        let ready = match ready_receiver.recv() {
+            Ok(ready) => ready,
+            Err(error) => {
+                state.started = false;
+                drop(state);
+                let _ = join_handle.join();
+                return Err(error.into());
+            }
+        };
+        match ready {
+            true => {
+                state.worker = Some(WorkerHandle {
+                    sender,
+                    join_handle,
+                    stop_requested,
+                });
+                Ok(())
+            }
+            false => {
+                state.started = false;
+                drop(state);
+                join_handle.join().map_err(|_| Error::ThreadPanicked)??;
+                Err(Error::Rejected)
+            }
+        }
+    }
+
+    fn stop_worker(&self) -> Result<()> {
+        let worker = {
+            let mut state = self.state.lock()?;
+            if !state.started {
+                return Ok(());
+            }
+            state.started = false;
+            state.worker.take()
+        };
+
+        if let Some(worker) = worker {
+            worker.stop()?;
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    fn poll_for_test(&self) -> Result<()> {
+        let sender = self
+            .state
+            .lock()?
+            .worker
+            .as_ref()
+            .map(|worker| worker.sender.clone());
+        let Some(sender) = sender else {
+            return Ok(());
+        };
+        let (done_sender, done_receiver) = mpsc::channel();
+        sender.send(WorkerCommand::Poll(done_sender))?;
+        done_receiver.recv()?
+    }
+
+    #[cfg(test)]
+    fn barrier_for_test(&self) -> Result<()> {
+        let sender = self
+            .state
+            .lock()?
+            .worker
+            .as_ref()
+            .map(|worker| worker.sender.clone());
+        let Some(sender) = sender else {
+            return Ok(());
+        };
+        let (done_sender, done_receiver) = mpsc::channel();
+        sender.send(WorkerCommand::Barrier(done_sender))?;
+        done_receiver.recv()?;
+        Ok(())
+    }
+}
+
+impl InputConsumer for ClipboardHandler {
+    fn consume(&self, packet: InputPacket) -> Result<()> {
+        let sender = self
+            .state
+            .lock()?
+            .worker
+            .as_ref()
+            .map(|worker| worker.sender.clone());
+        if let Some(sender) = sender {
+            sender.send(WorkerCommand::Packet(packet))?;
+        }
+        Ok(())
+    }
+}
+
+impl InputHandler for ClipboardHandler {
+    fn start(self: Arc<Self>) -> Result<()> {
+        self.start_worker()
+    }
+
+    fn stop(self: Arc<Self>) -> Result<()> {
+        self.stop_worker()
+    }
+
+    fn configure_clipboard(
+        self: Arc<Self>,
+        allow_local_read_send: bool,
+        allow_remote_write: bool,
+    ) -> Result<()> {
+        self.configure_permissions(allow_local_read_send, allow_remote_write)
+    }
+
+    fn to_consumer(self: Arc<Self>) -> Option<InputConsumerHandle> {
+        Some(InputConsumerHandle {
+            consumer: self,
+            handled_types: vec![InputType::Clipboard],
+        })
+    }
+
+    fn produced_types(self: Arc<Self>) -> Option<Vec<InputType>> {
+        Some(vec![InputType::Clipboard])
+    }
+}
