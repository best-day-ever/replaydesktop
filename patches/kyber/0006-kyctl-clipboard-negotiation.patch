@@ -200,14 +204,96 @@ pub(crate) async fn start_stream(
     );
 
     let requested_clipboard = body.inputs.as_ref().is_some_and(|inputs| inputs.clipboard);
-    let got_clipboard = response
-        .input
-        .as_ref()
-        .is_some_and(|inputs| inputs.clipboard);
+    let (allow_local_read_send, allow_remote_write) =
+        negotiated_clipboard_permissions(requested_clipboard, response.input.as_ref());
 
-    if requested_clipboard && !got_clipboard {
-        warn!("Requested clipboard forwarding but server did not enable it.");
+    if requested_clipboard && !allow_local_read_send {
+        warn!("Clipboard paste to the host was requested but not enabled by the server.");
+    }
+    if requested_clipboard && !allow_remote_write {
+        warn!("Clipboard copy from the host was requested but not enabled by the server.");
     }
 
