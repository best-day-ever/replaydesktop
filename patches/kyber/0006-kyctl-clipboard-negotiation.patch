 }
+
+pub(crate) fn negotiated_clipboard_permissions(
+    requested: bool,
+    response: Option<&StartSessionInputResponse>,
+) -> (bool, bool) {
+    if !requested {
+        return (false, false);
+    }
+
+    let Some(response) = response else {
+        return (false, false);
+    };
+
+    // Read but deliberately do not trust the legacy aggregate: an older host
+    // cannot express which pasteboard direction it authorized.
+    let _legacy_aggregate = response.clipboard;
+
+    // Host allow_paste authorizes reading/sending the local Mac clipboard.
+    // Host allow_copy authorizes writing remotely supplied data on the Mac.
+    (
+        response.clipboard_allow_paste,
+        response.clipboard_allow_copy,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{negotiated_clipboard_permissions, StartSessionInputResponse};
+
+    fn response(copy: bool, paste: bool) -> StartSessionInputResponse {
+        StartSessionInputResponse {
+            endpoint: 7,
+            clipboard: copy || paste,
+            clipboard_allow_copy: copy,
+            clipboard_allow_paste: paste,
+        }
+    }
+
+    #[test]
+    fn disabled_request_denies_both_directions() {
+        assert_eq!(
+            negotiated_clipboard_permissions(false, Some(&response(true, true))),
+            (false, false)
+        );
+    }
+
+    #[test]
+    fn missing_or_legacy_response_fails_closed() {
+        assert_eq!(negotiated_clipboard_permissions(true, None), (false, false));
+        assert_eq!(
+            negotiated_clipboard_permissions(true, Some(&response(false, false))),
+            (false, false)
+        );
+        let legacy_only = StartSessionInputResponse {
+            endpoint: 7,
+            clipboard: true,
+            clipboard_allow_copy: false,
+            clipboard_allow_paste: false,
+        };
+        assert_eq!(
+            negotiated_clipboard_permissions(true, Some(&legacy_only)),
+            (false, false)
+        );
+    }
+
+    #[test]
+    fn maps_host_paste_to_local_read_and_host_copy_to_remote_write() {
+        assert_eq!(
+            negotiated_clipboard_permissions(true, Some(&response(false, true))),
+            (true, false)
+        );
+        assert_eq!(
+            negotiated_clipboard_permissions(true, Some(&response(true, false))),
+            (false, true)
+        );
+        assert_eq!(
+            negotiated_clipboard_permissions(true, Some(&response(true, true))),
+            (true, true)
+        );
+    }
+}
