+#[cfg(test)]
+mod clipboard_pipeline_tests {
+    use super::input_pipeline_required;
+
+    #[test]
+    fn clipboard_can_start_the_pipeline_without_interactive_input() {
+        assert!(input_pipeline_required(false, Some(true)));
+        assert!(!input_pipeline_required(false, Some(false)));
+        assert!(!input_pipeline_required(false, None));
+    }
+
+    #[test]
+    fn interactive_input_still_starts_the_pipeline_independently() {
+        assert!(input_pipeline_required(true, Some(false)));
+        assert!(input_pipeline_required(true, None));
+    }
