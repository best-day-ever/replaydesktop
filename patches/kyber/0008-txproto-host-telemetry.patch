-    metrics->cb(entries, count, metrics->userdata);
+
+    tx_metrics_entry batch[TX_METRICS_MAX_BATCH_ENTRIES];
+    size_t batch_count = 0;
+    uint_fast64_t lost_batches;
+    uint_fast64_t lost_entries;
+
+    if (snapshot_callback_loss(metrics, &lost_batches, &lost_entries) &&
+        lost_batches != 0) {
+        batch[batch_count++] = (tx_metrics_entry) {
+            .key = "telemetry_callback_lost_batches_total",
+            .value = metrics_counter_value(lost_batches),
+        };
+        batch[batch_count++] = (tx_metrics_entry) {
+            .key = "telemetry_callback_lost_entries_total",
+            .value = metrics_counter_value(lost_entries),
+        };
+    }
+
+    if (!entries || count > TX_METRICS_MAX_BATCH_ENTRIES - batch_count) {
+        record_callback_loss(metrics, count);
+        return;
+    }
+
+    for (size_t i = 0; i < count; i++)
+        batch[batch_count++] = entries[i];
+
+    if (metrics->cb(batch, batch_count, metrics->userdata) != 0)
+        record_callback_loss(metrics, batch_count);
+}
+
+int tx_metrics_emit_payload(struct tx_metrics *metrics,
+                            int64_t pts,
+                            const char *legacy_stage_key,
+                            int64_t stage_timestamp,
+                            const char *payload_key,
+                            int64_t payload_bytes)
+{
+    if (!metrics || !legacy_stage_key || !payload_key || payload_bytes < 0)
+        return AVERROR(EINVAL);
+
+    const tx_metrics_entry entries[] = {
+        { .key = "pts", .value = pts },
+        { .key = legacy_stage_key, .value = stage_timestamp },
+        { .key = payload_key, .value = payload_bytes },
+    };
+    tx_metrics_push(metrics, entries, sizeof(entries) / sizeof(entries[0]));
+    return 0;
+}
+
+int tx_metrics_emit_queue(struct tx_metrics *metrics,
+                          int64_t pts,
+                          enum tx_metrics_queue_stage stage,
+                          int64_t depth,
+                          int64_t limit)
+{
+    if (!metrics || stage < TX_METRICS_QUEUE_STAGE_CAPTURE ||
+        stage > TX_METRICS_QUEUE_STAGE_PACKET_SINK ||
+        depth < 0 || limit <= 0 || depth > limit)
+        return AVERROR(EINVAL);
+
+    const tx_metrics_entry entries[] = {
+        { .key = "pts", .value = pts },
+        { .key = "queue_stage", .value = stage },
+        { .key = "queue_depth", .value = depth },
+        { .key = "queue_limit", .value = limit },
+    };
+    tx_metrics_push(metrics, entries, sizeof(entries) / sizeof(entries[0]));
+    return 0;
+}
+
+int tx_metrics_emit_queue_unavailable(struct tx_metrics *metrics,
+                                      int64_t pts,
+                                      enum tx_metrics_queue_stage stage,
+                                      enum tx_metrics_reason reason)
+{
+    if (!metrics || stage < TX_METRICS_QUEUE_STAGE_CAPTURE ||
+        stage > TX_METRICS_QUEUE_STAGE_PACKET_SINK ||
+        reason < TX_METRICS_REASON_OWNER_NO_DESTINATION ||
+        reason > TX_METRICS_REASON_OWNER_CHANGED)
+        return AVERROR(EINVAL);
+
+    const tx_metrics_entry entries[] = {
+        { .key = "pts", .value = pts },
+        { .key = "queue_stage", .value = stage },
+        { .key = "queue_owner_unavailable", .value = reason },
+    };
+    tx_metrics_push(metrics, entries, sizeof(entries) / sizeof(entries[0]));
+    return 0;
+}
+
+int tx_metrics_emit_drop(struct tx_metrics *metrics,
+                         int64_t pts,
+                         int64_t timestamp,
+                         enum tx_metrics_drop_stage stage,
+                         enum tx_metrics_reason reason,
+                         int64_t depth,
+                         int64_t limit,
+                         int64_t total)
+{
+    if (!metrics || stage < TX_METRICS_DROP_STAGE_CAPTURE ||
+        stage > TX_METRICS_DROP_STAGE_ENCODED_PACKET ||
+        reason != TX_METRICS_REASON_FIFO_FULL ||
+        depth < 0 || limit <= 0 || depth > limit || total < 0)
+        return AVERROR(EINVAL);
+
+    const tx_metrics_entry entries[] = {
+        { .key = "pts", .value = pts },
+        { .key = "dropped", .value = timestamp },
+        { .key = "drop_stage", .value = stage },
+        { .key = "drop_reason", .value = reason },
+        { .key = "queue_depth", .value = depth },
+        { .key = "queue_limit", .value = limit },
+        { .key = "drop_total", .value = total },
+    };
+    tx_metrics_push(metrics, entries, sizeof(entries) / sizeof(entries[0]));
+    return 0;
+}
+
+int tx_metrics_emit_drop_unavailable(struct tx_metrics *metrics,
+                                     int64_t pts,
+                                     int64_t timestamp,
+                                     enum tx_metrics_drop_stage stage,
+                                     enum tx_metrics_reason reason,
+                                     int64_t total,
+                                     enum tx_metrics_reason owner_reason)
+{
+    if (!metrics || stage < TX_METRICS_DROP_STAGE_CAPTURE ||
+        stage > TX_METRICS_DROP_STAGE_ENCODED_PACKET ||
+        reason != TX_METRICS_REASON_FIFO_FULL || total < 0 ||
+        owner_reason < TX_METRICS_REASON_OWNER_NO_DESTINATION ||
+        owner_reason > TX_METRICS_REASON_OWNER_CHANGED)
+        return AVERROR(EINVAL);
+
+    const tx_metrics_entry entries[] = {
+        { .key = "pts", .value = pts },
+        { .key = "dropped", .value = timestamp },
+        { .key = "drop_stage", .value = stage },
+        { .key = "drop_reason", .value = reason },
+        { .key = "drop_total", .value = total },
+        { .key = "queue_owner_unavailable", .value = owner_reason },
+    };
+    tx_metrics_push(metrics, entries, sizeof(entries) / sizeof(entries[0]));
+    return 0;
 }
