diff --git a/src/metrics.c b/src/metrics.c
index 4c4bf6e..5ac0650 100644
--- a/src/metrics.c
+++ b/src/metrics.c
@@ -19,13 +19,226 @@
 #include "metrics.h"
 
 #include <assert.h>
+#include <errno.h>
+#include <limits.h>
+
+#include <libavutil/error.h>
+
+static uint_fast64_t atomic_saturating_add(atomic_uint_fast64_t *value,
+                                           uint_fast64_t increment)
+{
+    uint_fast64_t current = atomic_load_explicit(value, memory_order_seq_cst);
+
+    for (;;) {
+        uint_fast64_t next = UINT_FAST64_MAX - current < increment
+                           ? UINT_FAST64_MAX
+                           : current + increment;
+        if (atomic_compare_exchange_weak_explicit(value, &current, next,
+                                                  memory_order_seq_cst,
+                                                  memory_order_seq_cst))
+            return next;
+    }
+}
+
+static int64_t metrics_counter_value(uint_fast64_t value)
+{
+    return value > INT64_MAX ? INT64_MAX : (int64_t)value;
+}
+
+static void record_callback_loss(struct tx_metrics *metrics, size_t count)
+{
+    /* An empty call contains no telemetry entry to account as lost. */
+    if (count == 0)
+        return;
+
+    tx_metrics_loss_update_begin(metrics);
+    atomic_saturating_add(&metrics->callback_lost_entries, count);
+    atomic_saturating_add(&metrics->callback_lost_batches, 1);
+    tx_metrics_loss_update_end(metrics);
+}
+
+static int snapshot_callback_loss(struct tx_metrics *metrics,
+                                  uint_fast64_t *lost_batches,
+                                  uint_fast64_t *lost_entries)
+{
+    uint_fast64_t publication_before =
+        atomic_load_explicit(&metrics->callback_loss_publication,
+                             memory_order_seq_cst);
+    if (publication_before & TX_METRICS_LOSS_ACTIVE_MASK)
+        return 0;
+
+    uint_fast64_t batches =
+        atomic_load_explicit(&metrics->callback_lost_batches,
+                             memory_order_seq_cst);
+    uint_fast64_t entries =
+        atomic_load_explicit(&metrics->callback_lost_entries,
+                             memory_order_seq_cst);
+    uint_fast64_t publication_after =
+        atomic_load_explicit(&metrics->callback_loss_publication,
+                             memory_order_seq_cst);
+
+    if (publication_before != publication_after ||
+        (publication_after & TX_METRICS_LOSS_ACTIVE_MASK) ||
+        ((batches == 0) != (entries == 0)))
+        return 0;
+
+    *lost_batches = batches;
+    *lost_entries = entries;
+    return 1;
+}
 
 void tx_metrics_init(struct tx_metrics *metrics) {
     metrics->cb = NULL;
+    metrics->userdata = NULL;
+    atomic_init(&metrics->callback_loss_publication, 0);
+    atomic_init(&metrics->callback_lost_batches, 0);
+    atomic_init(&metrics->callback_lost_entries, 0);
 }
 
