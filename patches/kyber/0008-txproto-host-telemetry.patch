+#include "metrics.h"
+
+typedef struct MetricsCapture {
+    int reject;
+    int calls;
+    tx_metrics_entry entries[TX_METRICS_MAX_BATCH_ENTRIES];
+    size_t count;
+} MetricsCapture;
+
+typedef struct Producer {
+    AVBufferRef *fifo;
+    AVPacket *packet;
+    atomic_int *completed;
+    int result;
+} Producer;
+
+typedef struct ForcedLossPublisher {
+    struct tx_metrics *metrics;
+    atomic_int phase;
+} ForcedLossPublisher;
+
+typedef struct LossStressCapture {
+    atomic_uint_fast64_t rejected_batches;
+    atomic_uint_fast64_t rejected_entries;
+    atomic_uint_fast64_t observer_last_batches[2];
+    atomic_uint_fast64_t observer_last_entries[2];
+    atomic_int invalid_snapshots;
+} LossStressCapture;
+
+typedef struct LossStressWorker {
+    struct tx_metrics *metrics;
+    atomic_int *ready;
+    atomic_int *go;
+    int observer_id;
+    int iterations;
+} LossStressWorker;
+
+static int capture_metrics(const tx_metrics_entry *entries, size_t count,
+                           void *userdata)
+{
+    MetricsCapture *capture = userdata;
+    assert(count <= TX_METRICS_MAX_BATCH_ENTRIES);
+    capture->calls++;
+    capture->count = count;
+    memcpy(capture->entries, entries, count * sizeof(*entries));
+    return capture->reject;
+}
+
+static int capture_concurrent_metrics(const tx_metrics_entry *entries,
+                                      size_t count, void *userdata)
+{
+    LossStressCapture *capture = userdata;
+    int reject = 0;
+    int observer_id = -1;
+    int have_lost_batches = 0;
+    int have_lost_entries = 0;
+    uint_fast64_t lost_batches = 0;
+    uint_fast64_t lost_entries = 0;
+
+    assert(count <= TX_METRICS_MAX_BATCH_ENTRIES);
+    for (size_t i = 0; i < count; i++) {
+        if (strcmp(entries[i].key, "force_reject") == 0)
+            reject = 1;
+        else if (strcmp(entries[i].key, "observer_id") == 0)
+            observer_id = (int)entries[i].value;
+        else if (strcmp(entries[i].key,
+                        "telemetry_callback_lost_batches_total") == 0) {
+            have_lost_batches = 1;
+            lost_batches = (uint_fast64_t)entries[i].value;
+        } else if (strcmp(entries[i].key,
+                          "telemetry_callback_lost_entries_total") == 0) {
+            have_lost_entries = 1;
+            lost_entries = (uint_fast64_t)entries[i].value;
+        }
+    }
+
+    if (have_lost_batches != have_lost_entries ||
+        (have_lost_batches &&
+         (lost_batches == 0 || lost_entries == 0 ||
+          lost_entries < lost_batches)))
+        atomic_fetch_add(&capture->invalid_snapshots, 1);
+
+    if (have_lost_batches && observer_id >= 0 && observer_id < 2) {
+        uint_fast64_t previous_batches = atomic_exchange(
+            &capture->observer_last_batches[observer_id], lost_batches);
+        uint_fast64_t previous_entries = atomic_exchange(
+            &capture->observer_last_entries[observer_id], lost_entries);
+        if (lost_batches < previous_batches || lost_entries < previous_entries)
+            atomic_fetch_add(&capture->invalid_snapshots, 1);
+    }
+
+    if (reject) {
+        atomic_fetch_add(&capture->rejected_batches, 1);
+        atomic_fetch_add(&capture->rejected_entries, count);
+        return 1;
+    }
+    return 0;
+}
+
+static const tx_metrics_entry *find_metric(const MetricsCapture *capture,
+                                           const char *key)
+{
+    for (size_t i = 0; i < capture->count; i++) {
+        if (strcmp(capture->entries[i].key, key) == 0)
+            return &capture->entries[i];
+    }
+    return NULL;
+}
+
+static void sleep_ms(long milliseconds)
+{
+    struct timespec delay = {
+        .tv_sec = milliseconds / 1000,
+        .tv_nsec = (milliseconds % 1000) * 1000000,
+    };
+    nanosleep(&delay, NULL);
+}
+
+static int wait_for_completed(atomic_int *completed, int expected)
+{
+    for (int i = 0; i < 200; i++) {
+        if (atomic_load(completed) == expected)
+            return 0;
+        sleep_ms(5);
+    }
+    return -1;
+}
+
+static void *blocking_producer(void *userdata)
+{
+    Producer *producer = userdata;
+    producer->result = sp_packet_fifo_push(producer->fifo, producer->packet);
+    atomic_fetch_add(producer->completed, 1);
+    return NULL;
+}
+
+static void *forced_loss_publisher(void *userdata)
+{
+    ForcedLossPublisher *publisher = userdata;
+
+    tx_metrics_loss_update_begin(publisher->metrics);
+    atomic_store(&publisher->metrics->callback_lost_batches, 1);
+    atomic_store(&publisher->phase, 1);
+    while (atomic_load(&publisher->phase) != 2)
+        sleep_ms(1);
+    atomic_store(&publisher->metrics->callback_lost_entries, 3);
+    tx_metrics_loss_update_end(publisher->metrics);
+    atomic_store(&publisher->phase, 3);
+    return NULL;
+}
+
+static void *loss_stress_worker(void *userdata)
+{
+    LossStressWorker *worker = userdata;
+    atomic_fetch_add(worker->ready, 1);
+    while (!atomic_load(worker->go))
+        sleep_ms(1);
+
+    for (int i = 0; i < worker->iterations; i++) {
+        tx_metrics_entry entry = {
+            .key = worker->observer_id < 0 ? "force_reject" : "observer_id",
+            .value = worker->observer_id,
+        };
+        tx_metrics_push(worker->metrics, &entry, 1);
+    }
+    return NULL;
+}
+
+static AVPacket *packet_new(int64_t pts, int size)
+{
+    AVPacket *packet = av_packet_alloc();
+    assert(packet);
+    assert(av_new_packet(packet, size) == 0);
+    packet->pts = pts;
+    return packet;
+}
+
+static void test_fifo_limit_and_owner(void)
+{
+    AVBufferRef *fifo = sp_packet_fifo_create(NULL, 1, 0);
+    AVPacket *first = packet_new(1, 4);
+    AVPacket *second = packet_new(2, 4);
+    assert(fifo);
+
+    assert(sp_packet_fifo_push(fifo, first) == 0);
+    assert(sp_packet_fifo_get_size(fifo) == 1);
+    assert(sp_packet_fifo_is_full(fifo));
+    assert(sp_packet_fifo_push(fifo, second) == AVERROR(ENOBUFS));
+
+    int depth = -1;
+    int limit = -1;
+    assert(sp_packet_fifo_get_effective_bound(fifo, &depth, &limit) ==
+           PACKET_FIFO_OWNER_OK);
+    assert(depth == 1);
+    assert(limit == 1);
+
+    AVPacket *popped = sp_packet_fifo_pop(fifo);
+    assert(popped);
+    av_packet_free(&popped);
+    assert(!sp_packet_fifo_is_full(fifo));
+    assert(sp_packet_fifo_push(fifo, second) == 0);
+    popped = sp_packet_fifo_pop(fifo);
+    assert(popped);
+    av_packet_free(&popped);
+
+    AVBufferRef *source = sp_packet_fifo_create(NULL, 0, 0);
+    AVBufferRef *bounded = sp_packet_fifo_create(NULL, 2, 0);
+    AVBufferRef *other = sp_packet_fifo_create(NULL, 2, 0);
+    AVBufferRef *unlimited = sp_packet_fifo_create(NULL, -1, 0);
+    assert(source && bounded && other && unlimited);
+
+    assert(sp_packet_fifo_get_effective_bound(source, &depth, &limit) ==
+           PACKET_FIFO_OWNER_NO_DESTINATION);
+    assert(sp_packet_fifo_mirror(bounded, source) == 0);
+    assert(sp_packet_fifo_push(source, first) == 0);
+    assert(sp_packet_fifo_get_effective_bound(source, &depth, &limit) ==
+           PACKET_FIFO_OWNER_OK);
+    assert(depth == 1);
+    assert(limit == 2);
+
+    assert(sp_packet_fifo_mirror(other, source) == 0);
+    assert(sp_packet_fifo_get_effective_bound(source, &depth, &limit) ==
+           PACKET_FIFO_OWNER_AMBIGUOUS);
+    assert(sp_packet_fifo_unmirror(other, source) == 0);
+    assert(sp_packet_fifo_unmirror(bounded, source) == 0);
+    assert(sp_packet_fifo_mirror(unlimited, source) == 0);
+    assert(sp_packet_fifo_get_effective_bound(source, &depth, &limit) ==
+           PACKET_FIFO_OWNER_UNBOUNDED);
+    assert(sp_packet_fifo_unmirror(unlimited, source) == 0);
+
+    popped = sp_packet_fifo_pop(bounded);
+    assert(popped);
+    av_packet_free(&popped);
+    av_buffer_unref(&unlimited);
+    av_buffer_unref(&other);
+    av_buffer_unref(&bounded);
+    av_buffer_unref(&source);
+    av_packet_free(&second);
+    av_packet_free(&first);
+    av_buffer_unref(&fifo);
+}
+
+static void test_fifo_special_and_blocking_semantics(void)
+{
+    AVPacket *packet = packet_new(3, 4);
+    AVBufferRef *unlimited = sp_packet_fifo_create(NULL, -1, 0);
+    AVBufferRef *passthrough = sp_packet_fifo_create(NULL, 0, 0);
+    AVBufferRef *destination = sp_packet_fifo_create(NULL, 1, 0);
+    assert(unlimited && passthrough && destination);
+
+    for (int i = 0; i < 4; i++)
+        assert(sp_packet_fifo_push(unlimited, packet) == 0);
+    assert(sp_packet_fifo_get_size(unlimited) == 4);
+    assert(sp_packet_fifo_push(unlimited, NULL) == 0);
+
+    assert(sp_packet_fifo_mirror(destination, passthrough) == 0);
+    assert(sp_packet_fifo_push(passthrough, packet) == 0);
+    assert(sp_packet_fifo_get_size(passthrough) == 0);
+    assert(sp_packet_fifo_get_size(destination) == 1);
+    assert(sp_packet_fifo_push(passthrough, NULL) == 0);
+    assert(sp_packet_fifo_unmirror(destination, passthrough) == 0);
+
+    AVPacket *popped = sp_packet_fifo_pop(destination);
+    assert(popped);
+    av_packet_free(&popped);
+    popped = sp_packet_fifo_pop(destination);
+    assert(!popped);
+
+    AVBufferRef *blocking = sp_packet_fifo_create(
+        NULL, 1, PACKET_FIFO_BLOCK_MAX_OUTPUT);
+    assert(blocking);
+    assert(sp_packet_fifo_push(blocking, packet) == 0);
+
+    atomic_int completed = ATOMIC_VAR_INIT(0);
+    AVPacket *packet_a = packet_new(4, 4);
+    AVPacket *packet_b = packet_new(5, 4);
+    Producer producers[] = {
+        { .fifo = blocking, .packet = packet_a, .completed = &completed },
+        { .fifo = blocking, .packet = packet_b, .completed = &completed },
+    };
+    pthread_t threads[2];
+    assert(pthread_create(&threads[0], NULL, blocking_producer, &producers[0]) == 0);
+    assert(pthread_create(&threads[1], NULL, blocking_producer, &producers[1]) == 0);
+
+    sleep_ms(25);
+    assert(atomic_load(&completed) == 0);
+    sp_packet_fifo_set_max_queued(blocking, 1);
+    sleep_ms(25);
+    assert(atomic_load(&completed) == 0);
+    assert(sp_packet_fifo_get_size(blocking) == 1);
+
+    popped = sp_packet_fifo_pop(blocking);
+    assert(popped);
+    av_packet_free(&popped);
+    assert(wait_for_completed(&completed, 1) == 0);
+    assert(sp_packet_fifo_get_size(blocking) == 1);
+
+    popped = sp_packet_fifo_pop(blocking);
+    assert(popped);
+    av_packet_free(&popped);
+    assert(wait_for_completed(&completed, 2) == 0);
+    assert(sp_packet_fifo_get_size(blocking) == 1);
+
+    popped = sp_packet_fifo_pop(blocking);
+    assert(popped);
+    av_packet_free(&popped);
+    assert(pthread_join(threads[0], NULL) == 0);
+    assert(pthread_join(threads[1], NULL) == 0);
+    assert(producers[0].result == 0);
+    assert(producers[1].result == 0);
+
+    av_packet_free(&packet_b);
+    av_packet_free(&packet_a);
+    av_buffer_unref(&blocking);
+    av_buffer_unref(&destination);
+    av_buffer_unref(&passthrough);
+    av_buffer_unref(&unlimited);
+    av_packet_free(&packet);
+}
+
+static void test_metrics_loss_and_helpers(void)
+{
+    struct tx_metrics metrics;
+    MetricsCapture capture = { .reject = 1 };
+    tx_metrics_init(&metrics);
+    metrics.cb = capture_metrics;
+    metrics.userdata = &capture;
+
+    assert(tx_metrics_emit_payload(&metrics, 10, "encoded", 20,
+                                   "encoded_payload_bytes", 30) == 0);
+    assert(capture.calls == 1);
+    capture.reject = 0;
+    assert(tx_metrics_emit_queue(&metrics, 10,
+                                 TX_METRICS_QUEUE_STAGE_ENCODED_PACKET,
+                                 1, 2) == 0);
+    assert(capture.calls == 2);
+    assert(capture.count == 6);
+    assert(find_metric(&capture, "telemetry_callback_lost_batches_total")->value == 1);
+    assert(find_metric(&capture, "telemetry_callback_lost_entries_total")->value == 3);
+    assert(find_metric(&capture, "pts")->value == 10);
+    assert(find_metric(&capture, "queue_stage")->value ==
+           TX_METRICS_QUEUE_STAGE_ENCODED_PACKET);
+    assert(find_metric(&capture, "queue_depth")->value == 1);
+    assert(find_metric(&capture, "queue_limit")->value == 2);
+
+    assert(tx_metrics_emit_queue_unavailable(
+               &metrics, 10, TX_METRICS_QUEUE_STAGE_CAPTURE,
+               TX_METRICS_REASON_OWNER_AMBIGUOUS) == 0);
+    assert(find_metric(&capture, "queue_owner_unavailable")->value ==
+           TX_METRICS_REASON_OWNER_AMBIGUOUS);
+
+    assert(tx_metrics_emit_drop(&metrics, 11, 21,
+                                TX_METRICS_DROP_STAGE_CAPTURE,
+                                TX_METRICS_REASON_FIFO_FULL,
+                                1, 1, 4) == 0);
+    assert(find_metric(&capture, "dropped")->value == 21);
+    assert(find_metric(&capture, "drop_stage")->value ==
+           TX_METRICS_DROP_STAGE_CAPTURE);
+    assert(find_metric(&capture, "drop_reason")->value ==
+           TX_METRICS_REASON_FIFO_FULL);
+    assert(find_metric(&capture, "drop_total")->value == 4);
+
+    assert(tx_metrics_emit_drop_unavailable(
+               &metrics, 12, 22, TX_METRICS_DROP_STAGE_ENCODED_PACKET,
+               TX_METRICS_REASON_FIFO_FULL, 5,
+               TX_METRICS_REASON_OWNER_CHANGED) == 0);
+    assert(find_metric(&capture, "drop_total")->value == 5);
+    assert(find_metric(&capture, "queue_owner_unavailable")->value ==
+           TX_METRICS_REASON_OWNER_CHANGED);
+    assert(!find_metric(&capture, "queue_depth"));
+    assert(!find_metric(&capture, "queue_limit"));
+
+    int calls = capture.calls;
+    assert(tx_metrics_emit_payload(&metrics, 1, "encoded", 2,
+                                   "encoded_payload_bytes", -1) == AVERROR(EINVAL));
+    assert(tx_metrics_emit_queue(&metrics, 1, TX_METRICS_QUEUE_STAGE_CAPTURE,
+                                 -1, 1) == AVERROR(EINVAL));
+    assert(tx_metrics_emit_drop(&metrics, 1, 2,
+                                TX_METRICS_DROP_STAGE_CAPTURE,
+                                TX_METRICS_REASON_FIFO_FULL,
+                                2, 1, 1) == AVERROR(EINVAL));
+    assert(capture.calls == calls);
+
+    struct tx_metrics accepted;
+    MetricsCapture accepted_capture = { 0 };
+    tx_metrics_init(&accepted);
+    accepted.cb = capture_metrics;
+    accepted.userdata = &accepted_capture;
+    assert(tx_metrics_emit_payload(&accepted, 1, "sent", 2,
+                                   "sent_payload_bytes", 3) == 0);
+    assert(accepted_capture.count == 3);
+    assert(!find_metric(&accepted_capture,
+                        "telemetry_callback_lost_batches_total"));
+    assert(!find_metric(&accepted_capture,
+                        "telemetry_callback_lost_entries_total"));
+}
+
+static void test_metrics_forced_loss_publication(void)
+{
+    struct tx_metrics metrics;
+    MetricsCapture capture = { 0 };
+    ForcedLossPublisher publisher = {
+        .metrics = &metrics,
+        .phase = ATOMIC_VAR_INIT(0),
+    };
+    pthread_t thread;
+
+    tx_metrics_init(&metrics);
+    metrics.cb = capture_metrics;
+    metrics.userdata = &capture;
+    assert(pthread_create(&thread, NULL, forced_loss_publisher, &publisher) == 0);
+    assert(wait_for_completed(&publisher.phase, 1) == 0);
+
+    assert(tx_metrics_emit_payload(&metrics, 1, "encoded", 2,
+                                   "encoded_payload_bytes", 3) == 0);
+    assert(!find_metric(&capture,
+                        "telemetry_callback_lost_batches_total"));
+    assert(!find_metric(&capture,
+                        "telemetry_callback_lost_entries_total"));
+
+    atomic_store(&publisher.phase, 2);
+    assert(wait_for_completed(&publisher.phase, 3) == 0);
+    assert(pthread_join(thread, NULL) == 0);
+
+    assert(tx_metrics_emit_queue(&metrics, 1,
+                                 TX_METRICS_QUEUE_STAGE_CAPTURE,
+                                 1, 1) == 0);
+    assert(find_metric(&capture,
+                       "telemetry_callback_lost_batches_total")->value == 1);
+    assert(find_metric(&capture,
+                       "telemetry_callback_lost_entries_total")->value == 3);
+}
+
+static void test_metrics_concurrent_loss_publication(void)
+{
+    enum {
+        REJECTERS = 4,
+        OBSERVERS = 2,
+        ITERATIONS = 4000,
+        WORKERS = REJECTERS + OBSERVERS,
+    };
+    struct tx_metrics metrics;
+    LossStressCapture stress = { 0 };
+    LossStressWorker workers[WORKERS];
+    pthread_t threads[WORKERS];
+    atomic_int ready = ATOMIC_VAR_INIT(0);
+    atomic_int go = ATOMIC_VAR_INIT(0);
+
+    tx_metrics_init(&metrics);
+    metrics.cb = capture_concurrent_metrics;
+    metrics.userdata = &stress;
+
+    for (int i = 0; i < WORKERS; i++) {
+        workers[i] = (LossStressWorker) {
+            .metrics = &metrics,
+            .ready = &ready,
+            .go = &go,
+            .observer_id = i < REJECTERS ? -1 : i - REJECTERS,
+            .iterations = ITERATIONS,
+        };
+        assert(pthread_create(&threads[i], NULL, loss_stress_worker,
+                              &workers[i]) == 0);
+    }
+    assert(wait_for_completed(&ready, WORKERS) == 0);
+    atomic_store(&go, 1);
+    for (int i = 0; i < WORKERS; i++)
+        assert(pthread_join(threads[i], NULL) == 0);
+
+    uint_fast64_t expected_batches = atomic_load(&stress.rejected_batches);
+    uint_fast64_t expected_entries = atomic_load(&stress.rejected_entries);
+    assert(expected_batches == REJECTERS * ITERATIONS);
+    assert(expected_entries >= expected_batches);
+    assert(atomic_load(&metrics.callback_lost_batches) == expected_batches);
+    assert(atomic_load(&metrics.callback_lost_entries) == expected_entries);
+    assert(atomic_load(&metrics.callback_loss_publication) ==
+           expected_batches * TX_METRICS_LOSS_COMPLETION);
+    assert(atomic_load(&stress.invalid_snapshots) == 0);
+
+    MetricsCapture final_capture = { 0 };
+    metrics.cb = capture_metrics;
+    metrics.userdata = &final_capture;
+    tx_metrics_entry final_entry = { .key = "observer_id", .value = 0 };
+    tx_metrics_push(&metrics, &final_entry, 1);
+    assert(find_metric(&final_capture,
+                       "telemetry_callback_lost_batches_total")->value ==
+           (int64_t)expected_batches);
+    assert(find_metric(&final_capture,
+                       "telemetry_callback_lost_entries_total")->value ==
+           (int64_t)expected_entries);
+}
