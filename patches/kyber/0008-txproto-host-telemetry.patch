+int main(void)
+{
+    test_fifo_limit_and_owner();
+    test_fifo_special_and_blocking_semantics();
+    test_metrics_loss_and_helpers();
+    test_metrics_forced_loss_publication();
+    test_metrics_concurrent_loss_publication();
+    puts("host_metrics: ok");
+    return 0;
+}
