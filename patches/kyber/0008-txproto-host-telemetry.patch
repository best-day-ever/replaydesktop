@@ -30,7 +33,88 @@ typedef int (*tx_metrics_cb)(const struct tx_metrics_entry *entries,
                              size_t count,
                              void *userdata);
 
+enum tx_metrics_queue_stage {
+    TX_METRICS_QUEUE_STAGE_CAPTURE = 1,
+    TX_METRICS_QUEUE_STAGE_ENCODED_PACKET = 2,
+    TX_METRICS_QUEUE_STAGE_PACKET_SINK = 3,
+};
+
+enum tx_metrics_drop_stage {
+    TX_METRICS_DROP_STAGE_CAPTURE = 1,
+    TX_METRICS_DROP_STAGE_ENCODED_PACKET = 2,
+};
+
+enum tx_metrics_reason {
+    TX_METRICS_REASON_FIFO_FULL = 1,
+    TX_METRICS_REASON_OWNER_NO_DESTINATION = 2,
+    TX_METRICS_REASON_OWNER_AMBIGUOUS = 3,
+    TX_METRICS_REASON_OWNER_UNBOUNDED = 4,
+    TX_METRICS_REASON_OWNER_CHANGED = 5,
+};
+
 struct tx_metrics {
     tx_metrics_cb cb;
     void *userdata;
+    atomic_uint_fast64_t callback_loss_publication;
+    atomic_uint_fast64_t callback_lost_batches;
+    atomic_uint_fast64_t callback_lost_entries;
 };
+
+/*
+ * The low bits count active loss writers and the upper bits count completed
+ * loss updates. A writer increments the active count before touching either
+ * cumulative field, then advances the generation and decrements the active
+ * count with one atomic operation. A reader accepts one bounded snapshot only
+ * when this word is unchanged and has no active writer. Sixteen active bits
+ * cover the fixed producer-thread set; the remaining 48 bits defer generation
+ * wrap beyond any practical session lifetime.
+ */
+#define TX_METRICS_LOSS_ACTIVE_BITS 16
+#define TX_METRICS_LOSS_ACTIVE_MASK \
+    ((((uint_fast64_t)1) << TX_METRICS_LOSS_ACTIVE_BITS) - 1)
+#define TX_METRICS_LOSS_COMPLETION \
+    (((uint_fast64_t)1) << TX_METRICS_LOSS_ACTIVE_BITS)
+
+static inline void tx_metrics_loss_update_begin(struct tx_metrics *metrics)
+{
+    atomic_fetch_add_explicit(&metrics->callback_loss_publication, 1,
+                              memory_order_seq_cst);
+}
+
+static inline void tx_metrics_loss_update_end(struct tx_metrics *metrics)
+{
+    atomic_fetch_add_explicit(&metrics->callback_loss_publication,
+                              TX_METRICS_LOSS_COMPLETION - 1,
+                              memory_order_seq_cst);
+}
+
+int tx_metrics_emit_payload(struct tx_metrics *metrics,
+                            int64_t pts,
+                            const char *legacy_stage_key,
+                            int64_t stage_timestamp,
+                            const char *payload_key,
+                            int64_t payload_bytes);
+int tx_metrics_emit_queue(struct tx_metrics *metrics,
+                          int64_t pts,
+                          enum tx_metrics_queue_stage stage,
+                          int64_t depth,
+                          int64_t limit);
+int tx_metrics_emit_queue_unavailable(struct tx_metrics *metrics,
+                                      int64_t pts,
+                                      enum tx_metrics_queue_stage stage,
+                                      enum tx_metrics_reason reason);
+int tx_metrics_emit_drop(struct tx_metrics *metrics,
+                         int64_t pts,
+                         int64_t timestamp,
+                         enum tx_metrics_drop_stage stage,
+                         enum tx_metrics_reason reason,
+                         int64_t depth,
+                         int64_t limit,
+                         int64_t total);
+int tx_metrics_emit_drop_unavailable(struct tx_metrics *metrics,
+                                     int64_t pts,
+                                     int64_t timestamp,
+                                     enum tx_metrics_drop_stage stage,
+                                     enum tx_metrics_reason reason,
+                                     int64_t total,
+                                     enum tx_metrics_reason owner_reason);
