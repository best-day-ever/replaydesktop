+
+        assert!(forwarder.try_forward(&batch));
+        assert!(!forwarder.try_forward(&batch));
+        rx.try_recv().expect("post-recovery accepted batch");
+        assert!(forwarder.try_forward(&batch));
+        let second_recovery = rx.try_recv().expect("second recovery");
+        assert_eq!(
+            value(&second_recovery, "telemetry_forwarder_lost_batches_total"),
+            Some(2)
+        );
+        assert_eq!(
+            value(&second_recovery, "telemetry_forwarder_lost_entries_total"),
+            Some(2)
+        );
+    }
+
