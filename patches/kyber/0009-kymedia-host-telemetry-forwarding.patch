+struct MetricsResultCbData<F>
+where
+    F: Fn(&[Metrics]) -> bool + Send + Sync,
+{
+    cb: F,
+}
+
+struct MetricsCallbackRegistration {
+    data: usize,
+    drop_data: unsafe fn(usize),
+}
+
+const MAX_METRICS_BATCH_ENTRIES: usize = 32;
+const MAX_METRICS_KEY_BYTES: usize = 96;
+
+unsafe fn drop_metrics_callback_data<T>(data: usize) {
+    drop(unsafe { Box::from_raw(data as *mut T) });
+}
+
+fn metrics_key_is_valid(key: &str) -> bool {
+    !key.is_empty()
+        && key.len() <= MAX_METRICS_KEY_BYTES
+        && key
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')
+}
+
+fn metrics_value_is_valid(key: &str, value: i64) -> bool {
+    match key {
+        "queue_limit" => value > 0,
+        "queue_depth"
+        | "drop_total"
+        | "telemetry_callback_lost_batches_total"
+        | "telemetry_callback_lost_entries_total"
+        | "telemetry_forwarder_lost_batches_total"
+        | "telemetry_forwarder_lost_entries_total" => value >= 0,
+        "telemetry_forwarder_first_lost_sequence" | "telemetry_forwarder_last_lost_sequence" => {
+            value > 0
+        }
+        "queue_stage" => (1..=3).contains(&value),
+        "drop_stage" => (1..=2).contains(&value),
+        "drop_reason" => value == 1,
+        "queue_owner_unavailable" => (2..=5).contains(&value),
+        _ if key.ends_with("_payload_bytes") => value >= 0,
+        _ => true,
+    }
+}
+
+unsafe fn decode_metrics_key<'a>(key: *const libc::c_char) -> Option<&'a str> {
+    if key.is_null() {
+        return None;
+    }
+
+    for length in 0..=MAX_METRICS_KEY_BYTES {
+        if unsafe { *key.cast::<u8>().add(length) } == 0 {
+            let bytes = unsafe { std::slice::from_raw_parts(key.cast::<u8>(), length) };
+            return std::str::from_utf8(bytes).ok();
+        }
+    }
+
+    None
+}
+
+unsafe fn decode_metrics<'a>(
+    entries: *const sys::tx_metrics_entry,
+    count: usize,
+) -> Option<Vec<Metrics<'a>>> {
+    if count > MAX_METRICS_BATCH_ENTRIES || (count > 0 && entries.is_null()) {
+        return None;
+    }
+
+    let entries = if count == 0 {
+        &[]
+    } else {
+        unsafe { std::slice::from_raw_parts(entries, count) }
+    };
+    let mut metrics = Vec::with_capacity(count);
+    let mut queue_depth = None;
+    let mut queue_limit = None;
+    for entry in entries {
+        let key = unsafe { decode_metrics_key(entry.key) }?;
+        if !metrics_key_is_valid(key) || !metrics_value_is_valid(key, entry.value) {
+            return None;
+        }
+        match key {
+            "queue_depth" => {
+                if queue_depth.replace(entry.value).is_some() {
+                    return None;
+                }
+            }
+            "queue_limit" => {
+                if queue_limit.replace(entry.value).is_some() {
+                    return None;
+                }
+            }
+            _ => {}
+        }
+        metrics.push(Metrics {
+            key,
+            value: entry.value,
+        });
+    }
+    if matches!((queue_depth, queue_limit), (Some(depth), Some(limit)) if depth > limit) {
+        return None;
+    }
+    Some(metrics)
+}
+
 pub struct Txproto {
     ctx: AtomicPtr<sys::TXMainContext>,
