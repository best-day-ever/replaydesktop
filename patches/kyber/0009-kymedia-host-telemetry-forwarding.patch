+    }
+
+    #[test]
+    fn first_and_last_sequences_use_minimum_and_maximum_not_completion_order() {
+        let state = Arc::new(ForwarderState::default());
+        let start = Arc::new(Barrier::new(8));
+        let non_minimum_done = Arc::new(AtomicU64::new(0));
+        let sequences = [90, 30, 70, 10, 110, 50, 20, 80];
+        let mut writers = Vec::new();
+
+        for sequence in sequences {
+            let state = Arc::clone(&state);
+            let start = Arc::clone(&start);
+            let non_minimum_done = Arc::clone(&non_minimum_done);
+            writers.push(thread::spawn(move || {
+                start.wait();
+                if sequence == 10 {
+                    while non_minimum_done.load(Ordering::SeqCst) != 7 {
+                        hint::spin_loop();
+                    }
+                }
+                state.record_rejection(sequence, 1);
+                if sequence != 10 {
+                    non_minimum_done.fetch_add(1, Ordering::SeqCst);
+                }
+            }));
+        }
+        for writer in writers {
+            writer.join().expect("sequence writer");
+        }
+
+        assert_eq!(
+            loss_snapshot(&state),
+            LossSnapshot {
+                batches: 8,
+                entries: 8,
+                first_sequence: 10,
+                last_sequence: 110,
+            }
+        );
+    }
+
+    #[test]
+    fn concurrent_loss_snapshots_are_coherent_and_totals_exact() {
+        const WRITERS: usize = 6;
+        const OBSERVERS: usize = 2;
+        const ITERATIONS: usize = 2000;
+
+        let state = Arc::new(ForwarderState::default());
+        let start = Arc::new(Barrier::new(WRITERS + OBSERVERS));
+        let invalid_snapshots = Arc::new(AtomicU64::new(0));
+        let writers_done = Arc::new(AtomicBool::new(false));
+        let mut writers = Vec::new();
+        let mut observers = Vec::new();
+
+        for writer_id in 0..WRITERS {
+            let state = Arc::clone(&state);
+            let start = Arc::clone(&start);
+            writers.push(thread::spawn(move || {
+                start.wait();
+                for _ in 0..ITERATIONS {
+                    let sequence = state.next_sequence();
+                    state.record_rejection(sequence, writer_id + 1);
+                }
+            }));
+        }
+        for _ in 0..OBSERVERS {
+            let state = Arc::clone(&state);
+            let start = Arc::clone(&start);
+            let invalid_snapshots = Arc::clone(&invalid_snapshots);
+            let writers_done = Arc::clone(&writers_done);
+            observers.push(thread::spawn(move || {
+                start.wait();
+                while !writers_done.load(Ordering::SeqCst) {
+                    if let Some(snapshot) = state.snapshot() {
+                        let loss = snapshot.loss;
+                        if (loss.batches == 0) != (loss.entries == 0)
+                            || (loss.batches != 0
+                                && (loss.first_sequence == 0
+                                    || loss.first_sequence > loss.last_sequence))
+                        {
+                            invalid_snapshots.fetch_add(1, Ordering::SeqCst);
+                        }
+                    }
+                    hint::spin_loop();
+                }
+            }));
+        }
+        for writer in writers {
+            writer.join().expect("loss writer");
+        }
+        writers_done.store(true, Ordering::SeqCst);
+        for observer in observers {
+            observer.join().expect("loss observer");
+        }
+
+        let expected_batches = (WRITERS * ITERATIONS) as u64;
+        let expected_entries = (ITERATIONS * (1..=WRITERS).sum::<usize>()) as u64;
+        let published = state.snapshot().expect("final coherent snapshot");
+        assert_eq!(invalid_snapshots.load(Ordering::SeqCst), 0);
+        assert_eq!(
+            published.publication,
+            expected_batches * ForwarderState::LOSS_COMPLETION
+        );
+        assert_eq!(
+            published.loss,
+            LossSnapshot {
+                batches: expected_batches,
+                entries: expected_entries,
+                first_sequence: 1,
+                last_sequence: expected_batches,
+            }
+        );
+    }
+
