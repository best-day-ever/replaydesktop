+        let rejected_cb = Arc::clone(&rejected);
+        let data = Arc::new(MetricsResultCbData {
+            cb: move |metrics: &[Metrics]| {
+                if metrics[0].value % 2 == 0 {
+                    accepted_cb.fetch_add(1, Ordering::Relaxed);
+                    true
+                } else {
+                    rejected_cb.fetch_add(1, Ordering::Relaxed);
+                    false
+                }
+            },
+        });
+
+        thread::scope(|scope| {
+            for value in 0..64 {
+                let data = Arc::clone(&data);
+                scope.spawn(move || {
+                    let entries = [sys::tx_metrics_entry {
+                        key: c"pts".as_ptr(),
+                        value,
+                    }];
+                    let expected = if value % 2 == 0 { 0 } else { 1 };
+                    assert_eq!(unsafe { invoke_result(&data, &entries) }, expected);
+                });
+            }
+        });
+
+        assert_eq!(accepted.load(Ordering::Relaxed), 32);
+        assert_eq!(rejected.load(Ordering::Relaxed), 32);
     }
 }
