+    #[test]
+    fn full_channel_tracks_consecutive_loss_and_piggybacks_recovery() {
+        let (tx, mut rx) = mpsc::channel(1);
+        let forwarder = MetricsForwarder::new(tx);
+        let batch = [source("pts", 1), source("encoded", 2)];
+
+        assert!(forwarder.try_forward(&batch));
+        assert!(!forwarder.try_forward(&batch));
+        assert!(!forwarder.try_forward(&batch));
+        assert_eq!(
+            loss_snapshot(&forwarder.state),
+            LossSnapshot {
+                batches: 2,
+                entries: 4,
+                first_sequence: 2,
+                last_sequence: 3,
+            }
+        );
+
+        rx.try_recv().expect("initial batch");
+        assert!(forwarder.try_forward(&batch));
+        let recovered = rx.try_recv().expect("recovery batch");
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_lost_batches_total"),
+            Some(2)
+        );
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_lost_entries_total"),
+            Some(4)
+        );
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_first_lost_sequence"),
+            Some(2)
+        );
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_last_lost_sequence"),
+            Some(3)
+        );
+        assert!(forwarder.state.unflushed_loss().is_none());
+    }
+
+    #[test]
+    fn in_progress_loss_is_omitted_until_the_tuple_is_coherent() {
+        let (tx, mut rx) = mpsc::channel(2);
+        let forwarder = MetricsForwarder::new(tx);
+        let entered = Arc::new(Barrier::new(2));
+        let release = Arc::new(Barrier::new(2));
+        let state = Arc::clone(&forwarder.state);
+        let writer = {
+            let entered = Arc::clone(&entered);
+            let release = Arc::clone(&release);
+            thread::spawn(move || {
+                state.record_rejection_with(17, 3, || {
+                    entered.wait();
+                    release.wait();
+                });
+            })
+        };
+
+        entered.wait();
+        assert!(forwarder.state.snapshot().is_none());
+        assert!(forwarder.try_forward(&[source("pts", 1)]));
+        let while_in_progress = rx.try_recv().expect("in-progress batch");
+        assert_eq!(
+            value(&while_in_progress, "telemetry_forwarder_lost_batches_total"),
+            None
+        );
+        assert_eq!(
+            value(&while_in_progress, "telemetry_forwarder_lost_entries_total"),
+            None
+        );
+
+        release.wait();
+        writer.join().expect("loss publisher");
+        assert!(forwarder.try_forward(&[source("pts", 2)]));
+        let recovered = rx.try_recv().expect("coherent recovery batch");
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_lost_batches_total"),
+            Some(1)
+        );
+        assert_eq!(
+            value(&recovered, "telemetry_forwarder_lost_entries_total"),
+            Some(3)
