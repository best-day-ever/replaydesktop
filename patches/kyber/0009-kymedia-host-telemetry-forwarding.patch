+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+struct LossSnapshot {
+    batches: u64,
+    entries: u64,
+    first_sequence: u64,
+    last_sequence: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct PublishedLoss {
+    publication: u64,
+    loss: LossSnapshot,
+}
+
+struct ForwarderState {
+    next_sequence: AtomicU64,
+    loss_publication: AtomicU64,
+    rejected_batches: AtomicU64,
+    rejected_entries: AtomicU64,
+    first_rejected_sequence: AtomicU64,
+    last_rejected_sequence: AtomicU64,
+    reported_publication: AtomicU64,
+}
+
+impl Default for ForwarderState {
+    fn default() -> Self {
+        Self {
+            next_sequence: AtomicU64::new(0),
+            loss_publication: AtomicU64::new(0),
+            rejected_batches: AtomicU64::new(0),
+            rejected_entries: AtomicU64::new(0),
+            first_rejected_sequence: AtomicU64::new(u64::MAX),
+            last_rejected_sequence: AtomicU64::new(0),
+            reported_publication: AtomicU64::new(0),
+        }
+    }
+}
+
+impl ForwarderState {
+    // The low bits count active writers; the upper bits count completed loss
+    // updates. Writers never wait for each other. A reader makes one bounded
+    // attempt and accepts the tuple only when this word is unchanged with no
+    // active writer, so separately stored fields cannot escape partially.
+    // Sixteen active bits cover the fixed producer-thread set, while the
+    // 48-bit generation cannot wrap during a practical session.
+    const LOSS_ACTIVE_BITS: u32 = 16;
+    const LOSS_ACTIVE_MASK: u64 = (1 << Self::LOSS_ACTIVE_BITS) - 1;
+    const LOSS_COMPLETION: u64 = 1 << Self::LOSS_ACTIVE_BITS;
+
+    fn saturating_add(counter: &AtomicU64, increment: u64) -> u64 {
+        let previous = counter
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |value| {
+                Some(value.saturating_add(increment))
+            })
+            .expect("saturating update always succeeds");
+        previous.saturating_add(increment)
+    }
+
+    fn next_sequence(&self) -> u64 {
+        Self::saturating_add(&self.next_sequence, 1)
+    }
+
+    fn record_rejection(&self, sequence: u64, entries: usize) {
+        self.record_rejection_with(sequence, entries, || {});
+    }
+
+    fn record_rejection_with<F>(&self, sequence: u64, entries: usize, after_batches: F)
+    where
+        F: FnOnce(),
+    {
+        // txproto-rs rejects an empty native batch before this callback.
+        if entries == 0 {
+            return;
+        }
+
+        self.loss_publication.fetch_add(1, Ordering::SeqCst);
+        Self::saturating_add(&self.rejected_batches, 1);
+        after_batches();
+        Self::saturating_add(&self.rejected_entries, entries as u64);
+        self.first_rejected_sequence
+            .fetch_min(sequence, Ordering::SeqCst);
+        self.last_rejected_sequence
+            .fetch_max(sequence, Ordering::SeqCst);
+        self.loss_publication
+            .fetch_add(Self::LOSS_COMPLETION - 1, Ordering::SeqCst);
+    }
+
+    fn snapshot(&self) -> Option<PublishedLoss> {
+        let publication_before = self.loss_publication.load(Ordering::SeqCst);
+        if publication_before & Self::LOSS_ACTIVE_MASK != 0 {
+            return None;
+        }
+
+        let batches = self.rejected_batches.load(Ordering::SeqCst);
+        let entries = self.rejected_entries.load(Ordering::SeqCst);
+        let first_sequence = self.first_rejected_sequence.load(Ordering::SeqCst);
+        let last_sequence = self.last_rejected_sequence.load(Ordering::SeqCst);
+        let publication_after = self.loss_publication.load(Ordering::SeqCst);
+
+        if publication_before != publication_after
+            || publication_after & Self::LOSS_ACTIVE_MASK != 0
+            || (batches == 0) != (entries == 0)
+            || (batches != 0
+                && (first_sequence == u64::MAX
+                    || last_sequence == 0
+                    || first_sequence > last_sequence))
+        {
+            return None;
+        }
+
+        Some(PublishedLoss {
+            publication: publication_after,
+            loss: if batches == 0 {
+                LossSnapshot::default()
+            } else {
+                LossSnapshot {
+                    batches,
+                    entries,
+                    first_sequence,
+                    last_sequence,
+                }
+            },
+        })
+    }
+
+    fn mark_reported(&self, publication: u64) {
+        self.reported_publication
+            .fetch_max(publication, Ordering::SeqCst);
+    }
+
+    fn unflushed_loss(&self) -> Option<LossSnapshot> {
+        let snapshot = self.snapshot()?;
+        if snapshot.loss.batches != 0
+            && snapshot.publication > self.reported_publication.load(Ordering::SeqCst)
+        {
+            Some(snapshot.loss)
+        } else {
+            None
+        }
+    }
+}
+
+impl Drop for ForwarderState {
+    fn drop(&mut self) {
+        if let Some(loss) = self.unflushed_loss() {
+            warn!(
+                "Metrics forwarding ended with unflushed loss: \
+                 batches={}, entries={}, first_sequence={}, last_sequence={}",
+                loss.batches, loss.entries, loss.first_sequence, loss.last_sequence
+            );
+        }
+    }
+}
+
+struct MetricsForwarder {
+    tx: mpsc::Sender<Vec<Metrics>>,
+    state: Arc<ForwarderState>,
+}
+
+impl MetricsForwarder {
+    fn new(tx: mpsc::Sender<Vec<Metrics>>) -> Self {
+        Self {
+            tx,
+            state: Arc::new(ForwarderState::default()),
+        }
+    }
+
+    fn metric_value(value: u64) -> i64 {
+        i64::try_from(value).unwrap_or(i64::MAX)
+    }
+
+    fn push_loss_metrics(metrics: &mut Vec<Metrics>, loss: LossSnapshot) {
+        if loss.batches == 0 {
+            return;
+        }
+        metrics.extend([
+            Metrics {
+                key: "telemetry_forwarder_lost_batches_total".into(),
+                value: Self::metric_value(loss.batches),
+            },
+            Metrics {
+                key: "telemetry_forwarder_lost_entries_total".into(),
+                value: Self::metric_value(loss.entries),
+            },
+            Metrics {
+                key: "telemetry_forwarder_first_lost_sequence".into(),
+                value: Self::metric_value(loss.first_sequence),
+            },
+            Metrics {
+                key: "telemetry_forwarder_last_lost_sequence".into(),
+                value: Self::metric_value(loss.last_sequence),
+            },
+        ]);
+    }
+
+    fn try_forward(&self, source: &[txproto_rs::Metrics<'_>]) -> bool {
+        let sequence = self.state.next_sequence();
+        let loss = self.state.snapshot();
+        let mut metrics = Vec::with_capacity(source.len() + usize::from(loss.is_some()) * 4);
+        metrics.extend(source.iter().map(|metric| Metrics {
+            key: metric.key.into(),
+            value: metric.value,
+        }));
+        if let Some(loss) = loss {
+            Self::push_loss_metrics(&mut metrics, loss.loss);
+        }
+
+        if self.tx.try_send(metrics).is_ok() {
+            if let Some(loss) = loss {
+                self.state.mark_reported(loss.publication);
+            }
+            true
+        } else {
+            self.state.record_rejection(sequence, source.len());
+            false
+        }
+    }
+}
