+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::Arc;
+    use std::thread;
+
+    unsafe fn invoke_result<Cb>(
+        data: &MetricsResultCbData<Cb>,
+        entries: &[sys::tx_metrics_entry],
+    ) -> libc::c_int
+    where
+        Cb: Fn(&[Metrics]) -> bool + Send + Sync,
+    {
+        unsafe { invoke_result_raw(data, entries.as_ptr(), entries.len()) }
+    }
+
+    unsafe fn invoke_result_raw<Cb>(
+        data: &MetricsResultCbData<Cb>,
+        entries: *const sys::tx_metrics_entry,
+        count: usize,
+    ) -> libc::c_int
+    where
+        Cb: Fn(&[Metrics]) -> bool + Send + Sync,
+    {
+        unsafe {
+            Txproto::metrics_result_cb::<Cb>(entries, count, data as *const _ as *mut libc::c_void)
+        }
+    }
+
+    #[test]
+    fn result_callback_propagates_acceptance_and_rejection() {
+        let data = MetricsResultCbData {
+            cb: |metrics: &[Metrics]| metrics[0].value == 7,
+        };
+        let accepted = [sys::tx_metrics_entry {
+            key: c"pts".as_ptr(),
+            value: 7,
+        }];
+        let rejected = [sys::tx_metrics_entry {
+            key: c"pts".as_ptr(),
+            value: 8,
+        }];
+
+        assert_eq!(unsafe { invoke_result(&data, &accepted) }, 0);
+        assert_eq!(unsafe { invoke_result(&data, &rejected) }, 1);
+    }
+
+    #[test]
+    fn result_callback_rejects_invalid_batches_without_invoking_user_code() {
+        let calls = AtomicUsize::new(0);
+        let data = MetricsResultCbData {
+            cb: |_: &[Metrics]| {
+                calls.fetch_add(1, Ordering::Relaxed);
+                true
+            },
+        };
+
+        assert_eq!(
+            unsafe {
+                Txproto::metrics_result_cb::<fn(&[Metrics]) -> bool>(
+                    ptr::null(),
+                    0,
+                    ptr::null_mut(),
+                )
+            },
+            1
+        );
+        assert_eq!(unsafe { invoke_result_raw(&data, ptr::null(), 1) }, 1);
+        let null_key = [sys::tx_metrics_entry {
+            key: ptr::null(),
+            value: 1,
+        }];
+        assert_eq!(unsafe { invoke_result(&data, &null_key) }, 1);
+
+        let invalid_utf8 = [0xff_u8, 0];
+        let invalid_key = [sys::tx_metrics_entry {
+            key: invalid_utf8.as_ptr().cast(),
+            value: 1,
+        }];
+        assert_eq!(unsafe { invoke_result(&data, &invalid_key) }, 1);
+
+        let negative_payload = [sys::tx_metrics_entry {
+            key: c"encoded_payload_bytes".as_ptr(),
+            value: -1,
+        }];
+        assert_eq!(unsafe { invoke_result(&data, &negative_payload) }, 1);
+
+        let impossible_queue = [
+            sys::tx_metrics_entry {
+                key: c"queue_depth".as_ptr(),
+                value: 2,
+            },
+            sys::tx_metrics_entry {
+                key: c"queue_limit".as_ptr(),
+                value: 1,
+            },
+        ];
+        assert_eq!(unsafe { invoke_result(&data, &impossible_queue) }, 1);
+
+        let invalid_stage = [sys::tx_metrics_entry {
+            key: c"queue_stage".as_ptr(),
+            value: 4,
+        }];
+        assert_eq!(unsafe { invoke_result(&data, &invalid_stage) }, 1);
+
+        let mut oversized_key = [b'a'; MAX_METRICS_KEY_BYTES + 2];
+        oversized_key[MAX_METRICS_KEY_BYTES + 1] = 0;
+        let oversized_key_entry = [sys::tx_metrics_entry {
+            key: oversized_key.as_ptr().cast(),
+            value: 1,
+        }];
+        assert_eq!(unsafe { invoke_result(&data, &oversized_key_entry) }, 1);
+
+        let oversized: Vec<_> = (0..=MAX_METRICS_BATCH_ENTRIES)
+            .map(|value| sys::tx_metrics_entry {
+                key: c"pts".as_ptr(),
+                value: value as i64,
+            })
+            .collect();
+        assert_eq!(unsafe { invoke_result(&data, &oversized) }, 1);
+        assert_eq!(calls.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn result_callback_is_safe_under_concurrent_invocation() {
+        let accepted = Arc::new(AtomicUsize::new(0));
+        let rejected = Arc::new(AtomicUsize::new(0));
+        let accepted_cb = Arc::clone(&accepted);
+        let rejected_cb = Arc::clone(&rejected);
+        let data = Arc::new(MetricsResultCbData {
+            cb: move |metrics: &[Metrics]| {
+                if metrics[0].value % 2 == 0 {
+                    accepted_cb.fetch_add(1, Ordering::Relaxed);
+                    true
+                } else {
+                    rejected_cb.fetch_add(1, Ordering::Relaxed);
+                    false
+                }
+            },
+        });
+
+        thread::scope(|scope| {
+            for value in 0..64 {
+                let data = Arc::clone(&data);
+                scope.spawn(move || {
+                    let entries = [sys::tx_metrics_entry {
+                        key: c"pts".as_ptr(),
+                        value,
+                    }];
+                    let expected = if value % 2 == 0 { 0 } else { 1 };
+                    assert_eq!(unsafe { invoke_result(&data, &entries) }, expected);
+                });
+            }
+        });
+
+        assert_eq!(accepted.load(Ordering::Relaxed), 32);
+        assert_eq!(rejected.load(Ordering::Relaxed), 32);
     }
 }
