+/*****************************************************************************
+ * video_path_metrics.c: additive native video-path telemetry tests
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <assert.h>
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <vlc/vlc.h>
+#include <vlc_threads.h>
+
