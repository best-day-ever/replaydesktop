+
+struct callback_capture {
+    atomic_uint_fast64_t calls;
+    atomic_bool reject;
+    atomic_bool delay_first;
+    vlc_sem_t first_entered;
+    vlc_sem_t release_first;
+    struct libvlc_video_path_event last;
+};
+
+static int
+video_path_callback(void *opaque,
+                    const struct libvlc_video_path_event *events,
+                    size_t count)
+{
+    struct callback_capture *capture = opaque;
+    assert(events != NULL);
+    assert(count == 1);
+    atomic_fetch_add_explicit(&capture->calls, 1, memory_order_relaxed);
+
+    if (atomic_load_explicit(&capture->delay_first, memory_order_acquire) &&
+        events[0].producer_seq == 1)
+    {
+        vlc_sem_post(&capture->first_entered);
+        vlc_sem_wait(&capture->release_first);
+    }
+
+    if (atomic_load_explicit(&capture->reject, memory_order_acquire))
+        return -1;
+
+    capture->last = events[0];
+    return 0;
+}
+
+struct scalar_capture {
+    unsigned calls;
+    int64_t value;
+};
+
+static int
+scalar_callback(void *opaque, const struct libvlc_metrics_entry *entries,
+                size_t count)
+{
+    struct scalar_capture *capture = opaque;
+    assert(count == 1);
+    assert(strcmp(entries[0].key, "legacy-key") == 0);
+    capture->calls++;
+    capture->value = entries[0].value;
+    return 0;
+}
+
+static void
+init_capture(struct callback_capture *capture)
+{
+    memset(capture, 0, sizeof(*capture));
+    atomic_init(&capture->calls, 0);
+    atomic_init(&capture->reject, false);
+    atomic_init(&capture->delay_first, false);
+    vlc_sem_init(&capture->first_entered, 0);
+    vlc_sem_init(&capture->release_first, 0);
+}
+
+static void
+test_abi_and_validation(void)
+{
+    _Static_assert(LIBVLC_VIDEO_PATH_EVENT_VERSION == 1,
+                   "unexpected video path ABI version");
+    _Static_assert(sizeof(struct libvlc_video_path_event) <= UINT16_MAX,
+                   "video path record no longer fits struct_size");
+    _Static_assert(offsetof(struct libvlc_video_path_event, text) <
+                       sizeof(struct libvlc_video_path_event),
+                   "bounded text must be part of the v1 record");
+
+    struct callback_capture capture;
+    init_capture(&capture);
+    struct vlc_metrics *metrics = vlc_metrics_New();
+    assert(metrics != NULL);
+    assert(vlc_metrics_AttachVideoPath(
+               metrics, video_path_callback, &capture) == VLC_SUCCESS);
+    assert(vlc_metrics_AttachVideoPath(
+               metrics, video_path_callback, &capture) != VLC_SUCCESS);
+
+    vlc_video_path_event event;
+    vlc_video_path_event_Init(
+        &event, LIBVLC_VIDEO_PATH_EVENT_DECODER_MODULE, false, 123);
+    assert(event.version == LIBVLC_VIDEO_PATH_EVENT_VERSION);
+    assert(event.struct_size == sizeof(event));
+    assert(!event.pts_valid);
+    assert(event.pts == 0);
+
+    char long_name[LIBVLC_VIDEO_PATH_TEXT_CAPACITY * 2];
+    memset(long_name, 'x', sizeof(long_name));
+    long_name[sizeof(long_name) - 1] = '\0';
+    vlc_video_path_event_SetText(&event, long_name);
+    assert(event.text[LIBVLC_VIDEO_PATH_TEXT_CAPACITY - 1] == '\0');
+    assert(strlen(event.text) == LIBVLC_VIDEO_PATH_TEXT_CAPACITY - 1);
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_SUCCESS);
+    assert(capture.last.producer_seq == 1);
+    assert(capture.last.monotonic_ts > 0);
+
+    uint_fast64_t calls =
+        atomic_load_explicit(&capture.calls, memory_order_relaxed);
+    event.version++;
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_EINVAL);
+    event.version = LIBVLC_VIDEO_PATH_EVENT_VERSION;
+    event.struct_size--;
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_EINVAL);
+    event.struct_size = sizeof(event);
+    memset(event.text, 'y', sizeof(event.text));
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_EINVAL);
+    assert(atomic_load_explicit(&capture.calls, memory_order_relaxed) == calls);
+
+    vlc_metrics_Delete(metrics);
+}
+
+static void
+test_legacy_and_additive_installation(void)
+{
+    libvlc_instance_t *instance = libvlc_new(0, NULL);
+    assert(instance != NULL);
+    libvlc_media_player_t *player = libvlc_media_player_new(instance);
+    assert(player != NULL);
+
+    struct scalar_capture scalar = {0};
+    struct callback_capture video;
+    init_capture(&video);
+    assert(libvlc_media_player_set_metrics_callback(
+               player, scalar_callback, &scalar) == VLC_SUCCESS);
+    assert(libvlc_media_player_set_video_path_callback(
+               player, video_path_callback, &video) == VLC_SUCCESS);
+    assert(libvlc_media_player_set_metrics_callback(
+               player, scalar_callback, &scalar) != VLC_SUCCESS);
+    assert(libvlc_media_player_set_video_path_callback(
+               player, video_path_callback, &video) != VLC_SUCCESS);
+
+    libvlc_media_player_release(player);
+    libvlc_release(instance);
+
+    struct vlc_metrics *metrics = vlc_metrics_New();
+    assert(metrics != NULL);
+    assert(vlc_metrics_AttachScalar(
+               metrics, scalar_callback, &scalar) == VLC_SUCCESS);
+    const vlc_metrics_entry entry = {
+        .key = "legacy-key",
+        .value = INT64_C(987654321),
+    };
+    assert(vlc_metrics_Push(metrics, &entry, 1) == VLC_SUCCESS);
+    assert(scalar.calls == 1);
+    assert(scalar.value == entry.value);
+    vlc_metrics_Delete(metrics);
+}
+
+static void
+test_forced_in_progress_snapshot(void)
+{
+    struct vlc_metrics *metrics = vlc_metrics_New();
+    assert(metrics != NULL);
+
+    vlc_metrics_video_path_loss_update_begin(metrics);
+    atomic_store_explicit(&metrics->callback_lost_events, 1,
+                          memory_order_seq_cst);
+
+    struct vlc_video_path_loss_snapshot snapshot;
+    assert(!vlc_metrics_video_path_loss_snapshot(metrics, &snapshot));
+
+    atomic_store_explicit(&metrics->callback_loss_first_seq, 7,
+                          memory_order_seq_cst);
+    atomic_store_explicit(&metrics->callback_loss_last_seq, 7,
+                          memory_order_seq_cst);
+    vlc_metrics_video_path_loss_update_end(metrics);
+
+    assert(vlc_metrics_video_path_loss_snapshot(metrics, &snapshot));
+    assert(snapshot.events == 1);
+    assert(snapshot.first_seq == 7);
+    assert(snapshot.last_seq == 7);
+    assert(snapshot.generation == 1);
+    vlc_metrics_Delete(metrics);
+}
+
+struct emit_args {
+    struct vlc_metrics *metrics;
+    unsigned count;
+};
+
+static void *
+emit_events(void *opaque)
+{
+    const struct emit_args *args = opaque;
+    for (unsigned i = 0; i < args->count; ++i)
+    {
+        vlc_video_path_event event;
+        vlc_video_path_event_Init(
+            &event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME, true, i);
+        (void) vlc_metrics_PushVideoPath(args->metrics, &event);
+    }
+    return NULL;
+}
+
+static void
+test_delayed_minmax_writer_ordering(void)
+{
+    struct callback_capture capture;
+    init_capture(&capture);
+    atomic_store_explicit(&capture.reject, true, memory_order_release);
+    atomic_store_explicit(&capture.delay_first, true, memory_order_release);
+
+    struct vlc_metrics *metrics = vlc_metrics_New();
+    assert(metrics != NULL);
+    assert(vlc_metrics_AttachVideoPath(
+               metrics, video_path_callback, &capture) == VLC_SUCCESS);
+
+    const struct emit_args args = {.metrics = metrics, .count = 1};
+    vlc_thread_t first;
+    vlc_thread_t second;
+    assert(vlc_clone(&first, emit_events, (void *) &args) == 0);
+    vlc_sem_wait(&capture.first_entered);
+    assert(vlc_clone(&second, emit_events, (void *) &args) == 0);
+    vlc_join(second, NULL);
+    vlc_sem_post(&capture.release_first);
+    vlc_join(first, NULL);
+
+    atomic_store_explicit(&capture.delay_first, false, memory_order_release);
+    atomic_store_explicit(&capture.reject, false, memory_order_release);
+    vlc_video_path_event event;
+    vlc_video_path_event_Init(
+        &event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME, false, 0);
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_SUCCESS);
+    assert(capture.last.callback_lost_events == 2);
+    assert(capture.last.callback_loss_first_seq == 1);
+    assert(capture.last.callback_loss_last_seq == 2);
+    vlc_metrics_Delete(metrics);
+}
+
+static void
+test_concurrent_exact_loss_totals(void)
+{
+    enum { THREAD_COUNT = 4, EVENTS_PER_THREAD = 500 };
+
+    struct callback_capture capture;
+    init_capture(&capture);
+    atomic_store_explicit(&capture.reject, true, memory_order_release);
+
+    struct vlc_metrics *metrics = vlc_metrics_New();
+    assert(metrics != NULL);
+    assert(vlc_metrics_AttachVideoPath(
+               metrics, video_path_callback, &capture) == VLC_SUCCESS);
+
+    const struct emit_args args = {
+        .metrics = metrics,
+        .count = EVENTS_PER_THREAD,
+    };
+    vlc_thread_t threads[THREAD_COUNT];
+    for (unsigned i = 0; i < THREAD_COUNT; ++i)
+        assert(vlc_clone(&threads[i], emit_events, (void *) &args) == 0);
+    for (unsigned i = 0; i < THREAD_COUNT; ++i)
+        vlc_join(threads[i], NULL);
+
+    atomic_store_explicit(&capture.reject, false, memory_order_release);
+    vlc_video_path_event event;
+    vlc_video_path_event_Init(
+        &event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME, false, 0);
+    assert(vlc_metrics_PushVideoPath(metrics, &event) == VLC_SUCCESS);
+
+    uint64_t expected = THREAD_COUNT * EVENTS_PER_THREAD;
+    assert(capture.last.callback_lost_events == expected);
+    assert(capture.last.callback_loss_first_seq == 1);
+    assert(capture.last.callback_loss_last_seq == expected);
+    assert(capture.last.callback_loss_generation == expected);
+    assert(capture.last.producer_seq == expected + 1);
+    vlc_metrics_Delete(metrics);
+}
+
+static void
+test_config_parsers(void)
+{
+    static const uint8_t h264[] = {
+        0x00, 0x00, 0x00, 0x01, 0x67, 0xf4, 0x00, 0x0a,
+        0x91, 0x9b, 0x2b, 0xd0, 0x80, 0x00, 0x00, 0x03,
+        0x00, 0x80, 0x00, 0x00, 0x19, 0x07, 0x89, 0x12,
+        0xcb,
+    };
+    static const uint8_t hevc[] = {
+        0x00, 0x00, 0x00, 0x01, 0x40, 0x01, 0x0c, 0x01,
+        0xff, 0xff, 0x04, 0x08, 0x00, 0x00, 0x03, 0x00,
+        0x9e, 0x08, 0x00, 0x00, 0x03, 0x00, 0x00, 0x1e,
+        0x95, 0x98, 0x09, 0x00, 0x00, 0x01, 0x42, 0x01,
+        0x01, 0x04, 0x08, 0x00, 0x00, 0x03, 0x00, 0x9e,
+        0x08, 0x00, 0x00, 0x03, 0x00, 0x00, 0x1e, 0x90,
+        0x11, 0x08, 0xb2, 0xca, 0xcd, 0x57, 0x95, 0xcd,
+        0x40, 0x80, 0x80, 0x01, 0x00, 0x00, 0x03, 0x00,
+        0x01, 0x00, 0x00, 0x03, 0x00, 0x19, 0x08,
+    };
+    static const uint8_t av1[] = {
+        0x12, 0x00, 0x0a, 0x06, 0x18, 0x0c, 0xff, 0xda,
+        0x00, 0x80, 0x32, 0x0c, 0x18, 0x00, 0x00, 0x00,
+        0x50, 0x00, 0x00, 0x00, 0xa9, 0x8e, 0x58, 0xd4,
+    };
+    static const uint8_t malformed[] = {0x00, 0x01, 0x02};
+
+    struct kymux_video_config config;
+    assert(kymux_video_config_Inspect(
+        KYMUX_CODEC_H264, h264, sizeof(h264), &config));
+    assert(config.codec == LIBVLC_VIDEO_PATH_CODEC_H264);
+    assert(config.profile == 244);
+    assert(config.chroma == LIBVLC_VIDEO_PATH_CHROMA_444);
+    assert(config.bit_depth == 8);
+    assert(config.unknown_reason == LIBVLC_VIDEO_PATH_UNKNOWN_NONE);
+
+    assert(kymux_video_config_Inspect(
+        KYMUX_CODEC_H265, hevc, sizeof(hevc), &config));
+    assert(config.codec == LIBVLC_VIDEO_PATH_CODEC_HEVC);
+    assert(config.profile == 4);
+    assert(config.chroma == LIBVLC_VIDEO_PATH_CHROMA_444);
+    assert(config.bit_depth == 8);
+
+    assert(kymux_video_config_Inspect(
+        KYMUX_CODEC_AV1, av1, sizeof(av1), &config));
+    assert(config.codec == LIBVLC_VIDEO_PATH_CODEC_AV1);
+    assert(config.profile == 0);
+    assert(config.chroma == LIBVLC_VIDEO_PATH_CHROMA_420);
+    assert(config.bit_depth == 8);
+
+    assert(!kymux_video_config_Inspect(
+        KYMUX_CODEC_H264, malformed, sizeof(malformed), &config));
+    assert(config.codec == LIBVLC_VIDEO_PATH_CODEC_H264);
+    assert(config.chroma == LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN);
+    assert(config.unknown_reason ==
+           LIBVLC_VIDEO_PATH_UNKNOWN_BITSTREAM_CONFIG_UNPARSEABLE);
+
+    assert(!kymux_video_config_Inspect(
+        UINT32_C(0xdeadbeef), malformed, sizeof(malformed), &config));
+    assert(config.codec == LIBVLC_VIDEO_PATH_CODEC_UNKNOWN);
+    assert(config.unknown_reason ==
+           LIBVLC_VIDEO_PATH_UNKNOWN_CODEC_UNSUPPORTED);
+}
+
+int
+main(void)
+{
+    test_abi_and_validation();
+    test_legacy_and_additive_installation();
+    test_forced_in_progress_snapshot();
+    test_delayed_minmax_writer_ordering();
+    test_concurrent_exact_loss_totals();
+    test_config_parsers();
+    return 0;
+}
