@@ -13,4 +13,126 @@ typedef int (*libvlc_metrics_cb)(void *sys,
                                  const struct libvlc_metrics_entry *entries,
                                  size_t count);
 
+#define LIBVLC_VIDEO_PATH_EVENT_VERSION UINT16_C(1)
+#define LIBVLC_VIDEO_PATH_TEXT_CAPACITY 64
+
+enum libvlc_video_path_event_kind {
+    LIBVLC_VIDEO_PATH_EVENT_BITSTREAM_CONFIG = 1,
+    LIBVLC_VIDEO_PATH_EVENT_DECODER_MODULE = 2,
+    LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_SESSION = 3,
+    LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME = 4,
+    LIBVLC_VIDEO_PATH_EVENT_DECODED_SURFACE = 5,
+    LIBVLC_VIDEO_PATH_EVENT_RENDERER = 6,
+    LIBVLC_VIDEO_PATH_EVENT_OBSERVATION_LIMIT = 7,
+};
+
+enum libvlc_video_path_codec {
+    LIBVLC_VIDEO_PATH_CODEC_UNKNOWN = 0,
+    LIBVLC_VIDEO_PATH_CODEC_H264 = 1,
+    LIBVLC_VIDEO_PATH_CODEC_HEVC = 2,
+    LIBVLC_VIDEO_PATH_CODEC_AV1 = 3,
+};
+
+enum libvlc_video_path_chroma {
+    LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN = 0,
+    LIBVLC_VIDEO_PATH_CHROMA_MONOCHROME = 1,
+    LIBVLC_VIDEO_PATH_CHROMA_420 = 2,
+    LIBVLC_VIDEO_PATH_CHROMA_422 = 3,
+    LIBVLC_VIDEO_PATH_CHROMA_444 = 4,
+};
+
+enum libvlc_video_path_truth {
+    LIBVLC_VIDEO_PATH_TRUTH_UNKNOWN = 0,
+    LIBVLC_VIDEO_PATH_TRUTH_NO = 1,
+    LIBVLC_VIDEO_PATH_TRUTH_YES = 2,
+};
+
+enum libvlc_video_path_unknown_reason {
+    LIBVLC_VIDEO_PATH_UNKNOWN_NONE = 0,
+    LIBVLC_VIDEO_PATH_UNKNOWN_BITSTREAM_CONFIG_UNPARSEABLE = 1,
+    LIBVLC_VIDEO_PATH_UNKNOWN_CODEC_UNSUPPORTED = 2,
+    LIBVLC_VIDEO_PATH_UNKNOWN_HARDWARE_PROPERTY_UNAVAILABLE = 3,
+    LIBVLC_VIDEO_PATH_UNKNOWN_PHYSICAL_PRESENTATION_UNAVAILABLE = 4,
+    LIBVLC_VIDEO_PATH_UNKNOWN_SCANOUT_TIMESTAMP_UNAVAILABLE = 5,
+    LIBVLC_VIDEO_PATH_UNKNOWN_LAYER_QUEUE_DEPTH_UNAVAILABLE = 6,
+};
+
+enum libvlc_video_path_outcome {
+    LIBVLC_VIDEO_PATH_OUTCOME_NONE = 0,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_OUTPUT_SUCCESS = 1,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_FRAME_DROPPED = 2,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_STATUS_ERROR = 3,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_NULL_BUFFER = 4,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_DISCARDED_OUTPUT = 5,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_INVALID_PTS = 6,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_EMPTY_BUFFER = 7,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_OUTPUT_FORMAT_FAILURE = 8,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_PICTURE_ALLOCATION_FAILURE = 9,
+    LIBVLC_VIDEO_PATH_OUTCOME_VT_ATTACHMENT_FAILURE = 10,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_LAYER_ABSENT = 20,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_CONVERSION_FAILURE = 21,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_FORMAT_DESCRIPTION_FAILURE = 22,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_SAMPLE_BUFFER_FAILURE = 23,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_LAYER_BACKPRESSURE = 24,
+    LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_SAMPLE_ENQUEUED = 25,
+    /*
+     * This name documents the unchanged scalar "displayed" key. It is not a
+     * presentation or enqueue outcome and must never be normalized as one.
+     */
+    LIBVLC_VIDEO_PATH_OUTCOME_LEGACY_DISPLAY_CALLBACK_RETURNED = 26,
+};
+
+enum libvlc_video_path_policy_flag {
+    LIBVLC_VIDEO_PATH_POLICY_HW_ENABLE_REQUESTED = 1u << 0,
+    LIBVLC_VIDEO_PATH_POLICY_HW_REQUIRE_REQUESTED = 1u << 1,
+};
+
+enum libvlc_video_path_observation_flag {
+    LIBVLC_VIDEO_PATH_OBSERVATION_PHYSICAL_PRESENTATION = 1u << 0,
+    LIBVLC_VIDEO_PATH_OBSERVATION_SCANOUT_TIMESTAMP = 1u << 1,
+    LIBVLC_VIDEO_PATH_OBSERVATION_LAYER_QUEUE_DEPTH = 1u << 2,
+};
+
+/**
+ * Additive immutable video-path telemetry record.
+ *
+ * Producers always set version and struct_size. Consumers must check both and
+ * ignore trailing bytes from newer records. The callback-owned pointer and
+ * bounded text remain valid only until the callback returns.
+ */
+struct libvlc_video_path_event {
+    uint16_t version;
+    uint16_t struct_size;
+    uint32_t kind;
+    uint64_t producer_seq;
+    int64_t monotonic_ts;
+    int64_t pts;
+    uint8_t pts_valid;
+    uint8_t reserved[7];
+
+    uint32_t codec;
+    uint32_t chroma;
+    uint32_t profile;
+    uint32_t bit_depth;
+    uint32_t hardware_state;
+    uint32_t iosurface_state;
+    uint32_t outcome;
+    uint32_t unknown_reason;
+    uint32_t decoded_fourcc;
+    uint32_t policy_flags;
+    uint32_t os_flags;
+    int32_t status;
+    uint32_t observation_flags;
+
+    uint64_t callback_lost_events;
+    uint64_t callback_loss_first_seq;
+    uint64_t callback_loss_last_seq;
+    uint64_t callback_loss_generation;
+
+    char text[LIBVLC_VIDEO_PATH_TEXT_CAPACITY];
+};
+
+typedef int (*libvlc_video_path_cb)(
+    void *sys, const struct libvlc_video_path_event *events, size_t count);
+
 #endif
