diff --git a/modules/access/kymux_video_config.c b/modules/access/kymux_video_config.c
new file mode 100644
index 0000000000000000000000000000000000000000..eebae79b355e2a0c2d99d6717f99404a871e3226
--- /dev/null
+++ b/modules/access/kymux_video_config.c
@@ -0,0 +1,276 @@
+/*****************************************************************************
+ * kymux_video_config.c: bounded production Kymux video config inspection
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include "kymux_video_config.h"
+
+#include <assert.h>
+#include <string.h>
+#include <vlc_common.h>
+#include <vlc_es.h>
+#include <vlc_fourcc.h>
+#include <vlc/libvlc_metrics.h>
+
+#include "../packetizer/av1_obu.h"
+#include "../packetizer/h264_nal.h"
+#include "../packetizer/hevc_nal.h"
+#include "../packetizer/hxxx_nal.h"
+
+static uint32_t
+codec_from_kymux(uint32_t codec)
+{
+    switch (codec)
+    {
+        case KYMUX_CODEC_H264:
+            return LIBVLC_VIDEO_PATH_CODEC_H264;
+        case KYMUX_CODEC_H265:
+            return LIBVLC_VIDEO_PATH_CODEC_HEVC;
+        case KYMUX_CODEC_AV1:
+            return LIBVLC_VIDEO_PATH_CODEC_AV1;
+        default:
+            return LIBVLC_VIDEO_PATH_CODEC_UNKNOWN;
+    }
+}
+
+static uint32_t
+chroma_from_idc(uint8_t idc)
+{
+    switch (idc)
+    {
+        case 0:
+            return LIBVLC_VIDEO_PATH_CHROMA_MONOCHROME;
+        case 1:
+            return LIBVLC_VIDEO_PATH_CHROMA_420;
+        case 2:
+            return LIBVLC_VIDEO_PATH_CHROMA_422;
+        case 3:
+            return LIBVLC_VIDEO_PATH_CHROMA_444;
+        default:
+            return LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN;
+    }
+}
+
+static bool
+inspect_h264(const uint8_t *data, size_t size,
+             struct kymux_video_config *out)
+{
+    hxxx_iterator_ctx_t iterator;
+    const uint8_t *nal;
+    size_t nal_size;
+
+    hxxx_iterator_init(&iterator, data, size, 0);
+    while (hxxx_annexb_iterate_next(&iterator, &nal, &nal_size))
+    {
+        if (nal_size < 1 || (nal[0] & 0x1f) != H264_NAL_SPS)
+            continue;
+
+        h264_sequence_parameter_set_t *sps =
+            h264_decode_sps(nal, nal_size, true);
+        if (!sps)
+            continue;
+
+        uint8_t profile;
+        uint8_t level;
+        uint8_t chroma;
+        uint8_t luma_depth;
+        uint8_t chroma_depth;
+        bool valid =
+            h264_get_sps_profile_tier_level(sps, &profile, &level) &&
+            h264_get_chroma_luma(sps, &chroma, &luma_depth, &chroma_depth) &&
+            chroma_from_idc(chroma) != LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN &&
+            luma_depth == chroma_depth;
+        h264_release_sps(sps);
+
+        if (!valid)
+            continue;
+
+        out->profile = profile;
+        out->chroma = chroma_from_idc(chroma);
+        out->bit_depth = luma_depth;
+        return true;
+    }
+    return false;
+}
+
+static bool
+inspect_hevc(const uint8_t *data, size_t size,
+             struct kymux_video_config *out)
+{
+    hxxx_iterator_ctx_t iterator;
+    const uint8_t *nal;
+    size_t nal_size;
+
+    hxxx_iterator_init(&iterator, data, size, 0);
+    while (hxxx_annexb_iterate_next(&iterator, &nal, &nal_size))
+    {
+        if (nal_size < 2 || hevc_getNALType(nal) != HEVC_NAL_SPS)
+            continue;
+
+        hevc_sequence_parameter_set_t *sps =
+            hevc_decode_sps(nal, nal_size, true);
+        if (!sps)
+            continue;
+
+        uint8_t profile;
+        uint8_t level;
+        uint8_t chroma;
+        uint8_t luma_depth;
+        uint8_t chroma_depth;
+        bool valid =
+            hevc_get_sps_profile_tier_level(sps, &profile, &level) &&
+            hevc_get_chroma_luma(sps, &chroma, &luma_depth, &chroma_depth) &&
+            chroma_from_idc(chroma) != LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN &&
+            luma_depth == chroma_depth;
+        hevc_rbsp_release_sps(sps);
+
+        if (!valid)
+            continue;
+
+        out->profile = profile;
+        out->chroma = chroma_from_idc(chroma);
+        out->bit_depth = luma_depth;
+        return true;
+    }
+    return false;
+}
+
+static bool
+inspect_av1(const uint8_t *data, size_t size,
+            struct kymux_video_config *out)
+{
+    AV1_OBU_iterator_ctx_t iterator;
+    const uint8_t *obu;
+    size_t obu_size;
+
+    AV1_OBU_iterator_init(&iterator, data, size);
+    while (AV1_OBU_iterate_next(&iterator, &obu, &obu_size))
+    {
+        if (AV1_OBUGetType(obu) != AV1_OBU_SEQUENCE_HEADER)
+            continue;
+
+        av1_OBU_sequence_header_t *sequence =
+            AV1_OBU_parse_sequence_header(obu, obu_size);
+        if (!sequence)
+            continue;
+
+        int profile;
+        int level;
+        int tier;
+        AV1_get_profile_level(sequence, &profile, &level, &tier);
+        vlc_fourcc_t fourcc = AV1_get_chroma(sequence);
+        AV1_release_sequence_header(sequence);
+
+        out->profile = profile;
+        switch (fourcc)
+        {
+            case VLC_CODEC_GREY:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_MONOCHROME;
+                out->bit_depth = 8;
+                break;
+            case VLC_CODEC_GREY_10L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_MONOCHROME;
+                out->bit_depth = 10;
+                break;
+            case VLC_CODEC_GREY_12L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_MONOCHROME;
+                out->bit_depth = 12;
+                break;
+            case VLC_CODEC_I420:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_420;
+                out->bit_depth = 8;
+                break;
+            case VLC_CODEC_I420_10L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_420;
+                out->bit_depth = 10;
+                break;
+            case VLC_CODEC_I420_12L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_420;
+                out->bit_depth = 12;
+                break;
+            case VLC_CODEC_I422:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_422;
+                out->bit_depth = 8;
+                break;
+            case VLC_CODEC_I422_10L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_422;
+                out->bit_depth = 10;
+                break;
+            case VLC_CODEC_I422_12L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_422;
+                out->bit_depth = 12;
+                break;
+            case VLC_CODEC_I444:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_444;
+                out->bit_depth = 8;
+                break;
+            case VLC_CODEC_I444_10L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_444;
+                out->bit_depth = 10;
+                break;
+            case VLC_CODEC_I444_12L:
+                out->chroma = LIBVLC_VIDEO_PATH_CHROMA_444;
+                out->bit_depth = 12;
+                break;
+            default:
+                return false;
+        }
+        return true;
+    }
+    return false;
+}
+
+bool
+kymux_video_config_Inspect(uint32_t codec, const uint8_t *data, size_t size,
+                           struct kymux_video_config *out)
+{
+    if (!out)
+        return false;
+
+    memset(out, 0, sizeof(*out));
+    out->codec = codec_from_kymux(codec);
+    if (out->codec == LIBVLC_VIDEO_PATH_CODEC_UNKNOWN)
+    {
+        out->unknown_reason =
+            LIBVLC_VIDEO_PATH_UNKNOWN_CODEC_UNSUPPORTED;
+        return false;
+    }
+    if (!data || size == 0)
+    {
+        out->unknown_reason =
+            LIBVLC_VIDEO_PATH_UNKNOWN_BITSTREAM_CONFIG_UNPARSEABLE;
+        return false;
+    }
+
+    bool valid;
+    switch (codec)
+    {
+        case KYMUX_CODEC_H264:
+            valid = inspect_h264(data, size, out);
+            break;
+        case KYMUX_CODEC_H265:
+            valid = inspect_hevc(data, size, out);
+            break;
+        case KYMUX_CODEC_AV1:
+            valid = inspect_av1(data, size, out);
+            break;
+        default:
+            vlc_assert_unreachable();
+    }
+
+    if (!valid)
+    {
+        out->chroma = LIBVLC_VIDEO_PATH_CHROMA_UNKNOWN;
+        out->profile = 0;
+        out->bit_depth = 0;
+        out->unknown_reason =
+            LIBVLC_VIDEO_PATH_UNKNOWN_BITSTREAM_CONFIG_UNPARSEABLE;
+        return false;
+    }
+
+    out->unknown_reason = LIBVLC_VIDEO_PATH_UNKNOWN_NONE;
+    return true;
+}
