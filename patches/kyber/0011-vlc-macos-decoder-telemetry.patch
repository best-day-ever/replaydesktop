+static uint32_t
+VideoPathCodec(const decoder_sys_t *p_sys)
+{
+    switch (p_sys->codec)
+    {
+        case kCMVideoCodecType_H264:
+            return LIBVLC_VIDEO_PATH_CODEC_H264;
+        case kCMVideoCodecType_HEVC:
+            return LIBVLC_VIDEO_PATH_CODEC_HEVC;
+        case kCMVideoCodecType_AV1:
+            return LIBVLC_VIDEO_PATH_CODEC_AV1;
+        default:
+            return LIBVLC_VIDEO_PATH_CODEC_UNKNOWN;
+    }
+}
+
+static void
+VideoPathPush(decoder_t *p_dec, vlc_video_path_event *event)
+{
+    struct vlc_metrics *metrics = vlc_metrics_Get(VLC_OBJECT(p_dec));
+    if (metrics)
+        (void) vlc_metrics_PushVideoPath(metrics, event);
+}
+
+static void
+VideoPathPublishSession(decoder_t *p_dec)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    CFTypeRef property = NULL;
+    OSStatus status = VTSessionCopyProperty(
+        p_sys->session,
+        kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+        kCFAllocatorDefault, &property);
+    bool is_boolean =
+        property != NULL && CFGetTypeID(property) == CFBooleanGetTypeID();
+    bool value = is_boolean && CFBooleanGetValue((CFBooleanRef) property);
+
+    vlc_video_path_event event;
+    vlc_video_path_event_Init(
+        &event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_SESSION, false, 0);
+    event.codec = VideoPathCodec(p_sys);
+    event.policy_flags = p_sys->video_path_policy_flags;
+    event.hardware_state = vlc_video_path_NormalizeBooleanProperty(
+        status == noErr, is_boolean, value);
+    event.status = status;
+    if (event.hardware_state == LIBVLC_VIDEO_PATH_TRUTH_UNKNOWN)
+        event.unknown_reason =
+            LIBVLC_VIDEO_PATH_UNKNOWN_HARDWARE_PROPERTY_UNAVAILABLE;
+    VideoPathPush(p_dec, &event);
+
+    if (property != NULL)
+        CFRelease(property);
+}
+
+static bool
+VideoPathPrepareSurface(decoder_t *p_dec,
+                        CVPixelBufferRef image_buffer, CMTime pts,
+                        vlc_video_path_event *event)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    OSType cvfmt = CVPixelBufferGetPixelFormatType(image_buffer);
+    uint32_t iosurface = CVPixelBufferGetIOSurface(image_buffer) != NULL
+                       ? LIBVLC_VIDEO_PATH_TRUTH_YES
+                       : LIBVLC_VIDEO_PATH_TRUTH_NO;
+
+    if (p_sys->video_path_surface_emitted &&
+        p_sys->video_path_last_cvfmt == cvfmt &&
+        p_sys->video_path_last_iosurface == iosurface)
+        return false;
+
+    p_sys->video_path_surface_emitted = true;
+    p_sys->video_path_last_cvfmt = cvfmt;
+    p_sys->video_path_last_iosurface = iosurface;
+
+    bool pts_valid = CMTIME_IS_VALID(pts);
+    vlc_video_path_event_Init(
+        event, LIBVLC_VIDEO_PATH_EVENT_DECODED_SURFACE,
+        pts_valid, pts_valid ? pts.value : 0);
+    event->codec = VideoPathCodec(p_sys);
+    event->decoded_fourcc = cvfmt;
+    event->iosurface_state = iosurface;
+    return true;
+}
+
+static void
+VideoPathPublishFrameOutcome(
+    decoder_t *p_dec, OSStatus status, VTDecodeInfoFlags flags, CMTime pts,
+    const struct vlc_video_path_vt_outcome_input *input)
+{
+    bool pts_valid = CMTIME_IS_VALID(pts);
+    vlc_video_path_event event;
+    vlc_video_path_event_Init(
+        &event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME,
+        pts_valid, pts_valid ? pts.value : 0);
+    event.codec = VideoPathCodec(p_dec->p_sys);
+    event.status = status;
+    event.os_flags = flags;
+    event.outcome = vlc_video_path_ClassifyVTOutcome(input);
+    VideoPathPush(p_dec, &event);
+}
