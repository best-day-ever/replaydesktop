+static void
+test_videotoolbox_outcome_classifier(void)
+{
+    struct vlc_video_path_vt_outcome_input input = {
+        .status = 0,
+        .flags = 0,
+        .frame_dropped = false,
+        .image_buffer_present = true,
+        .output_discarded = false,
+        .pts_valid = true,
+        .buffer_nonempty = true,
+        .output_format_valid = true,
+        .picture_allocated = true,
+        .attachment_succeeded = true,
+    };
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_OUTPUT_SUCCESS);
+
+    input.status = -1;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_STATUS_ERROR);
+    input.status = 0;
+
+    input.frame_dropped = true;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_FRAME_DROPPED);
+    input.frame_dropped = false;
+
+    input.image_buffer_present = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_NULL_BUFFER);
+    input.image_buffer_present = true;
+
+    input.output_discarded = true;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_DISCARDED_OUTPUT);
+    input.output_discarded = false;
+
+    input.pts_valid = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_INVALID_PTS);
+    input.pts_valid = true;
+
+    input.buffer_nonempty = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_EMPTY_BUFFER);
+    input.buffer_nonempty = true;
+
+    input.output_format_valid = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_OUTPUT_FORMAT_FAILURE);
+    input.output_format_valid = true;
+
+    input.picture_allocated = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_PICTURE_ALLOCATION_FAILURE);
+    input.picture_allocated = true;
+
+    input.attachment_succeeded = false;
+    assert(vlc_video_path_ClassifyVTOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_VT_ATTACHMENT_FAILURE);
+}
