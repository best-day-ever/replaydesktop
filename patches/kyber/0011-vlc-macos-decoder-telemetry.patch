+static void
+test_hardware_property_normalization(void)
+{
+    assert(vlc_video_path_NormalizeBooleanProperty(false, false, false) ==
+           LIBVLC_VIDEO_PATH_TRUTH_UNKNOWN);
+    assert(vlc_video_path_NormalizeBooleanProperty(true, false, true) ==
+           LIBVLC_VIDEO_PATH_TRUTH_UNKNOWN);
+    assert(vlc_video_path_NormalizeBooleanProperty(true, true, false) ==
