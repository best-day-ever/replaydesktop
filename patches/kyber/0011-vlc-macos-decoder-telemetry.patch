+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_LAYER_ABSENT);
+
+    input.layer_present = true;
+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_CONVERSION_FAILURE);
+    input.conversion_succeeded = true;
+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_FORMAT_DESCRIPTION_FAILURE);
+    input.format_description_succeeded = true;
+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_SAMPLE_BUFFER_FAILURE);
+    input.sample_buffer_succeeded = true;
+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
+           LIBVLC_VIDEO_PATH_OUTCOME_RENDERER_LAYER_BACKPRESSURE);
+    input.layer_ready = true;
+    assert(vlc_video_path_ClassifyRendererOutcome(&input) ==
