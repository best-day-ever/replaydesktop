+static size_t count_metric(const MetricsCapture *capture, const char *key)
+{
+    size_t count = 0;
+    for (size_t i = 0; i < capture->count; i++) {
+        if (strcmp(capture->entries[i].key, key) == 0)
+            count++;
+    }
+    return count;
