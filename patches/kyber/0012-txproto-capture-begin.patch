+static void test_capture_begin_batch(void)
+{
+    struct tx_metrics metrics;
+    MetricsCapture capture = { 0 };
+    const tx_metrics_entry successful_frame[] = {
+        { .key = "pts", .value = 41 },
+        { .key = "capture_begin", .value = 100 },
+        { .key = "acquired", .value = 103 },
+    };
+
+    tx_metrics_init(&metrics);
+    metrics.cb = capture_metrics;
+    metrics.userdata = &capture;
+
+    tx_metrics_push(&metrics, successful_frame,
+                    sizeof(successful_frame) / sizeof(successful_frame[0]));
+    assert(capture.calls == 1);
+    assert(capture.count == 3);
+    assert(strcmp(capture.entries[0].key, "pts") == 0);
+    assert(strcmp(capture.entries[1].key, "capture_begin") == 0);
+    assert(strcmp(capture.entries[2].key, "acquired") == 0);
+    assert(find_metric(&capture, "pts")->value == 41);
+    assert(find_metric(&capture, "capture_begin")->value == 100);
+    assert(find_metric(&capture, "acquired")->value == 103);
+    assert(count_metric(&capture, "pts") == 1);
+    assert(count_metric(&capture, "capture_begin") == 1);
+    assert(count_metric(&capture, "acquired") == 1);
+    assert(find_metric(&capture, "capture_begin")->value <=
+           find_metric(&capture, "acquired")->value);
+
+    capture.reject = 1;
+    tx_metrics_push(&metrics, successful_frame,
+                    sizeof(successful_frame) / sizeof(successful_frame[0]));
+    assert(capture.calls == 2);
+    assert(atomic_load(&metrics.callback_lost_batches) == 1);
+    assert(atomic_load(&metrics.callback_lost_entries) == 3);
+
+    capture.reject = 0;
+    tx_metrics_push(&metrics, successful_frame,
+                    sizeof(successful_frame) / sizeof(successful_frame[0]));
+    assert(capture.calls == 3);
+    assert(capture.count == 5);
+    assert(find_metric(&capture,
+                       "telemetry_callback_lost_batches_total")->value == 1);
+    assert(find_metric(&capture,
+                       "telemetry_callback_lost_entries_total")->value == 3);
+    assert(strcmp(capture.entries[2].key, "pts") == 0);
+    assert(strcmp(capture.entries[3].key, "capture_begin") == 0);
+    assert(strcmp(capture.entries[4].key, "acquired") == 0);
+    assert(count_metric(&capture, "pts") == 1);
+    assert(count_metric(&capture, "capture_begin") == 1);
+    assert(count_metric(&capture, "acquired") == 1);
+    assert(find_metric(&capture, "capture_begin")->value == 100);
+    assert(find_metric(&capture, "acquired")->value == 103);
+}
