+    #[test]
+    fn simultaneous_writers_get_unique_sequences_and_nonregressing_acceptance() {
+        const WRITERS: usize = 8;
+        const ITERATIONS: usize = 100;
+        let (tx, mut rx) = mpsc::channel(WRITERS * ITERATIONS);
+        let forwarder = Arc::new(MetricsForwarder::new(tx));
+        let start = Arc::new(Barrier::new(WRITERS));
+        let mut writers = Vec::new();
+
+        for writer_id in 0..WRITERS {
+            let forwarder = Arc::clone(&forwarder);
+            let start = Arc::clone(&start);
+            writers.push(thread::spawn(move || {
+                start.wait();
+                for iteration in 0..ITERATIONS {
+                    assert!(forwarder.try_forward(&[
+                        source("writer", writer_id as i64),
+                        source("iteration", iteration as i64),
+                    ]));
+                }
+            }));
+        }
+        for writer in writers {
+            writer.join().expect("metrics writer");
+        }
+
+        let mut sequences = Vec::with_capacity(WRITERS * ITERATIONS);
+        while let Ok(metrics) = rx.try_recv() {
+            assert_eq!(metrics[0].key, "writer");
+            assert_eq!(metrics[1].key, "iteration");
+            assert_eq!(metrics[2].key, "telemetry_forwarder_sequence");
+            sequences.push(metrics[2].value);
+        }
+        sequences.sort_unstable();
+        assert_eq!(
+            sequences,
+            (1..=(WRITERS * ITERATIONS) as i64).collect::<Vec<_>>()
+        );
+        assert_eq!(
+            forwarder
+                .state
+                .last_accepted_sequence
+                .load(Ordering::SeqCst),
+            (WRITERS * ITERATIONS) as u64
+        );
+    }
