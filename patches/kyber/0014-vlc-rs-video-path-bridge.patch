+struct VideoPathCallbackState {
+    callback: Box<VideoPathCallback>,
+    native_lifetime_closed: AtomicBool,
+    terminal_emitted: AtomicBool,
+    last_observed_producer_sequence: AtomicU64,
+    bridge_rejected_callbacks: AtomicU64,
+    bridge_rejected_records: AtomicU64,
+    first_rejected_producer_sequence: AtomicU64,
+    last_rejected_producer_sequence: AtomicU64,
+}
+
+impl VideoPathCallbackState {
+    fn new<C>(callback: C) -> Self
+    where
+        C: Fn(VideoPathCallbackEvent) -> VideoPathCallbackDisposition + Send + Sync + 'static,
+    {
+        Self {
+            callback: Box::new(callback),
+            native_lifetime_closed: AtomicBool::new(false),
+            terminal_emitted: AtomicBool::new(false),
+            last_observed_producer_sequence: AtomicU64::new(0),
+            bridge_rejected_callbacks: AtomicU64::new(0),
+            bridge_rejected_records: AtomicU64::new(0),
+            first_rejected_producer_sequence: AtomicU64::new(0),
+            last_rejected_producer_sequence: AtomicU64::new(0),
+        }
+    }
+
+    fn observe_producer_sequence(&self, sequence: u64) {
+        atomic_maximum(&self.last_observed_producer_sequence, sequence);
+    }
+
+    fn record_rejection(&self, rejected: RejectedVideoPathBatch) {
+        atomic_saturating_add(&self.bridge_rejected_callbacks, 1);
+        atomic_saturating_add(&self.bridge_rejected_records, rejected.record_count);
+        if let Some(sequence) = rejected.first_sequence {
+            atomic_minimum_nonzero(&self.first_rejected_producer_sequence, sequence);
+        }
+        if let Some(sequence) = rejected.last_sequence {
+            atomic_maximum(&self.last_rejected_producer_sequence, sequence);
+        }
+    }
+
+    fn terminal_snapshot(&self) -> VideoPathTerminal {
+        VideoPathTerminal {
+            last_observed_producer_sequence: nonzero_option(
+                self.last_observed_producer_sequence.load(Ordering::SeqCst),
+            ),
+            bridge_rejected_callbacks: self.bridge_rejected_callbacks.load(Ordering::SeqCst),
+            bridge_rejected_records: self.bridge_rejected_records.load(Ordering::SeqCst),
+            first_rejected_producer_sequence: nonzero_option(
+                self.first_rejected_producer_sequence.load(Ordering::SeqCst),
+            ),
+            last_rejected_producer_sequence: nonzero_option(
+                self.last_rejected_producer_sequence.load(Ordering::SeqCst),
+            ),
+        }
+    }
+}
+
+fn nonzero_option(value: u64) -> Option<u64> {
+    if value == 0 {
+        None
+    } else {
+        Some(value)
+    }
+}
+
+fn atomic_saturating_add(value: &AtomicU64, increment: u64) {
+    let mut current = value.load(Ordering::SeqCst);
+    loop {
+        let next = current.saturating_add(increment);
+        match value.compare_exchange_weak(current, next, Ordering::SeqCst, Ordering::SeqCst) {
+            Ok(_) => return,
+            Err(observed) => current = observed,
+        }
+    }
+}
+
+fn atomic_maximum(value: &AtomicU64, candidate: u64) {
+    let mut current = value.load(Ordering::SeqCst);
+    while candidate > current {
+        match value.compare_exchange_weak(current, candidate, Ordering::SeqCst, Ordering::SeqCst) {
+            Ok(_) => return,
+            Err(observed) => current = observed,
+        }
+    }
+}
+
+fn atomic_minimum_nonzero(value: &AtomicU64, candidate: u64) {
+    if candidate == 0 {
+        return;
+    }
+
+    let mut current = value.load(Ordering::SeqCst);
+    while current == 0 || candidate < current {
+        match value.compare_exchange_weak(current, candidate, Ordering::SeqCst, Ordering::SeqCst) {
+            Ok(_) => return,
+            Err(observed) => current = observed,
+        }
+    }
+}
+
+fn install_video_path_callback_with<C, S>(
+    slot: &mut Option<Box<VideoPathCallbackState>>,
+    callback: C,
+    setter: S,
+) -> Result<(), VideoPathCallbackInstallError>
+where
+    C: Fn(VideoPathCallbackEvent) -> VideoPathCallbackDisposition + Send + Sync + 'static,
+    S: FnOnce(sys::libvlc_video_path_cb, *mut c_void) -> c_int,
+{
+    let mut candidate = Box::new(VideoPathCallbackState::new(callback));
+    if slot.is_some() {
+        return Err(VideoPathCallbackInstallError::AlreadyInstalled);
+    }
+
+    let userdata = (&mut *candidate as *mut VideoPathCallbackState).cast::<c_void>();
+    let status = setter(video_path_cb, userdata);
+    if status != 0 {
+        return Err(VideoPathCallbackInstallError::NativeRejected(status));
+    }
+
+    *slot = Some(candidate);
+    Ok(())
+}
+
+fn release_video_path_callback_with<R>(
+    callback_state: Option<Box<VideoPathCallbackState>>,
+    release: R,
+) where
+    R: FnOnce(),
+{
+    release();
+
+    if let Some(state) = callback_state {
+        state.native_lifetime_closed.store(true, Ordering::SeqCst);
+        if !state.terminal_emitted.swap(true, Ordering::SeqCst) {
+            let terminal = state.terminal_snapshot();
+            let _ = catch_unwind(AssertUnwindSafe(|| {
+                (state.callback)(VideoPathCallbackEvent::ProducerTerminalUnconfirmed(
+                    terminal,
+                ))
+            }));
+        }
+    }
+}
