+    #[test]
+    fn accepts_owned_batches_and_accounts_reject_and_malformed_input() {
+        let accepted = Arc::new(Mutex::new(Vec::new()));
+        let accepted_for_callback = Arc::clone(&accepted);
+        let mut state = Box::new(VideoPathCallbackState::new(move |event| {
+            if let VideoPathCallbackEvent::Records(records) = event {
+                accepted_for_callback
+                    .lock()
+                    .unwrap()
+                    .push(records[0].text.clone());
+            }
+            VideoPathCallbackDisposition::Accept
+        }));
+        let event = raw_event(4, "owned");
+        assert_eq!(invoke(&mut state, &event, 1), 0);
+        assert_eq!(accepted.lock().unwrap().as_slice(), ["owned"]);
+
+        let rejected_terminal = Arc::new(Mutex::new(None));
+        let rejected_terminal_for_callback = Arc::clone(&rejected_terminal);
+        let mut rejecting = Box::new(VideoPathCallbackState::new(move |event| match event {
+            VideoPathCallbackEvent::Records(_) => VideoPathCallbackDisposition::Reject,
+            VideoPathCallbackEvent::ProducerTerminalUnconfirmed(terminal) => {
+                *rejected_terminal_for_callback.lock().unwrap() = Some(terminal);
+                VideoPathCallbackDisposition::Accept
+            }
+        }));
+        let rejected_event = raw_event(9, "reject");
+        assert_eq!(
+            invoke(&mut rejecting, &rejected_event, 1),
+            VIDEO_PATH_CALLBACK_REJECTED
+        );
+        release_video_path_callback_with(Some(rejecting), || {});
+        assert_eq!(
+            rejected_terminal.lock().unwrap().as_ref(),
+            Some(&VideoPathTerminal {
+                last_observed_producer_sequence: Some(9),
+                bridge_rejected_callbacks: 1,
+                bridge_rejected_records: 1,
+                first_rejected_producer_sequence: Some(9),
+                last_rejected_producer_sequence: Some(9),
+            })
+        );
+
+        let consumer_calls = Arc::new(AtomicUsize::new(0));
+        let calls_for_callback = Arc::clone(&consumer_calls);
+        let mut malformed_state = Box::new(VideoPathCallbackState::new(move |_| {
+            calls_for_callback.fetch_add(1, AtomicOrdering::SeqCst);
+            VideoPathCallbackDisposition::Accept
+        }));
+        let mut malformed = raw_event(11, "bad");
+        malformed.pts = 1;
+        assert_eq!(
+            invoke(&mut malformed_state, &malformed, 1),
+            VIDEO_PATH_CALLBACK_REJECTED
+        );
+        assert_eq!(consumer_calls.load(AtomicOrdering::SeqCst), 0);
+        let terminal = malformed_state.terminal_snapshot();
+        assert_eq!(terminal.bridge_rejected_callbacks, 1);
+        assert_eq!(terminal.bridge_rejected_records, 1);
+        assert_eq!(terminal.first_rejected_producer_sequence, Some(11));
