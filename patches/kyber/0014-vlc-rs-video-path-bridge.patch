+fn convert_video_path_event(raw: &sys::libvlc_video_path_event) -> Result<VideoPathEvent, ()> {
+    if raw.version != sys::LIBVLC_VIDEO_PATH_EVENT_VERSION
+        || usize::from(raw.struct_size) < VIDEO_PATH_V1_PREFIX_SIZE
+        || usize::from(raw.struct_size) > VIDEO_PATH_MAX_RECORD_BYTES
+        || usize::from(raw.struct_size) % std::mem::align_of::<sys::libvlc_video_path_event>() != 0
+        || raw.kind == 0
+        || raw.producer_seq == 0
+        || raw.monotonic_ts <= 0
+        || raw.reserved.iter().any(|byte| *byte != 0)
+    {
+        return Err(());
+    }
+
+    let pts = match raw.pts_valid {
+        0 if raw.pts == 0 => None,
+        1 => Some(raw.pts),
+        _ => return Err(()),
+    };
+
+    let text_bytes = raw
+        .text
+        .iter()
+        .map(|value| *value as u8)
+        .collect::<Vec<_>>();
+    let text_end = text_bytes.iter().position(|byte| *byte == 0).ok_or(())?;
+    let text = str::from_utf8(&text_bytes[..text_end])
+        .map_err(|_| ())?
+        .to_owned();
+
+    let loss_values = [
+        raw.callback_lost_events,
+        raw.callback_loss_first_seq,
+        raw.callback_loss_last_seq,
+        raw.callback_loss_generation,
+    ];
+    let native_callback_loss = if loss_values.iter().all(|value| *value == 0) {
+        None
+    } else {
+        if loss_values.contains(&0) || raw.callback_loss_first_seq > raw.callback_loss_last_seq {
+            return Err(());
+        }
+        Some(VideoPathCallbackLoss {
+            lost_events: raw.callback_lost_events,
+            first_sequence: raw.callback_loss_first_seq,
+            last_sequence: raw.callback_loss_last_seq,
+            generation: raw.callback_loss_generation,
+        })
+    };
+
+    Ok(VideoPathEvent {
+        abi_version: raw.version,
+        source_struct_size: raw.struct_size,
+        kind: VideoPathEventKind::from_raw(raw.kind),
+        producer_sequence: raw.producer_seq,
+        monotonic_timestamp: raw.monotonic_ts,
+        pts,
+        codec: VideoPathCodec::from_raw(raw.codec),
+        chroma: VideoPathChroma::from_raw(raw.chroma),
+        profile: raw.profile,
+        bit_depth: raw.bit_depth,
+        hardware_state: VideoPathTruth::from_raw(raw.hardware_state),
+        iosurface_state: VideoPathTruth::from_raw(raw.iosurface_state),
+        outcome: VideoPathOutcome::from_raw(raw.outcome),
+        unknown_reason: VideoPathUnknownReason::from_raw(raw.unknown_reason),
+        decoded_fourcc: raw.decoded_fourcc,
+        policy_flags: VideoPathPolicyFlags::from_bits_retain(raw.policy_flags),
+        os_flags: VideoPathOsFlags::from_bits_retain(raw.os_flags),
+        status: raw.status,
+        observation_flags: VideoPathObservationFlags::from_bits_retain(raw.observation_flags),
+        native_callback_loss,
+        text,
+    })
+}
+
+pub(crate) unsafe fn copy_video_path_batch(
+    events: *const sys::libvlc_video_path_event,
+    count: usize,
+) -> Result<ValidatedVideoPathBatch, RejectedVideoPathBatch> {
+    let mut rejected = RejectedVideoPathBatch::new(count);
+    if events.is_null() || count == 0 || count > VIDEO_PATH_MAX_RECORDS {
+        return Err(rejected);
+    }
+
+    let mut owned = Vec::with_capacity(count);
+    let mut walked_bytes = 0usize;
+    let base = events.cast::<u8>();
+    let record_alignment = std::mem::align_of::<sys::libvlc_video_path_event>();
+    if (base as usize) % record_alignment != 0 {
+        return Err(rejected);
+    }
+
+    for _ in 0..count {
+        let header_in_bounds = matches!(
+            walked_bytes.checked_add(std::mem::size_of::<u16>() * 2),
+            Some(header_end) if header_end <= VIDEO_PATH_MAX_CALLBACK_BYTES
+        );
+        if !header_in_bounds {
+            return Err(rejected);
+        }
+
+        let record_address = match (base as usize).checked_add(walked_bytes) {
+            Some(address) if address % record_alignment == 0 => address,
+            _ => return Err(rejected),
+        };
+        let record = record_address as *const u8;
+        let version = unsafe { ptr::read_unaligned(record.cast::<u16>()) };
+        let struct_size = unsafe { ptr::read_unaligned(record.add(2).cast::<u16>()) } as usize;
+
+        if version != sys::LIBVLC_VIDEO_PATH_EVENT_VERSION
+            || !(VIDEO_PATH_V1_PREFIX_SIZE..=VIDEO_PATH_MAX_RECORD_BYTES).contains(&struct_size)
+            || struct_size % std::mem::align_of::<sys::libvlc_video_path_event>() != 0
+        {
+            return Err(rejected);
+        }
+
+        let next_record = match walked_bytes.checked_add(struct_size) {
+            Some(next) if next <= VIDEO_PATH_MAX_CALLBACK_BYTES => next,
+            _ => return Err(rejected),
+        };
+        let raw = unsafe { ptr::read_unaligned(record.cast::<sys::libvlc_video_path_event>()) };
+        rejected.observe_sequence(raw.producer_seq);
+        match convert_video_path_event(&raw) {
+            Ok(event) => owned.push(event),
+            Err(()) => return Err(rejected),
+        }
+        walked_bytes = next_record;
+    }
+
+    let first_sequence = owned
+        .iter()
+        .map(|event| event.producer_sequence)
+        .min()
+        .expect("nonempty callback batch");
+    let last_sequence = owned
+        .iter()
+        .map(|event| event.producer_sequence)
+        .max()
+        .expect("nonempty callback batch");
+
+    Ok(ValidatedVideoPathBatch {
+        events: owned,
+        first_sequence,
+        last_sequence,
+    })
+}
