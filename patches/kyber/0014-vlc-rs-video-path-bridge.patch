+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VideoPathCallbackInstallError {
+    AlreadyInstalled,
+    NativeRejected(c_int),
+}
+
+impl fmt::Display for VideoPathCallbackInstallError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::AlreadyInstalled => formatter.write_str("video-path callback already installed"),
+            Self::NativeRejected(status) => {
+                write!(
+                    formatter,
+                    "libVLC rejected video-path callback installation ({})",
+                    status
+                )
+            }
+        }
+    }
+}
+
+impl std::error::Error for VideoPathCallbackInstallError {}
