+    #[test]
+    fn concurrent_callbacks_keep_exact_bounded_facts() {
+        const THREADS: usize = 8;
+        const CALLS_PER_THREAD: usize = 50;
+
+        let calls = Arc::new(AtomicUsize::new(0));
+        let calls_for_callback = Arc::clone(&calls);
+        let state = Box::new(VideoPathCallbackState::new(move |event| {
+            if let VideoPathCallbackEvent::Records(records) = event {
+                assert_eq!(records.len(), 1);
+                calls_for_callback.fetch_add(1, AtomicOrdering::SeqCst);
+            }
+            VideoPathCallbackDisposition::Accept
+        }));
+        let state_address = Box::into_raw(state) as usize;
+        let mut threads = Vec::new();
+        for thread_index in 0..THREADS {
+            threads.push(thread::spawn(move || {
+                for call_index in 0..CALLS_PER_THREAD {
+                    let sequence = (thread_index * CALLS_PER_THREAD + call_index + 1) as u64;
+                    let event = raw_event(sequence, "concurrent");
+                    let status = unsafe { video_path_cb(state_address as *mut c_void, &event, 1) };
+                    assert_eq!(status, 0);
+                }
+            }));
+        }
+        for thread in threads {
+            thread.join().unwrap();
+        }
+
+        let state = unsafe { Box::from_raw(state_address as *mut VideoPathCallbackState) };
+        assert_eq!(
+            calls.load(AtomicOrdering::SeqCst),
+            THREADS * CALLS_PER_THREAD
+        );
+        assert_eq!(
+            state.last_observed_producer_sequence.load(Ordering::SeqCst),
+            (THREADS * CALLS_PER_THREAD) as u64
+        );
+        assert_eq!(state.bridge_rejected_callbacks.load(Ordering::SeqCst), 0);
+    }
