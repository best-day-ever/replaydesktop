+        assert_eq!(event.policy_flags.bits(), 0x8000_0003);
+        assert_eq!(event.os_flags.bits(), 0x8765_4321);
+        assert_eq!(event.observation_flags.bits(), 0x4000_0007);
+    }
+
+    #[test]
+    fn accepts_larger_aligned_v1_stride_and_ignores_tail() {
+        let mut raw = raw_event(1, "extended");
+        raw.struct_size = 256;
+        let mut storage = vec![u64::MAX; 256 / mem::size_of::<u64>()];
+        let storage_bytes = storage.as_mut_ptr().cast::<u8>();
+        unsafe {
+            ptr::copy_nonoverlapping(
+                (&raw as *const sys::libvlc_video_path_event).cast::<u8>(),
+                storage_bytes,
+                VIDEO_PATH_V1_PREFIX_SIZE,
+            );
+        }
+        let owned = unsafe {
+            copy_video_path_batch(storage_bytes.cast::<sys::libvlc_video_path_event>(), 1)
+        }
+        .unwrap();
+        assert_eq!(owned.events[0].source_struct_size, 256);
+        assert_eq!(owned.events[0].text, "extended");
+    }
+
+    #[test]
+    fn walks_mixed_aligned_record_strides() {
+        let mut first = raw_event(1, "first");
+        first.struct_size = VIDEO_PATH_V1_PREFIX_SIZE as u16;
+        let mut second = raw_event(2, "second");
+        second.struct_size = 256;
+        let total_bytes = VIDEO_PATH_V1_PREFIX_SIZE + 256;
+        let mut storage = vec![0u64; total_bytes / mem::size_of::<u64>()];
+        let storage_bytes = storage.as_mut_ptr().cast::<u8>();
+        unsafe {
+            ptr::copy_nonoverlapping(
+                (&first as *const sys::libvlc_video_path_event).cast::<u8>(),
+                storage_bytes,
+                VIDEO_PATH_V1_PREFIX_SIZE,
+            );
+            ptr::copy_nonoverlapping(
+                (&second as *const sys::libvlc_video_path_event).cast::<u8>(),
+                storage_bytes.add(VIDEO_PATH_V1_PREFIX_SIZE),
+                VIDEO_PATH_V1_PREFIX_SIZE,
+            );
+        }
+        let batch = unsafe {
+            copy_video_path_batch(storage_bytes.cast::<sys::libvlc_video_path_event>(), 2)
+        }
+        .unwrap();
+        assert_eq!(batch.events.len(), 2);
+        assert_eq!(batch.events[0].text, "first");
+        assert_eq!(batch.events[1].text, "second");
+    }
+
+    #[test]
+    fn rejects_pointer_count_and_stride_bounds() {
+        assert!(unsafe { copy_video_path_batch(ptr::null(), 1) }.is_err());
+        let raw = raw_event(1, "");
+        assert!(unsafe { copy_video_path_batch(&raw, 0) }.is_err());
+        assert!(unsafe { copy_video_path_batch(&raw, 65) }.is_err());
+
+        for invalid_size in [191u16, 193, 1032] {
+            let mut invalid = raw_event(1, "");
+            invalid.struct_size = invalid_size;
+            assert!(unsafe { copy_one(&invalid) }.is_err());
+        }
+
+        let mut misaligned_storage = vec![0u64; 32];
+        unsafe {
+            ptr::copy_nonoverlapping(
+                (&raw as *const sys::libvlc_video_path_event).cast::<u8>(),
+                misaligned_storage.as_mut_ptr().cast::<u8>().add(1),
+                VIDEO_PATH_V1_PREFIX_SIZE,
+            );
+            assert!(copy_video_path_batch(
+                misaligned_storage
+                    .as_ptr()
+                    .cast::<u8>()
+                    .add(1)
+                    .cast::<sys::libvlc_video_path_event>(),
+                1,
+            )
+            .is_err());
+        }
+    }
+
+    #[test]
+    fn accepts_exact_aggregate_limit() {
+        let mut storage = vec![0u64; VIDEO_PATH_MAX_CALLBACK_BYTES / mem::size_of::<u64>()];
+        let storage_bytes = storage.as_mut_ptr().cast::<u8>();
+        for index in 0..VIDEO_PATH_MAX_RECORDS {
+            let mut raw = raw_event(index as u64 + 1, "");
+            raw.struct_size = VIDEO_PATH_MAX_RECORD_BYTES as u16;
+            unsafe {
+                ptr::copy_nonoverlapping(
+                    (&raw as *const sys::libvlc_video_path_event).cast::<u8>(),
+                    storage_bytes.add(index * VIDEO_PATH_MAX_RECORD_BYTES),
+                    VIDEO_PATH_V1_PREFIX_SIZE,
+                );
+            }
+        }
+        let result = unsafe {
+            copy_video_path_batch(
+                storage_bytes.cast::<sys::libvlc_video_path_event>(),
+                VIDEO_PATH_MAX_RECORDS,
+            )
+        }
+        .unwrap();
+        assert_eq!(result.events.len(), VIDEO_PATH_MAX_RECORDS);
+    }
+
+    #[test]
+    fn rejects_malformed_version_structural_fields_pts_and_text() {
+        let mut cases = Vec::new();
+
+        let mut version = raw_event(1, "");
+        version.version = 2;
+        cases.push(version);
+
+        let mut sequence = raw_event(1, "");
+        sequence.producer_seq = 0;
+        cases.push(sequence);
+
+        let mut kind = raw_event(1, "");
+        kind.kind = 0;
+        cases.push(kind);
+
+        let mut timestamp = raw_event(1, "");
+        timestamp.monotonic_ts = 0;
+        cases.push(timestamp);
+
+        let mut reserved = raw_event(1, "");
+        reserved.reserved[3] = 1;
+        cases.push(reserved);
+
+        let mut pts_sentinel = raw_event(1, "");
+        pts_sentinel.pts = 1;
+        cases.push(pts_sentinel);
+
+        let mut pts_valid = raw_event(1, "");
+        pts_valid.pts_valid = 2;
+        cases.push(pts_valid);
+
+        let mut unterminated = raw_event(1, "");
+        unterminated.text.fill(b'x' as c_char);
+        cases.push(unterminated);
+
+        let mut invalid_utf8 = raw_event(1, "");
+        invalid_utf8.text[0] = -1;
+        invalid_utf8.text[1] = 0;
+        cases.push(invalid_utf8);
+
+        for case in cases {
+            assert!(unsafe { copy_one(&case) }.is_err());
+        }
+    }
+
+    #[test]
+    fn validates_pts_and_native_loss_without_normalizing() {
+        let mut raw = raw_event(9, "");
+        raw.pts_valid = 1;
+        raw.pts = -17;
+        raw.callback_lost_events = 2;
+        raw.callback_loss_first_seq = 3;
+        raw.callback_loss_last_seq = 5;
+        raw.callback_loss_generation = 8;
+        let owned = unsafe { copy_one(&raw) }.unwrap();
+        assert_eq!(owned.events[0].pts, Some(-17));
+        assert_eq!(
+            owned.events[0].native_callback_loss,
+            Some(VideoPathCallbackLoss {
+                lost_events: 2,
+                first_sequence: 3,
+                last_sequence: 5,
+                generation: 8,
+            })
+        );
+
+        let mut malformed = raw;
+        malformed.callback_loss_generation = 0;
+        assert!(unsafe { copy_one(&malformed) }.is_err());
+
+        malformed = raw;
+        malformed.callback_loss_first_seq = 6;
+        assert!(unsafe { copy_one(&malformed) }.is_err());
+
+        malformed = raw;
+        malformed.callback_lost_events = 0;
+        assert!(unsafe { copy_one(&malformed) }.is_err());
+    }
+}
