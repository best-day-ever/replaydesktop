+    fn observe_sequence(&mut self, sequence: u64) {
+        if sequence == 0 {
+            return;
+        }
+        self.first_sequence = Some(
+            self.first_sequence
+                .map_or(sequence, |current| current.min(sequence)),
+        );
+        self.last_sequence = Some(
+            self.last_sequence
+                .map_or(sequence, |current| current.max(sequence)),
+        );
+    }
