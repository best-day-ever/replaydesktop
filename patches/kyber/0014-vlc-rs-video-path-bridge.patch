+        let probe = OrderedDrop(Arc::clone(&order));
+        let order_for_callback = Arc::clone(&order);
+        let terminal_calls = Arc::new(AtomicUsize::new(0));
+        let terminal_calls_for_callback = Arc::clone(&terminal_calls);
+        let state = Box::new(VideoPathCallbackState::new(move |event| {
+            let _keep_probe_alive = &probe;
+            if let VideoPathCallbackEvent::ProducerTerminalUnconfirmed(terminal) = event {
+                assert_eq!(terminal.last_observed_producer_sequence, None);
+                terminal_calls_for_callback.fetch_add(1, AtomicOrdering::SeqCst);
+                order_for_callback.lock().unwrap().push("terminal");
+            }
+            VideoPathCallbackDisposition::Reject
+        }));
+        let order_for_release = Arc::clone(&order);
+        release_video_path_callback_with(Some(state), move || {
+            order_for_release.lock().unwrap().push("release");
+        });
+        assert_eq!(terminal_calls.load(AtomicOrdering::SeqCst), 1);
+        assert_eq!(
+            order.lock().unwrap().as_slice(),
+            ["release", "terminal", "userdata-drop"]
+        );
+    }
+
+    #[test]
+    fn terminal_consumer_panic_is_contained_before_userdata_drop() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let probe = DropCounter(Arc::clone(&drops));
+        let state = Box::new(VideoPathCallbackState::new(move |_| {
+            let _keep_probe_alive = &probe;
+            panic!("terminal panic");
+        }));
+        release_video_path_callback_with(Some(state), || {});
+        assert_eq!(drops.load(AtomicOrdering::SeqCst), 1);
+    }
+
+    #[test]
+    fn owned_callback_types_are_send_sync_static_and_legacy_type_is_unchanged() {
+        fn assert_send_sync_static<T: Send + Sync + 'static>() {}
+        assert_send_sync_static::<VideoPathCallbackEvent>();
+        assert_send_sync_static::<VideoPathTerminal>();
+
+        let legacy = MetricsEntry {
+            key: "legacy".to_owned(),
+            value: 7,
+        };
+        assert_eq!(legacy.key, "legacy");
+        assert_eq!(legacy.value, 7);
     }
 }
 
