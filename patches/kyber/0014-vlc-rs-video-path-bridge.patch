+    fn raw_event(sequence: u64, text: &str) -> sys::libvlc_video_path_event {
+        let mut event: sys::libvlc_video_path_event = unsafe { mem::zeroed() };
+        event.version = sys::LIBVLC_VIDEO_PATH_EVENT_VERSION;
+        event.struct_size = VIDEO_PATH_V1_PREFIX_SIZE as u16;
+        event.kind = 4;
+        event.producer_seq = sequence;
+        event.monotonic_ts = sequence as i64 + 1;
+        event.codec = 2;
+        event.chroma = 2;
+        event.text[..text.len()]
+            .iter_mut()
+            .zip(text.as_bytes())
+            .for_each(|(destination, source)| *destination = *source as c_char);
+        event
+    }
