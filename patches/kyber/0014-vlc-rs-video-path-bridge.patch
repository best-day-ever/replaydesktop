+unsafe extern "C" fn video_path_cb(
+    data: *mut c_void,
+    events: *const sys::libvlc_video_path_event,
+    count: usize,
+) -> c_int {
+    match catch_unwind(AssertUnwindSafe(|| {
+        if data.is_null() {
+            return VIDEO_PATH_CALLBACK_REJECTED;
+        }
+
+        let state = unsafe { &*(data.cast::<VideoPathCallbackState>()) };
+        if state.native_lifetime_closed.load(Ordering::SeqCst) {
+            state.record_rejection(RejectedVideoPathBatch {
+                record_count: u64::try_from(count.min(crate::metrics::VIDEO_PATH_MAX_RECORDS))
+                    .unwrap_or(crate::metrics::VIDEO_PATH_MAX_RECORDS as u64),
+                first_sequence: None,
+                last_sequence: None,
+            });
+            return VIDEO_PATH_CALLBACK_REJECTED;
+        }
+
+        let batch = match unsafe { copy_video_path_batch(events, count) } {
+            Ok(batch) => batch,
+            Err(rejected) => {
+                state.record_rejection(rejected);
+                return VIDEO_PATH_CALLBACK_REJECTED;
+            }
+        };
+        state.observe_producer_sequence(batch.last_sequence);
+
+        let rejected = RejectedVideoPathBatch {
+            record_count: u64::try_from(batch.events.len()).unwrap_or(u64::MAX),
+            first_sequence: Some(batch.first_sequence),
+            last_sequence: Some(batch.last_sequence),
+        };
+        match catch_unwind(AssertUnwindSafe(|| {
+            (state.callback)(VideoPathCallbackEvent::Records(batch.events))
+        })) {
+            Ok(VideoPathCallbackDisposition::Accept) => 0,
+            Ok(VideoPathCallbackDisposition::Reject) | Err(_) => {
+                state.record_rejection(rejected);
+                VIDEO_PATH_CALLBACK_REJECTED
+            }
+        }
+    })) {
+        Ok(status) => status,
+        Err(_) => VIDEO_PATH_CALLBACK_REJECTED,
+    }
+}
