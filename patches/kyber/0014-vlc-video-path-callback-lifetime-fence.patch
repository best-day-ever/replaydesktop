+
+    struct fence_push_args admitted = {
+        .metrics = fixture.metrics,
+        .result = VLC_EGENERIC,
+    };
+    fence_init_event(&admitted.event, UINT64_C(0x44444444));
+    vlc_thread_t publisher;
+    assert(vlc_clone(&publisher, fence_push_thread, &admitted) == 0);
+    vlc_sem_wait(&fixture.callback_entered);
+
+    assert(libvlc_media_player_release_video_path_fenced(
