+static void
+test_fast_worker_completion_deferral(void)
+{
+    struct fence_fixture fixture;
+    fence_fixture_init(&fixture);
+    libvlc_media_player_t *extra =
+        libvlc_media_player_retain(fixture.player);
+    atomic_store_explicit(&fixture.block_callback, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.block_worker, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.block_dispatcher, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.block_completion, true,
+                          memory_order_release);
+    fence_fixture_start_worker(&fixture);
+
+    struct fence_push_args admitted = {
+        .metrics = fixture.metrics,
+        .result = VLC_EGENERIC,
+    };
+    fence_init_event(&admitted.event, UINT64_C(0x55555555));
+    vlc_thread_t publisher;
+    assert(vlc_clone(&publisher, fence_push_thread, &admitted) == 0);
+    vlc_sem_wait(&fixture.callback_entered);
+
+    assert(libvlc_media_player_release_video_path_fenced(
+               fixture.player, fence_dispatch, &fixture, fence_complete,
+               &fixture, &fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    fixture.player = NULL;
+    vlc_sem_post(&fixture.callback_continue);
+    vlc_sem_wait(&fixture.dispatcher_entered);
+
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING);
+    assert(!libvlc_video_path_release_request_is_ready(fixture.observer));
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+
+    vlc_sem_post(&fixture.worker_continue);
+    vlc_sem_wait(&fixture.worker_done);
+    assert(atomic_load_explicit(&fixture.worker_result,
+                                memory_order_acquire) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_RELEASED);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 0);
+    assert(libvlc_video_path_release_request_execute(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+    assert(fixture.opaque_lifetime_canary == FENCE_TEST_CANARY);
+
+    vlc_sem_post(&fixture.dispatcher_continue);
+    vlc_sem_wait(&fixture.completion_entered);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_COMPLETING);
+    assert(libvlc_video_path_release_request_execute(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+
+    vlc_sem_post(&fixture.completion_continue);
+    vlc_join(publisher, NULL);
+    vlc_join(fixture.worker, NULL);
+    assert(admitted.result == VLC_SUCCESS);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 1);
+    assert(fixture.callback_userdata == NULL);
+    assert(atomic_load_explicit(&fixture.worker_return_order,
+                                memory_order_acquire) <
+           atomic_load_explicit(&fixture.completion_order,
+                                memory_order_acquire));
+
+    libvlc_video_path_release_request_release(fixture.observer);
+    libvlc_media_player_release(extra);
+    libvlc_release(fixture.instance);
+}
