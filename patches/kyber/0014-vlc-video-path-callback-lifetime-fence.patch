+static void
+test_duplicate_fenced_close(void)
+{
+    for (unsigned iteration = 0; iteration < 4; ++iteration)
+    {
+        struct fence_fixture fixture;
+        fence_fixture_init(&fixture);
+        vlc_sem_t ready;
+        vlc_sem_t go;
+        vlc_sem_init(&ready, 0);
+        vlc_sem_init(&go, 0);
+
+        struct fenced_close_args args[2] = {
+            {
+                .fixture = &fixture,
+                .player = fixture.player,
+                .ready = &ready,
+                .go = &go,
+                .result = LIBVLC_VIDEO_PATH_RELEASE_INVALID,
+                .request = NULL,
+            },
+            {
+                .fixture = &fixture,
+                .player = libvlc_media_player_retain(fixture.player),
+                .ready = &ready,
+                .go = &go,
+                .result = LIBVLC_VIDEO_PATH_RELEASE_INVALID,
+                .request = NULL,
+            },
+        };
+        fixture.player = NULL;
+
+        vlc_thread_t closers[2];
+        assert(vlc_clone(&closers[0], fenced_close_thread, &args[0]) == 0);
+        assert(vlc_clone(&closers[1], fenced_close_thread, &args[1]) == 0);
+        vlc_sem_wait(&ready);
+        vlc_sem_wait(&ready);
+        vlc_sem_post(&go);
+        vlc_sem_post(&go);
+        vlc_join(closers[0], NULL);
+        vlc_join(closers[1], NULL);
+
+        unsigned winner =
+            args[0].result == LIBVLC_VIDEO_PATH_RELEASE_OK ? 0 : 1;
+        unsigned loser = winner ^ 1u;
+        assert(args[winner].result == LIBVLC_VIDEO_PATH_RELEASE_OK);
+        assert(args[winner].request != NULL);
+        assert(args[loser].result ==
+               LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED);
+        assert(args[loser].request == NULL);
+        assert(libvlc_video_path_release_request_get_state(
+                   args[winner].request) ==
+               LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+        assert(atomic_load_explicit(&fixture.dispatch_calls,
+                                    memory_order_relaxed) == 0);
+        assert(atomic_load_explicit(&fixture.completion_calls,
+                                    memory_order_relaxed) == 1);
+        assert(fixture.callback_userdata == NULL);
+        libvlc_video_path_release_request_release(args[winner].request);
+        libvlc_release(fixture.instance);
+    }
+}
