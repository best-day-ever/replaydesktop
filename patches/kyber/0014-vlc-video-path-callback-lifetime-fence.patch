+    assert(fixture->opaque_lifetime_canary == FENCE_TEST_CANARY);
+    atomic_fetch_or_explicit(&fixture->opaque_observers, observer,
+                             memory_order_relaxed);
+}
+
+static int
+fence_callback(void *opaque,
+               const struct libvlc_video_path_event *events, size_t count)
+{
+    struct fence_callback_userdata *userdata = opaque;
+    assert(userdata != NULL);
+    assert(userdata->canary == FENCE_TEST_CANARY);
+    struct fence_fixture *fixture = userdata->fixture;
+    assert(events != NULL);
+    assert(count == 1);
+    fence_observe_opaque(fixture, FENCE_CANARY_CALLBACK);
+    atomic_fetch_add_explicit(&fixture->callback_calls, 1,
+                              memory_order_relaxed);
+    atomic_store_explicit(&fixture->callback_seq, events[0].producer_seq,
+                          memory_order_release);
+
+    if (atomic_load_explicit(&fixture->block_callback,
+                             memory_order_acquire))
+    {
+        vlc_sem_post(&fixture->callback_entered);
+        vlc_sem_wait(&fixture->callback_continue);
+    }
+
+    atomic_store_explicit(&fixture->callback_return_order,
+                          fence_stamp(fixture), memory_order_release);
+    return atomic_load_explicit(&fixture->callback_result,
+                                memory_order_acquire);
+}
+
+static bool
+fence_consume_rejection(struct fence_fixture *fixture)
+{
+    unsigned remaining = atomic_load_explicit(&fixture->reject_dispatches,
+                                               memory_order_acquire);
+    while (remaining != 0)
+    {
+        if (atomic_compare_exchange_weak_explicit(
+                &fixture->reject_dispatches, &remaining, remaining - 1,
+                memory_order_acq_rel, memory_order_acquire))
+            return true;
+    }
+    return false;
+}
+
+static int
+fence_dispatch(
+    void *opaque, libvlc_video_path_release_request_t *borrowed_request)
+{
+    struct fence_fixture *fixture = opaque;
+    assert(borrowed_request != NULL);
+    fence_observe_opaque(fixture, FENCE_CANARY_DISPATCH);
+    atomic_fetch_add_explicit(&fixture->dispatch_calls, 1,
+                              memory_order_relaxed);
+    atomic_store_explicit(&fixture->dispatch_order, fence_stamp(fixture),
+                          memory_order_release);
+    assert(atomic_load_explicit(&fixture->callback_return_order,
+                                memory_order_acquire) != 0);
+
+    if (atomic_load_explicit(&fixture->expect_loss_before_dispatch,
+                             memory_order_acquire))
+    {
+        struct vlc_video_path_loss_snapshot loss;
+        assert(vlc_metrics_video_path_loss_snapshot(fixture->metrics, &loss));
+        assert(loss.events == 1);
+        assert(loss.first_seq ==
+               atomic_load_explicit(&fixture->callback_seq,
+                                    memory_order_acquire));
+        assert(loss.last_seq == loss.first_seq);
+        assert(loss.generation == 1);
+    }
+
+    if (fence_consume_rejection(fixture))
+    {
+        atomic_fetch_add_explicit(&fixture->dispatch_rejections, 1,
+                                  memory_order_relaxed);
+        if (atomic_load_explicit(&fixture->block_dispatcher,
+                                 memory_order_acquire))
+        {
+            vlc_sem_post(&fixture->dispatcher_entered);
+            vlc_sem_wait(&fixture->dispatcher_continue);
+        }
+        return -1;
+    }
+
+    assert(fixture->worker_started);
+    libvlc_video_path_release_request_t *worker_handle =
+        libvlc_video_path_release_request_retain(borrowed_request);
+    assert(worker_handle != NULL);
+    libvlc_video_path_release_request_t *expected = NULL;
+    assert(atomic_compare_exchange_strong_explicit(
+        &fixture->queued, &expected, worker_handle,
+        memory_order_release, memory_order_relaxed));
+    atomic_fetch_add_explicit(&fixture->worker_transfers, 1,
+                              memory_order_relaxed);
+    vlc_sem_post(&fixture->queue_ready);
+
+    if (atomic_load_explicit(&fixture->block_dispatcher,
+                             memory_order_acquire))
+    {
+        vlc_sem_post(&fixture->dispatcher_entered);
+        vlc_sem_wait(&fixture->dispatcher_continue);
+    }
+    return 0;
+}
+
+static void
+fence_complete(void *opaque)
+{
+    struct fence_fixture *fixture = opaque;
+    fence_observe_opaque(fixture, FENCE_CANARY_COMPLETE);
+    atomic_fetch_add_explicit(&fixture->completion_calls, 1,
+                              memory_order_relaxed);
+    atomic_store_explicit(&fixture->completion_order, fence_stamp(fixture),
+                          memory_order_release);
+
+    if (atomic_load_explicit(&fixture->block_completion,
+                             memory_order_acquire))
+    {
+        vlc_sem_post(&fixture->completion_entered);
+        vlc_sem_wait(&fixture->completion_continue);
+    }
+
+    struct fence_callback_userdata *userdata = fixture->callback_userdata;
+    assert(userdata != NULL);
+    assert(userdata->canary == FENCE_TEST_CANARY);
+    userdata->canary = 0;
+    free(userdata);
+    fixture->callback_userdata = NULL;
+    atomic_store_explicit(&fixture->userdata_retirement_order,
+                          fence_stamp(fixture), memory_order_release);
+}
+
+static void *
+fence_worker(void *opaque)
+{
+    struct fence_fixture *fixture = opaque;
+    vlc_sem_wait(&fixture->queue_ready);
+    libvlc_video_path_release_request_t *request =
+        atomic_exchange_explicit(&fixture->queued, NULL,
+                                 memory_order_acq_rel);
+    if (request == NULL)
+    {
+        assert(atomic_load_explicit(&fixture->worker_shutdown,
+                                    memory_order_acquire));
+        vlc_sem_post(&fixture->worker_done);
+        return NULL;
+    }
+
+    if (atomic_load_explicit(&fixture->block_worker, memory_order_acquire))
+        vlc_sem_wait(&fixture->worker_continue);
+
+    fence_observe_opaque(fixture, FENCE_CANARY_WORKER);
+    atomic_fetch_add_explicit(&fixture->worker_execute_calls, 1,
+                              memory_order_relaxed);
+    atomic_store_explicit(&fixture->worker_order, fence_stamp(fixture),
+                          memory_order_release);
+    libvlc_video_path_release_result_t result =
+        libvlc_video_path_release_request_execute(request);
+    atomic_store_explicit(&fixture->worker_result, result,
+                          memory_order_release);
+    atomic_store_explicit(&fixture->worker_return_order,
+                          fence_stamp(fixture), memory_order_release);
+    libvlc_video_path_release_request_release(request);
+    vlc_sem_post(&fixture->worker_done);
+    return NULL;
+}
+
+static void
+fence_fixture_init(struct fence_fixture *fixture)
+{
+    memset(fixture, 0, sizeof(*fixture));
+    atomic_init(&fixture->queued, NULL);
+    atomic_init(&fixture->block_callback, false);
+    atomic_init(&fixture->block_worker, false);
+    atomic_init(&fixture->block_dispatcher, false);
+    atomic_init(&fixture->block_completion, false);
+    atomic_init(&fixture->expect_loss_before_dispatch, false);
+    atomic_init(&fixture->worker_shutdown, false);
+    atomic_init(&fixture->callback_result, 0);
+    atomic_init(&fixture->reject_dispatches, 0);
+    atomic_init(&fixture->callback_calls, 0);
+    atomic_init(&fixture->dispatch_calls, 0);
+    atomic_init(&fixture->dispatch_rejections, 0);
+    atomic_init(&fixture->worker_transfers, 0);
+    atomic_init(&fixture->worker_execute_calls, 0);
+    atomic_init(&fixture->completion_calls, 0);
+    atomic_init(&fixture->opaque_observers, 0);
+    atomic_init(&fixture->order_clock, 0);
+    atomic_init(&fixture->callback_return_order, 0);
+    atomic_init(&fixture->dispatch_order, 0);
+    atomic_init(&fixture->worker_order, 0);
+    atomic_init(&fixture->worker_return_order, 0);
+    atomic_init(&fixture->completion_order, 0);
+    atomic_init(&fixture->userdata_retirement_order, 0);
+    atomic_init(&fixture->callback_seq, 0);
+    atomic_init(&fixture->worker_result,
+                LIBVLC_VIDEO_PATH_RELEASE_INVALID);
+    fixture->opaque_lifetime_canary = FENCE_TEST_CANARY;
+
+    vlc_sem_init(&fixture->callback_entered, 0);
+    vlc_sem_init(&fixture->callback_continue, 0);
+    vlc_sem_init(&fixture->queue_ready, 0);
+    vlc_sem_init(&fixture->worker_continue, 0);
+    vlc_sem_init(&fixture->worker_done, 0);
+    vlc_sem_init(&fixture->dispatcher_entered, 0);
+    vlc_sem_init(&fixture->dispatcher_continue, 0);
+    vlc_sem_init(&fixture->completion_entered, 0);
+    vlc_sem_init(&fixture->completion_continue, 0);
+
+    fixture->instance = libvlc_new(0, NULL);
+    assert(fixture->instance != NULL);
+    fixture->player = libvlc_media_player_new(fixture->instance);
+    assert(fixture->player != NULL);
+    fixture->callback_userdata = malloc(sizeof(*fixture->callback_userdata));
+    assert(fixture->callback_userdata != NULL);
+    fixture->callback_userdata->fixture = fixture;
+    fixture->callback_userdata->canary = FENCE_TEST_CANARY;
+    assert(libvlc_media_player_set_video_path_callback(
+               fixture->player, fence_callback,
+               fixture->callback_userdata) == VLC_SUCCESS);
+    fixture->metrics =
+        var_GetAddress((vlc_object_t *) fixture->player->player,
+                       "kyber-metrics");
+    assert(fixture->metrics != NULL);
+}
+
+static void
+fence_fixture_start_worker(struct fence_fixture *fixture)
+{
+    assert(!fixture->worker_started);
+    fixture->worker_started = true;
+    assert(vlc_clone(&fixture->worker, fence_worker, fixture) == 0);
+}
+
+static void
+fence_fixture_stop_idle_worker(struct fence_fixture *fixture)
+{
+    assert(fixture->worker_started);
+    assert(atomic_load_explicit(&fixture->queued,
+                                memory_order_acquire) == NULL);
+    atomic_store_explicit(&fixture->worker_shutdown, true,
+                          memory_order_release);
+    vlc_sem_post(&fixture->queue_ready);
+    vlc_sem_wait(&fixture->worker_done);
+    vlc_join(fixture->worker, NULL);
+}
+
+struct fence_push_args {
+    struct vlc_metrics *metrics;
+    vlc_video_path_event event;
+    int result;
+};
+
+static void *
+fence_push_thread(void *opaque)
+{
+    struct fence_push_args *args = opaque;
+    args->result = vlc_metrics_PushVideoPath(args->metrics, &args->event);
+    return NULL;
+}
+
+static void
+fence_init_event(vlc_video_path_event *event, uint64_t sentinel)
+{
+    vlc_video_path_event_Init(
+        event, LIBVLC_VIDEO_PATH_EVENT_VIDEOTOOLBOX_FRAME, false, 0);
+    event->producer_seq = sentinel;
+}
+
+static void
+test_zero_active_synchronous_fence(void)
+{
+    struct fence_fixture fixture;
+    fence_fixture_init(&fixture);
+
+    assert(libvlc_video_path_release_request_retain(NULL) == NULL);
+    libvlc_video_path_release_request_release(NULL);
+    assert(libvlc_video_path_release_request_redispatch(NULL) ==
+           LIBVLC_VIDEO_PATH_RELEASE_INVALID);
+    assert(libvlc_video_path_release_request_execute(NULL) ==
+           LIBVLC_VIDEO_PATH_RELEASE_INVALID);
+
+    libvlc_video_path_release_request_t *invalid =
+        (libvlc_video_path_release_request_t *) (uintptr_t) 1;
+    assert(libvlc_media_player_release_video_path_fenced(
+               fixture.player, NULL, &fixture, fence_complete, &fixture,
+               &invalid) == LIBVLC_VIDEO_PATH_RELEASE_INVALID);
+    assert(invalid == NULL);
+
+    libvlc_media_player_t *extra =
+        libvlc_media_player_retain(fixture.player);
+    fixture.observer =
+        (libvlc_video_path_release_request_t *) (uintptr_t) 1;
+    assert(libvlc_media_player_release_video_path_fenced(
+               fixture.player, fence_dispatch, &fixture, fence_complete,
+               &fixture, &fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    fixture.player = NULL;
+
+    assert(fixture.observer != NULL);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+    assert(!libvlc_video_path_release_request_is_ready(fixture.observer));
+    assert(atomic_load_explicit(&fixture.dispatch_calls,
+                                memory_order_relaxed) == 0);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 1);
+    assert(fixture.callback_userdata == NULL);
+    assert(atomic_load_explicit(&fixture.userdata_retirement_order,
+                                memory_order_acquire) != 0);
+    assert(atomic_load_explicit(&fixture.opaque_observers,
+                                memory_order_relaxed) ==
+           FENCE_CANARY_COMPLETE);
+
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED);
+    assert(libvlc_video_path_release_request_execute(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED);
+    assert(libvlc_media_player_set_video_path_callback(
+               extra, fence_callback, &fixture) != VLC_SUCCESS);
+
+    vlc_video_path_event denied;
+    fence_init_event(&denied, UINT64_C(0xfeedface));
+    assert(vlc_metrics_PushVideoPath(fixture.metrics, &denied) ==
+           VLC_SUCCESS);
+    assert(denied.producer_seq == UINT64_C(0xfeedface));
+    assert(atomic_load_explicit(&fixture.callback_calls,
+                                memory_order_relaxed) == 0);
+
+    libvlc_media_player_t *loser = libvlc_media_player_retain(extra);
+    libvlc_video_path_release_request_t *loser_request =
+        (libvlc_video_path_release_request_t *) (uintptr_t) 1;
+    assert(libvlc_media_player_release_video_path_fenced(
+               loser, fence_dispatch, &fixture, fence_complete, &fixture,
+               &loser_request) ==
+           LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED);
+    assert(loser_request == NULL);
+    libvlc_media_player_release(loser);
+
+    libvlc_video_path_release_request_release(fixture.observer);
+    libvlc_media_player_release(extra);
+    libvlc_release(fixture.instance);
+}
