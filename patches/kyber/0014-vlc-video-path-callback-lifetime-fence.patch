+static void
+test_admission_close_contention(void)
+{
+    for (unsigned iteration = 0; iteration < 16; ++iteration)
+    {
+        struct fence_fixture fixture;
+        fence_fixture_init(&fixture);
+        libvlc_media_player_t *extra =
+            libvlc_media_player_retain(fixture.player);
+        fence_fixture_start_worker(&fixture);
+
+        vlc_sem_t ready;
+        vlc_sem_t go;
+        vlc_sem_init(&ready, 0);
+        vlc_sem_init(&go, 0);
+        struct fenced_close_args closer = {
+            .fixture = &fixture,
+            .player = fixture.player,
+            .ready = &ready,
+            .go = &go,
+            .result = LIBVLC_VIDEO_PATH_RELEASE_INVALID,
+            .request = NULL,
+        };
+        struct fence_race_push_args publisher = {
+            .push = {
+                .metrics = fixture.metrics,
+                .result = VLC_EGENERIC,
+            },
+            .ready = &ready,
+            .go = &go,
+        };
+        fence_init_event(&publisher.push.event,
+                         UINT64_C(0x77777777));
+
+        vlc_thread_t close_thread;
+        vlc_thread_t publish_thread;
+        assert(vlc_clone(&close_thread, fenced_close_thread,
+                         &closer) == 0);
+        assert(vlc_clone(&publish_thread, fence_race_push_thread,
+                         &publisher) == 0);
+        vlc_sem_wait(&ready);
+        vlc_sem_wait(&ready);
+        vlc_sem_post(&go);
+        vlc_sem_post(&go);
+        vlc_join(close_thread, NULL);
+        vlc_join(publish_thread, NULL);
+        fixture.player = NULL;
+
+        assert(closer.result == LIBVLC_VIDEO_PATH_RELEASE_OK);
+        assert(closer.request != NULL);
+        assert(publisher.push.result == VLC_SUCCESS);
+        unsigned callback_calls =
+            atomic_load_explicit(&fixture.callback_calls,
+                                 memory_order_relaxed);
+        assert(callback_calls <= 1);
+        if (callback_calls == 0)
+            assert(publisher.push.event.producer_seq ==
+                   UINT64_C(0x77777777));
+        else
+            assert(publisher.push.event.producer_seq == 1);
+
+        unsigned dispatch_calls =
+            atomic_load_explicit(&fixture.dispatch_calls,
+                                 memory_order_relaxed);
+        assert(dispatch_calls <= 1);
+        if (dispatch_calls == 0)
+            fence_fixture_stop_idle_worker(&fixture);
+        else
+        {
+            vlc_sem_wait(&fixture.worker_done);
+            vlc_join(fixture.worker, NULL);
+            assert(atomic_load_explicit(&fixture.worker_result,
+                                        memory_order_acquire) ==
+                   LIBVLC_VIDEO_PATH_RELEASE_OK);
+        }
+        assert(atomic_load_explicit(&fixture.worker_transfers,
+                                    memory_order_relaxed) ==
+               dispatch_calls);
+        assert(atomic_load_explicit(&fixture.completion_calls,
+                                    memory_order_relaxed) == 1);
+        assert(libvlc_video_path_release_request_get_state(
+                   closer.request) ==
+               LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+        assert(fixture.callback_userdata == NULL);
+
+        vlc_video_path_event denied;
+        fence_init_event(&denied, UINT64_C(0x88888888));
+        assert(vlc_metrics_PushVideoPath(fixture.metrics, &denied) ==
+               VLC_SUCCESS);
+        assert(denied.producer_seq == UINT64_C(0x88888888));
+        assert(atomic_load_explicit(&fixture.callback_calls,
+                                    memory_order_relaxed) ==
+               callback_calls);
+        struct vlc_video_path_loss_snapshot loss;
+        assert(vlc_metrics_video_path_loss_snapshot(
+            fixture.metrics, &loss));
+        assert(loss.events == 0);
+        assert(loss.first_seq == 0);
+        assert(loss.last_seq == 0);
+        assert(loss.generation == 0);
+
+        libvlc_video_path_release_request_release(closer.request);
+        libvlc_media_player_release(extra);
+        libvlc_release(fixture.instance);
+    }
+}
