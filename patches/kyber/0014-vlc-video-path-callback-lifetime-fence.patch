+#include "../src/misc/metrics.h"

 #define ES_INIT (-2) /* -1 is reserved for ES deselect */

+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN == 0,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_READY == 1,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING == 2,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED == 3,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_EXECUTING == 4,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_RELEASED == 5,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_COMPLETING == 6,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_COMPLETE == 7,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_OK == 0,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_INVALID == -1,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_NO_MEMORY == -2,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED == -3,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_NOT_READY == -4,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_BUSY == -5,
+               "video-path release ABI drift");
+_Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCH_REJECTED == -6,
+               "video-path release ABI drift");
+
+struct libvlc_video_path_release_request_t {
+    vlc_atomic_rc_t rc;
+    atomic_int state;
+    atomic_uint dispatcher_in_flight;
+    _Atomic(libvlc_media_player_t *) player;
+    libvlc_video_path_release_dispatch_cb dispatch;
+    void *dispatch_opaque;
+    libvlc_video_path_release_complete_cb complete;
+    void *complete_opaque;
+};
+
+/* O, H, D, W and X all use this one intrusive request reference count. */
+static void
+video_path_release_request_pin(libvlc_video_path_release_request_t *request)
+{
+    vlc_atomic_rc_inc(&request->rc);
+}
+
+static void
+video_path_release_request_drop(libvlc_video_path_release_request_t *request)
+{
+    if (vlc_atomic_rc_dec(&request->rc))
+        free(request);
+}
+
+static libvlc_video_path_release_result_t
+video_path_release_redispatch_result(int state)
+{
+    switch ((libvlc_video_path_release_state_t) state)
+    {
+        case LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN:
+            return LIBVLC_VIDEO_PATH_RELEASE_NOT_READY;
+        case LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING:
+        case LIBVLC_VIDEO_PATH_RELEASE_EXECUTING:
+        case LIBVLC_VIDEO_PATH_RELEASE_RELEASED:
+        case LIBVLC_VIDEO_PATH_RELEASE_COMPLETING:
+            return LIBVLC_VIDEO_PATH_RELEASE_BUSY;
+        case LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED:
+        case LIBVLC_VIDEO_PATH_RELEASE_COMPLETE:
+            return LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED;
+        case LIBVLC_VIDEO_PATH_RELEASE_READY:
+            return LIBVLC_VIDEO_PATH_RELEASE_OK;
+    }
+    return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+}
+
+static libvlc_video_path_release_result_t
+video_path_release_execute_result(int state)
+{
+    switch ((libvlc_video_path_release_state_t) state)
+    {
+        case LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN:
+            return LIBVLC_VIDEO_PATH_RELEASE_NOT_READY;
+        case LIBVLC_VIDEO_PATH_RELEASE_EXECUTING:
+        case LIBVLC_VIDEO_PATH_RELEASE_RELEASED:
+        case LIBVLC_VIDEO_PATH_RELEASE_COMPLETING:
+            return LIBVLC_VIDEO_PATH_RELEASE_BUSY;
+        case LIBVLC_VIDEO_PATH_RELEASE_COMPLETE:
+            return LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED;
+        case LIBVLC_VIDEO_PATH_RELEASE_READY:
+        case LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING:
+        case LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED:
+            return LIBVLC_VIDEO_PATH_RELEASE_OK;
+    }
+    return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+}
+
+/*
+ * O is dropped only by the one completion winner.  The caller of this helper
+ * always holds D or X, so storage remains live after the lifecycle drop.
+ */
+static void
+video_path_release_request_complete_if_ready(
+    libvlc_video_path_release_request_t *request)
+{
+    if (atomic_load_explicit(&request->dispatcher_in_flight,
+                             memory_order_acquire) != 0)
+        return;
+
+    int expected = LIBVLC_VIDEO_PATH_RELEASE_RELEASED;
+    if (!atomic_compare_exchange_strong_explicit(
+            &request->state, &expected,
+            LIBVLC_VIDEO_PATH_RELEASE_COMPLETING,
+            memory_order_acq_rel, memory_order_acquire))
+        return;
+
+    request->complete(request->complete_opaque);
+    atomic_store_explicit(&request->state,
+                          LIBVLC_VIDEO_PATH_RELEASE_COMPLETE,
+                          memory_order_release);
+    video_path_release_request_drop(request); /* O */
+}
+
+static libvlc_video_path_release_result_t
+video_path_release_request_dispatch(
+    libvlc_video_path_release_request_t *request)
+{
+    video_path_release_request_pin(request); /* D */
+    atomic_fetch_add_explicit(&request->dispatcher_in_flight, 1,
+                              memory_order_acq_rel);
+
+    int expected = LIBVLC_VIDEO_PATH_RELEASE_READY;
+    if (!atomic_compare_exchange_strong_explicit(
+            &request->state, &expected,
+            LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING,
+            memory_order_acq_rel, memory_order_acquire))
+    {
+        libvlc_video_path_release_result_t result =
+            video_path_release_redispatch_result(expected);
+        atomic_fetch_sub_explicit(&request->dispatcher_in_flight, 1,
+                                  memory_order_acq_rel);
+        video_path_release_request_complete_if_ready(request);
+        video_path_release_request_drop(request); /* D */
+        return result;
+    }
+
+    int dispatch_result =
+        request->dispatch(request->dispatch_opaque, request);
+    libvlc_video_path_release_result_t result;
+
+    expected = LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING;
+    if (dispatch_result == 0)
+    {
+        if (!atomic_compare_exchange_strong_explicit(
+                &request->state, &expected,
+                LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED,
+                memory_order_release, memory_order_acquire))
+        {
+            /* A fast W/X execute winner owns every newer state. */
+        }
+        result = LIBVLC_VIDEO_PATH_RELEASE_OK;
+    }
+    else if (atomic_compare_exchange_strong_explicit(
+                 &request->state, &expected,
+                 LIBVLC_VIDEO_PATH_RELEASE_READY,
+                 memory_order_release, memory_order_acquire))
+        result = LIBVLC_VIDEO_PATH_RELEASE_DISPATCH_REJECTED;
+    else
+        result = video_path_release_redispatch_result(expected);
+
+    atomic_fetch_sub_explicit(&request->dispatcher_in_flight, 1,
+                              memory_order_acq_rel);
+    video_path_release_request_complete_if_ready(request);
+    video_path_release_request_drop(request); /* D */
+    return result;
+}
+
+static void
+video_path_release_request_drained(void *opaque)
+{
+    libvlc_video_path_release_request_t *request = opaque;
+    atomic_store_explicit(&request->state,
+                          LIBVLC_VIDEO_PATH_RELEASE_READY,
+                          memory_order_release);
+
+    if (vlc_video_path_publisher_depth() != 0)
+        (void) video_path_release_request_dispatch(request);
+    else
+        (void) libvlc_video_path_release_request_execute(request);
+}
