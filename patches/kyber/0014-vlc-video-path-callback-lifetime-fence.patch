+    assert(libvlc_video_path_release_request_is_ready(retry));
+
+    assert(libvlc_video_path_release_request_redispatch(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_DISPATCH_REJECTED);
+    assert(libvlc_video_path_release_request_get_state(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_READY);
+    assert(libvlc_video_path_release_request_is_ready(retry));
+    assert(atomic_load_explicit(&fixture.dispatch_rejections,
+                                memory_order_relaxed) == 2);
+    assert(atomic_load_explicit(&fixture.worker_transfers,
+                                memory_order_relaxed) == 0);
+
+    assert(libvlc_video_path_release_request_redispatch(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    assert(libvlc_video_path_release_request_get_state(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED);
+    assert(!libvlc_video_path_release_request_is_ready(retry));
+    assert(libvlc_video_path_release_request_redispatch(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED);
+    assert(atomic_load_explicit(&fixture.worker_transfers,
+                                memory_order_relaxed) == 1);
+
+    vlc_sem_post(&fixture.worker_continue);
+    vlc_sem_wait(&fixture.worker_done);
+    vlc_join(fixture.worker, NULL);
+    assert(atomic_load_explicit(&fixture.worker_result,
+                                memory_order_acquire) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    assert(libvlc_video_path_release_request_get_state(retry) ==
+           LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 1);
+    assert(fixture.callback_userdata == NULL);
+    libvlc_video_path_release_request_release(retry);
+    libvlc_release(fixture.instance);
+}
