+struct fenced_close_args {
+    struct fence_fixture *fixture;
+    libvlc_media_player_t *player;
+    vlc_sem_t *ready;
+    vlc_sem_t *go;
+    libvlc_video_path_release_result_t result;
+    libvlc_video_path_release_request_t *request;
+};
+
+static void *
+fenced_close_thread(void *opaque)
+{
+    struct fenced_close_args *args = opaque;
+    vlc_sem_post(args->ready);
+    vlc_sem_wait(args->go);
+    args->request =
+        (libvlc_video_path_release_request_t *) (uintptr_t) 1;
+    args->result = libvlc_media_player_release_video_path_fenced(
+        args->player, fence_dispatch, args->fixture, fence_complete,
+        args->fixture, &args->request);
+    if (args->result != LIBVLC_VIDEO_PATH_RELEASE_OK)
+        libvlc_media_player_release(args->player);
+    return NULL;
+}
