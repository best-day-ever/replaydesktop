+static void
+test_executing_state_and_duplicate_execute(void)
+{
+    struct fence_fixture fixture;
+    fence_fixture_init(&fixture);
+    atomic_store_explicit(&fixture.block_callback, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.reject_dispatches, 1,
+                          memory_order_release);
+
+    struct fence_push_args admitted = {
+        .metrics = fixture.metrics,
+        .result = VLC_EGENERIC,
+    };
+    fence_init_event(&admitted.event, UINT64_C(0x66666666));
+    vlc_thread_t publisher;
+    assert(vlc_clone(&publisher, fence_push_thread, &admitted) == 0);
+    vlc_sem_wait(&fixture.callback_entered);
+
+    vlc_player_t *core_player = fixture.player->player;
+    assert(libvlc_media_player_release_video_path_fenced(
+               fixture.player, fence_dispatch, &fixture, fence_complete,
+               &fixture, &fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    fixture.player = NULL;
+    vlc_sem_post(&fixture.callback_continue);
+    vlc_join(publisher, NULL);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_READY);
+
+    vlc_player_Lock(core_player);
+    vlc_sem_t execute_started;
+    vlc_sem_init(&execute_started, 0);
+    struct fenced_execute_args execute = {
+        .request =
+            libvlc_video_path_release_request_retain(fixture.observer),
+        .started = &execute_started,
+        .result = LIBVLC_VIDEO_PATH_RELEASE_INVALID,
+    };
+    vlc_thread_t executor;
+    assert(vlc_clone(&executor, fenced_execute_thread, &execute) == 0);
+    vlc_sem_wait(&execute_started);
+
+    libvlc_video_path_release_state_t state =
+        LIBVLC_VIDEO_PATH_RELEASE_READY;
+    while (state != LIBVLC_VIDEO_PATH_RELEASE_EXECUTING)
+    {
+        state =
+            libvlc_video_path_release_request_get_state(fixture.observer);
+        if (state != LIBVLC_VIDEO_PATH_RELEASE_EXECUTING)
+        {
+            assert(state == LIBVLC_VIDEO_PATH_RELEASE_READY);
+            sched_yield();
+        }
+    }
+    assert(state == LIBVLC_VIDEO_PATH_RELEASE_EXECUTING);
+    assert(!libvlc_video_path_release_request_is_ready(fixture.observer));
+    assert(libvlc_video_path_release_request_execute(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+
+    vlc_player_Unlock(core_player);
+    vlc_join(executor, NULL);
+    assert(execute.result == LIBVLC_VIDEO_PATH_RELEASE_OK);
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_COMPLETE);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 1);
+    assert(fixture.callback_userdata == NULL);
+    libvlc_video_path_release_request_release(fixture.observer);
+    libvlc_release(fixture.instance);
+}
