+libvlc_video_path_release_request_t *
+libvlc_video_path_release_request_retain(
+    libvlc_video_path_release_request_t *request)
+{
+    if (request != NULL)
+        video_path_release_request_pin(request);
+    return request;
+}
+
+void
+libvlc_video_path_release_request_release(
+    libvlc_video_path_release_request_t *request)
+{
+    if (request != NULL)
+        video_path_release_request_drop(request);
+}
+
+libvlc_video_path_release_state_t
+libvlc_video_path_release_request_get_state(
+    const libvlc_video_path_release_request_t *request)
+{
+    assert(request != NULL);
+    libvlc_video_path_release_request_t *mutable_request =
+        (libvlc_video_path_release_request_t *) request;
+    video_path_release_request_pin(mutable_request); /* X */
+    int state = atomic_load_explicit(&request->state, memory_order_acquire);
+    video_path_release_request_drop(mutable_request); /* X */
+    return (libvlc_video_path_release_state_t) state;
+}
+
+bool
+libvlc_video_path_release_request_is_ready(
+    const libvlc_video_path_release_request_t *request)
+{
+    assert(request != NULL);
+    libvlc_video_path_release_request_t *mutable_request =
+        (libvlc_video_path_release_request_t *) request;
+    video_path_release_request_pin(mutable_request); /* X */
+    bool ready = atomic_load_explicit(&request->state, memory_order_acquire) ==
+                 LIBVLC_VIDEO_PATH_RELEASE_READY;
+    video_path_release_request_drop(mutable_request); /* X */
+    return ready;
+}
+
+libvlc_video_path_release_result_t
+libvlc_video_path_release_request_redispatch(
+    libvlc_video_path_release_request_t *request)
+{
+    if (request == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+    return video_path_release_request_dispatch(request);
+}
+
+libvlc_video_path_release_result_t
+libvlc_video_path_release_request_execute(
+    libvlc_video_path_release_request_t *request)
+{
+    if (request == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+
+    video_path_release_request_pin(request); /* X */
+    libvlc_video_path_release_result_t result;
+
+    if (vlc_video_path_publisher_depth() != 0)
+    {
+        result = LIBVLC_VIDEO_PATH_RELEASE_BUSY;
+        goto out;
+    }
+
+    int state = atomic_load_explicit(&request->state, memory_order_acquire);
+    for (;;)
+    {
+        result = video_path_release_execute_result(state);
+        if (result != LIBVLC_VIDEO_PATH_RELEASE_OK)
+            goto out;
+
+        int expected = state;
+        if (atomic_compare_exchange_strong_explicit(
+                &request->state, &expected,
+                LIBVLC_VIDEO_PATH_RELEASE_EXECUTING,
+                memory_order_acq_rel, memory_order_acquire))
+            break;
+        state = expected;
+    }
+
+    libvlc_media_player_t *player =
+        atomic_exchange_explicit(&request->player, NULL,
+                                 memory_order_acq_rel);
+    assert(player != NULL);
+    libvlc_media_player_release(player);
+    atomic_store_explicit(&request->state,
+                          LIBVLC_VIDEO_PATH_RELEASE_RELEASED,
+                          memory_order_release);
+    video_path_release_request_complete_if_ready(request);
+    result = LIBVLC_VIDEO_PATH_RELEASE_OK;
+
+out:
+    video_path_release_request_drop(request); /* X */
+    return result;
+}
+
+libvlc_video_path_release_result_t
+libvlc_media_player_release_video_path_fenced(
+    libvlc_media_player_t *mp,
+    libvlc_video_path_release_dispatch_cb dispatch,
+    void *dispatch_opaque,
+    libvlc_video_path_release_complete_cb complete,
+    void *complete_opaque,
+    libvlc_video_path_release_request_t **out_request)
+{
+    if (out_request == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+    *out_request = NULL;
+
+    if (mp == NULL || dispatch == NULL || complete == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+
+    struct vlc_video_path_callback_registration *registration =
+        atomic_load_explicit(&mp->video_path_registration,
+                             memory_order_acquire);
+    if (registration == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_INVALID;
+
+    libvlc_video_path_release_request_t *request =
+        malloc(sizeof(*request));
+    if (request == NULL)
+        return LIBVLC_VIDEO_PATH_RELEASE_NO_MEMORY;
+
+    vlc_atomic_rc_init(&request->rc); /* construction reference becomes O */
+    atomic_init(&request->state,
+                LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN);
+    atomic_init(&request->dispatcher_in_flight, 0);
+    atomic_init(&request->player, NULL);
+    request->dispatch = dispatch;
+    request->dispatch_opaque = dispatch_opaque;
+    request->complete = complete;
+    request->complete_opaque = complete_opaque;
+
+    if (!vlc_video_path_callback_registration_TryClaimClose(registration))
+    {
+        video_path_release_request_drop(request);
+        return LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED;
+    }
+
+    /*
+     * The close winner establishes O + H and transfers mp ownership before
+     * the no-fail CLOSED publication.  No operation after this point allocates
+     * or can return a fenced-close failure.
+     */
+    atomic_store_explicit(&request->player, mp, memory_order_relaxed);
+    video_path_release_request_pin(request); /* H */
+    *out_request = request;
+
+    vlc_video_path_callback_registration_PublishClosed(
+        registration, video_path_release_request_drained, request);
+    return LIBVLC_VIDEO_PATH_RELEASE_OK;
+}
