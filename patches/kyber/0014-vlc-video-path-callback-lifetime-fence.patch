+/**
+ * Opaque video-path callback release request.
+ *
+ * A request owns the one media-player reference consumed by a successful
+ * fenced release until exactly one execute operation releases it. Request
+ * references are independent of media-player references.
+ */
+typedef struct libvlc_video_path_release_request_t
+    libvlc_video_path_release_request_t;
+
+typedef enum libvlc_video_path_release_state_t {
+    LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN = 0,
+    LIBVLC_VIDEO_PATH_RELEASE_READY = 1,
+    LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING = 2,
+    LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED = 3,
+    LIBVLC_VIDEO_PATH_RELEASE_EXECUTING = 4,
+    LIBVLC_VIDEO_PATH_RELEASE_RELEASED = 5,
+    LIBVLC_VIDEO_PATH_RELEASE_COMPLETING = 6,
+    LIBVLC_VIDEO_PATH_RELEASE_COMPLETE = 7,
+} libvlc_video_path_release_state_t;
+
+typedef enum libvlc_video_path_release_result_t {
+    LIBVLC_VIDEO_PATH_RELEASE_OK = 0,
+    LIBVLC_VIDEO_PATH_RELEASE_INVALID = -1,
+    LIBVLC_VIDEO_PATH_RELEASE_NO_MEMORY = -2,
+    LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED = -3,
+    LIBVLC_VIDEO_PATH_RELEASE_NOT_READY = -4,
+    LIBVLC_VIDEO_PATH_RELEASE_BUSY = -5,
+    LIBVLC_VIDEO_PATH_RELEASE_DISPATCH_REJECTED = -6,
+} libvlc_video_path_release_result_t;
+
+/**
+ * Schedule a ready request on a caller-owned control worker.
+ *
+ * The request is borrowed for the duration of this callback. Returning zero
+ * means the callback retained a worker handle before enqueue and transferred
+ * it to work that will call libvlc_video_path_release_request_execute().
+ * Returning nonzero rejects the handoff and transfers no handle.
+ *
+ * This callback can run from the last publisher's epilogue. It must be
+ * nonblocking and publisher-safe, and must not execute the request inline.
+ */
+typedef int (*libvlc_video_path_release_dispatch_cb)(
+    void *opaque,
+    libvlc_video_path_release_request_t *borrowed_request);
+
+/**
+ * Report lifetime-fence completion.
+ *
+ * Completion proves callback userdata is unreachable, the consumed ordinary
+ * media-player release returned, and the dispatcher callback returned. It
+ * does not prove that the player was destroyed, telemetry ended cleanly, or
+ * any remote peer received data.
+ *
+ * Completion can run on the executing control thread or on the
+ * dispatcher-return path, including the last publisher thread. It must
+ * therefore be nonblocking and safe in either context.
+ */
+typedef void (*libvlc_video_path_release_complete_cb)(void *opaque);
+
+/**
+ * Close video-path callback admission and consume one media-player reference.
+ *
+ * This requires a video-path callback previously installed on \p mp. On
+ * success exactly the reference passed as \p mp is consumed and one
+ * caller-owned request handle is written to \p out_request. On every failure
+ * \p out_request is set to NULL and \p mp remains owned by the caller.
+ *
+ * With no active publisher, release and completion run synchronously on the
+ * initiating control thread before this function returns. With an active
+ * publisher, this function never waits; the last publisher invokes the
+ * nonblocking dispatcher, and a pre-existing control worker must execute the
+ * request. If that worker releases before the dispatcher returns, the last
+ * publisher can also invoke the nonblocking completion callback.
+ */
+LIBVLC_API libvlc_video_path_release_result_t
+libvlc_media_player_release_video_path_fenced(
+    libvlc_media_player_t *mp,
+    libvlc_video_path_release_dispatch_cb dispatch,
+    void *dispatch_opaque,
+    libvlc_video_path_release_complete_cb complete,
+    void *complete_opaque,
+    libvlc_video_path_release_request_t **out_request);
+
+/**
+ * Retain an independent observer, retry, or queue/worker handle.
+ *
+ * The internal lifecycle reference keeps a consumed player reference safe
+ * even if the returned observer is released immediately. It does not create
+ * a retry actor: before an accepted dispatch, a control subsystem that needs
+ * rejection recovery must retain or receive a distinct retry handle.
+ */
+LIBVLC_API libvlc_video_path_release_request_t *
+libvlc_video_path_release_request_retain(
+    libvlc_video_path_release_request_t *request);
+
+/**
+ * Release one request handle.
+ *
+ * The same handle must not be released concurrently with another operation
+ * that uses it. Distinct retained handles may be released independently.
+ */
+LIBVLC_API void libvlc_video_path_release_request_release(
+    libvlc_video_path_release_request_t *request);
+
+/** Acquire and return the request's current stable state. */
+LIBVLC_API libvlc_video_path_release_state_t
+libvlc_video_path_release_request_get_state(
+    const libvlc_video_path_release_request_t *request);
+
+/** Return true only when an acquire load observes the READY retry state. */
+LIBVLC_API bool libvlc_video_path_release_request_is_ready(
+    const libvlc_video_path_release_request_t *request);
+
+/**
+ * Retry the caller dispatcher from READY.
+ *
+ * Dispatch rejection restores READY only if no execute operation advanced the
+ * request. A nonzero dispatcher result transfers no queue/worker handle.
+ */
+LIBVLC_API libvlc_video_path_release_result_t
+libvlc_video_path_release_request_redispatch(
+    libvlc_video_path_release_request_t *request);
+
+/**
+ * Release the consumed player reference from a safe control context.
+ *
+ * Exactly one READY, DISPATCHING, or DISPATCHED caller can win. Calls from a
+ * video-path publisher are rejected as BUSY without changing state.
+ */
+LIBVLC_API libvlc_video_path_release_result_t
+libvlc_video_path_release_request_execute(
+    libvlc_video_path_release_request_t *request);
