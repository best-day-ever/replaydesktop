+static void
+test_admitted_close_denied_and_loss(void)
+{
+    struct fence_fixture fixture;
+    fence_fixture_init(&fixture);
+    libvlc_media_player_t *extra =
+        libvlc_media_player_retain(fixture.player);
+    atomic_store_explicit(&fixture.block_callback, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.block_worker, true,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.callback_result, -1,
+                          memory_order_release);
+    atomic_store_explicit(&fixture.expect_loss_before_dispatch, true,
+                          memory_order_release);
+    fence_fixture_start_worker(&fixture);
+
+    struct fence_push_args admitted = {
+        .metrics = fixture.metrics,
+        .result = VLC_EGENERIC,
+    };
+    fence_init_event(&admitted.event, UINT64_C(0x11111111));
+    vlc_thread_t publisher;
+    assert(vlc_clone(&publisher, fence_push_thread, &admitted) == 0);
+    vlc_sem_wait(&fixture.callback_entered);
+
+    assert(libvlc_media_player_release_video_path_fenced(
+               fixture.player, fence_dispatch, &fixture, fence_complete,
+               &fixture, &fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    fixture.player = NULL;
+    assert(libvlc_video_path_release_request_get_state(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN);
+    assert(!libvlc_video_path_release_request_is_ready(fixture.observer));
+    assert(libvlc_video_path_release_request_redispatch(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_NOT_READY);
+    assert(libvlc_video_path_release_request_execute(fixture.observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_NOT_READY);
+
+    libvlc_video_path_release_request_release(fixture.observer);
+    fixture.observer = NULL;
+
+    vlc_video_path_event denied;
+    fence_init_event(&denied, UINT64_C(0x22222222));
+    assert(vlc_metrics_PushVideoPath(fixture.metrics, &denied) ==
+           VLC_SUCCESS);
+    assert(denied.producer_seq == UINT64_C(0x22222222));
+    assert(atomic_load_explicit(&fixture.callback_calls,
+                                memory_order_relaxed) == 1);
+
+    vlc_sem_post(&fixture.callback_continue);
+    vlc_join(publisher, NULL);
+    assert(admitted.result != VLC_SUCCESS);
+    assert(atomic_load_explicit(&fixture.dispatch_calls,
+                                memory_order_relaxed) == 1);
+    assert(atomic_load_explicit(&fixture.worker_transfers,
+                                memory_order_relaxed) == 1);
+
+    struct vlc_video_path_loss_snapshot loss;
+    assert(vlc_metrics_video_path_loss_snapshot(fixture.metrics, &loss));
+    assert(loss.events == 1);
+    assert(loss.first_seq == admitted.event.producer_seq);
+    assert(loss.last_seq == admitted.event.producer_seq);
+    assert(loss.generation == 1);
+
+    fence_init_event(&denied, UINT64_C(0x33333333));
+    assert(vlc_metrics_PushVideoPath(fixture.metrics, &denied) ==
+           VLC_SUCCESS);
+    assert(denied.producer_seq == UINT64_C(0x33333333));
+    struct vlc_video_path_loss_snapshot after_denied;
+    assert(vlc_metrics_video_path_loss_snapshot(
+        fixture.metrics, &after_denied));
+    assert(after_denied.events == loss.events);
+    assert(after_denied.first_seq == loss.first_seq);
+    assert(after_denied.last_seq == loss.last_seq);
+    assert(after_denied.generation == loss.generation);
+
+    vlc_sem_post(&fixture.worker_continue);
+    vlc_sem_wait(&fixture.worker_done);
+    vlc_join(fixture.worker, NULL);
+    assert(atomic_load_explicit(&fixture.worker_result,
+                                memory_order_acquire) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    assert(atomic_load_explicit(&fixture.completion_calls,
+                                memory_order_relaxed) == 1);
+    assert(fixture.callback_userdata == NULL);
+    assert(atomic_load_explicit(&fixture.callback_return_order,
+                                memory_order_acquire) <
+           atomic_load_explicit(&fixture.dispatch_order,
+                                memory_order_acquire));
+    assert(atomic_load_explicit(&fixture.worker_order,
+                                memory_order_acquire) <
+           atomic_load_explicit(&fixture.completion_order,
+                                memory_order_acquire));
+    assert((atomic_load_explicit(&fixture.opaque_observers,
+                                 memory_order_relaxed) &
+            (FENCE_CANARY_CALLBACK | FENCE_CANARY_DISPATCH |
+             FENCE_CANARY_WORKER | FENCE_CANARY_COMPLETE)) ==
+           (FENCE_CANARY_CALLBACK | FENCE_CANARY_DISPATCH |
+            FENCE_CANARY_WORKER | FENCE_CANARY_COMPLETE));
+
+    libvlc_media_player_release(extra);
+    libvlc_release(fixture.instance);
+}
