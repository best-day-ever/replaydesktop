+struct release_tracer {
+    libvlc_media_player_t *player;
+    libvlc_video_path_release_request_t *observer;
+    _Atomic(libvlc_video_path_release_request_t *) queued;
+    vlc_thread_t worker;
+    vlc_sem_t queued_ready;
+    vlc_sem_t worker_done;
+    atomic_uint callback_calls;
+    atomic_uint dispatch_calls;
+    atomic_uint completion_calls;
+    atomic_uint worker_execute_calls;
+    atomic_uint callback_returning;
+};
+
+static void *
+release_tracer_worker(void *opaque)
+{
+    struct release_tracer *tracer = opaque;
+    vlc_sem_wait(&tracer->queued_ready);
+    libvlc_video_path_release_request_t *request =
+        atomic_load_explicit(&tracer->queued, memory_order_acquire);
+    assert(request != NULL);
+    atomic_fetch_add_explicit(&tracer->worker_execute_calls, 1,
+                              memory_order_relaxed);
+    assert(libvlc_video_path_release_request_execute(request) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    libvlc_video_path_release_request_release(request);
+    vlc_sem_post(&tracer->worker_done);
+    return NULL;
+}
+
+static int
+release_tracer_dispatch(
+    void *opaque, libvlc_video_path_release_request_t *borrowed_request)
+{
+    struct release_tracer *tracer = opaque;
+    assert(atomic_load_explicit(&tracer->callback_returning,
+                                memory_order_acquire) == 1);
+    atomic_fetch_add_explicit(&tracer->dispatch_calls, 1,
+                              memory_order_relaxed);
+    libvlc_video_path_release_request_t *worker_handle =
+        libvlc_video_path_release_request_retain(borrowed_request);
+    assert(worker_handle != NULL);
+    atomic_store_explicit(&tracer->queued, worker_handle,
+                          memory_order_release);
+    vlc_sem_post(&tracer->queued_ready);
+    return 0;
+}
+
+static void
+release_tracer_complete(void *opaque)
+{
+    struct release_tracer *tracer = opaque;
+    atomic_fetch_add_explicit(&tracer->completion_calls, 1,
+                              memory_order_relaxed);
+}
+
+static int
+release_tracer_callback(
+    void *opaque, const struct libvlc_video_path_event *events, size_t count)
+{
+    struct release_tracer *tracer = opaque;
+    assert(events != NULL);
+    assert(count == 1);
+    atomic_fetch_add_explicit(&tracer->callback_calls, 1,
+                              memory_order_relaxed);
+
+    assert(libvlc_media_player_release_video_path_fenced(
+               tracer->player, release_tracer_dispatch, tracer,
+               release_tracer_complete, tracer, &tracer->observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_OK);
+    tracer->player = NULL;
+    assert(tracer->observer != NULL);
+    assert(libvlc_video_path_release_request_get_state(tracer->observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN);
+    assert(!libvlc_video_path_release_request_is_ready(tracer->observer));
+    assert(libvlc_video_path_release_request_execute(tracer->observer) ==
+           LIBVLC_VIDEO_PATH_RELEASE_BUSY);
+    atomic_store_explicit(&tracer->callback_returning, 1,
+                          memory_order_release);
+    return -1;
+}
+
+static void
+test_reentrant_fenced_release_tracer(void)
+{
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_WAITING_FOR_DRAIN == 0,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_READY == 1,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCHING == 2,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCHED == 3,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_EXECUTING == 4,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_RELEASED == 5,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_COMPLETING == 6,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_COMPLETE == 7,
+                   "release state ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_OK == 0,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_INVALID == -1,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_NO_MEMORY == -2,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_ALREADY_CLOSED == -3,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_NOT_READY == -4,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_BUSY == -5,
+                   "release result ABI drift");
+    _Static_assert(LIBVLC_VIDEO_PATH_RELEASE_DISPATCH_REJECTED == -6,
+                   "release result ABI drift");
+
+    struct release_tracer tracer = {0};
+    atomic_init(&tracer.queued, NULL);
+    atomic_init(&tracer.callback_calls, 0);
+    atomic_init(&tracer.dispatch_calls, 0);
+    atomic_init(&tracer.completion_calls, 0);
+    atomic_init(&tracer.worker_execute_calls, 0);
+    atomic_init(&tracer.callback_returning, 0);
+    vlc_sem_init(&tracer.queued_ready, 0);
+    vlc_sem_init(&tracer.worker_done, 0);
+    assert(vlc_clone(&tracer.worker, release_tracer_worker, &tracer) == 0);
